Grammar: Dart
FormatType: EBNF
TokenSplitter: Space

<library> ::= <import_stmt>* <decl>* ;
<import_stmt> ::= 'import' <text> ('as' <identifier>)? ';' ;
<decl> ::= <comment> | <class_decl> | <func_decl> | <var_decl> | <const_decl> ;
<class_decl> ::= ('abstract' 'class' | 'class') <identifier> ('<' <type_params>? '>')? ('extends' <type>)? ('implements' <type_list>)? ('with' <type_list>)? '{' <member>* '}' ;
<type_params> ::= <type> (',' <type>)* ;
<func_decl> ::= <type>? <identifier> '(' <params>? ')' ('async'?)? ('{' <stmt>* '}' | '=>' <expr> ';') ;
<params> ::= <param> (',' <param>)* ;
<param> ::= <type>? <identifier> ('=' <expr>)? ;
<var_decl> ::= 'var' <identifier> ('=' <expr>)? ';' ;
<const_decl> ::= 'const' <type>? <identifier> ('=' <expr>)? ';' ;
<constructor> ::= <identifier> ('.' <identifier>)? '(' <params>? ')' (';' | '{' <stmt>* '}') ;
<member> ::= <func_decl> | <var_decl> | <const_decl> | <constructor> | <expr> '.' <identifier> ;
<type> ::= <identifier> ('<' <type_list> '>')? | 'void' | 'dynamic' ;
<type_list> ::= <type> (',' <type>)* ;
<list> ::= '[' <args>? ']' ;
<map> ::= '{' '}' ;
<args> ::= <expr> (',' <expr>)* ;
<expr> ::= <literal> | <identifier> | <expr> '.' <identifier> | <expr> '(' <args>? ')' | <list> | '(' <expr> ')' | <expr> <binop> <expr> ;
<binop> ::= '+' | '-' | '*' | '/' | '%' | '==' | '!=' | '<' | '>' | '<=' | '>=' | '&&' | '||' | '??' ;
<literal> ::= <number> | <text> | 'true' | 'false' | 'null' ;
<number> ::= /[0-9]+('.'[0-9]+)?/ ;
<text> ::= /"[^"]*"|'[^']*'/ ;
<if_stmt> ::= 'if' '(' <expr> ')' <block> ('else' <block>)? ;
<block> ::= '{' <stmt>* '}' ;
<stmt> ::= <var_decl> | <expr> ';' | <if_stmt> | <return_stmt> ;
<return_stmt> ::= 'return' <expr>? ';' ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;

/* Comments (issue #189) */
<single-line-comment> ::= /\/\/[^\n]*/
<multi-line-comment> ::= /\/\*([^*]|\*+[^*/])*\*+\//
<comment> ::= <single-line-comment> | <multi-line-comment>
