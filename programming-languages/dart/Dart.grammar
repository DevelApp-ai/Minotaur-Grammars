Grammar: Dart
Language version: Dart 3.0+ (records, patterns, sealed classes).
FormatType: EBNF

<library> ::= <import_stmt>* <decl>* ;
<import_stmt> ::= 'import' <text> ('as' <identifier>)? ';' ;
<decl> ::= <comment> | <class_decl> | <func_decl> | <var_decl> | <const_decl> ;
<class_decl> ::= ('abstract' 'class' | 'class') <identifier> ('<' <type_params>? '>')? ('extends' <type>)? ('implements' <type_list>)? ('with' <type_list>)? '{' <member>* '}' ;
<type_params> ::= <identifier> (',' <identifier>)* ;
<func_decl> ::= <type>? <identifier> '(' <params>? ')' ('async')? ('{' <stmt>* '}' | '=>' <expr> ';') ;
<member> ::= <func_decl> | <var_decl> | <const_decl> | <constructor> | <expr> '.' <identifier> ;
<constructor> ::= <identifier> ('.' <identifier>)? '(' <params>? ')' (':' 'this' '.' <identifier>)? '{' <stmt>* '}' ;
<params> ::= <param> (',' <param>)* ;
<param> ::= ('this' '.')? <identifier> (':' <type>)? ('=' <expr>)? ;
<var_decl> ::= 'var' <identifier> ('=' <expr>)? ';' ;
<const_decl> ::= ('const' | 'final') <type>? <identifier> '=' <expr> ';' ;
<stmt> ::= <expr_stmt> | <return_stmt> | <if_stmt> | <for_stmt> | <while_stmt> | <decl> ;
<expr_stmt> ::= <expr> ';' ;
<return_stmt> ::= 'return' <expr>? ';' ;
<if_stmt> ::= 'if' '(' <expr> ')' <block> ('else' 'if' '(' <expr> ')' <block>)* ('else' <block>)? ;
<for_stmt> ::= 'for' '(' 'var' <identifier> 'in' <expr> ')' <block> ;
<while_stmt> ::= 'while' '(' <expr> ')' <block> ;
<block> ::= '{' <stmt>* '}' ;
<expr> ::= <literal> | <identifier> | <call> | <member> | <expr> <binop> <expr> | '(' <expr> ')' | 'await' <expr> ;
<call> ::= <expr> '(' <args>? ')' ;
<args> ::= <expr> (',' <expr>)* ;
<type> ::= <identifier> ('<' <types> '>')? <type_null> ;
<type_null> ::= /'?\'?/ ;
<types> ::= <type> (',' <type>)* ;
<type_list> ::= <type> (',' <type>)* ;
<literal> ::= <number> | <text> | <boolean> | 'null' | <list> | <map> ;
<list> ::= '[' <args>? ']' ;
<map> ::= '{' <map_entry> (',' <map_entry>)* '}' ;
<map_entry> ::= <expr> ':' <expr> ;
<boolean> ::= 'true' | 'false' ;
<binop> ::= '+' | '-' | '*' | '/' | '==' | '<' | '>' | '&&' | '||' | '??' ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;

<comment> ::= <line_comment> | <block_comment>
<text> ::= <string>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Dart 3: // and /* */ comments, raw r".." and triple strings, cascades .., spread ... */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<block_comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<string> ::= /r"([^"\\\n]|\\.)*"/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<string> ::= /[\x22]{3}([^\x22]|[\x22][^\x22]|[\x22]{2}[^\x22])*[\x22]{3}/
<string> ::= /[']{3}([^']|['][^']|[']{2}[^'])*[']{3}/
<number> ::= /0[xX][0-9a-fA-F]+/
<number> ::= /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
<number> ::= /\.[0-9]+([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<backtick_ident> ::= /`[^`\n]+`/
<lx_op0> ::= "=>"
<lx_op1> ::= "??"
<lx_op2> ::= "?."
<lx_op3> ::= "..."
<lx_op4> ::= ".."
<lx_op5> ::= "=="
<lx_op6> ::= "!="
<lx_op7> ::= "<="
<lx_op8> ::= ">="
<lx_op9> ::= "&&"
<lx_op10> ::= "||"
<lx_op11> ::= "++"
<lx_op12> ::= "--"
<lx_op13> ::= "+="
<lx_op14> ::= "-="
<lx_op15> ::= "*="
<lx_op16> ::= "/="
<lx_op17> ::= "%="
<lx_op18> ::= "&="
<lx_op19> ::= "|="
<lx_op20> ::= "^="
<lx_op21> ::= "<<"
<lx_op22> ::= ">>"
<lx_op23> ::= ">>>"
<lx_op24> ::= "<<="
<lx_op25> ::= ">>="
<lx_op26> ::= ">>>="
<lx_op27> ::= "~/"
<lx_op28> ::= "~"
<op_single> ::= /[-+*\x2F%<>=!?:@.]/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
<lx_p10> ::= "$"
