Grammar: Elixir
FormatType: EBNF

<program> ::= <exprs> ;
<exprs> ::= <expr>+ ;
<expr> ::= <def_module> | <def> | <defp> | assignment | pipe_expr | call | literal | identifier | struct_access | <expr> binop <expr> ;
<def_module> ::= 'defmodule' alias 'do' <exprs> 'end' ;
<def> ::= 'def' (<call_head> | <name_and_guard>) (',' 'do:' <expr> | 'do' <exprs> 'end') ;
<defp> ::= 'defp' <call_head> (',' 'do:' <expr> | 'do' <exprs> 'end') ;
<call_head> ::= identifier '(' <params>? ')' ('when' <guard>)? ;
<name_and_guard> ::= identifier 'when' <guard> ;
<guard> ::= <expr> ;
<params> ::= <param> (',' <param>)* ;
<param> ::= identifier | '_' | identifier '\' expr ;
assignment ::= identifier '=' expr ;
pipe_expr ::= expr (' | >' call)+ ;
call ::= (module_ref '.')? identifier '(' args? ')' ( 'do' exprs 'end' )? ;
module_ref ::= alias ;
args ::= expr (',' expr)* ;
struct_access ::= expr '.' identifier ;
alias ::= [A-Z][a-zA-Z0-9_.]* ;
literal ::= number | text | atom | boolean | 'nil' | list | tuple | map | keyword ;
list ::= '<auto_param_0>' ;
tuple ::= '{' args? '}' ;
map ::= '%' '{' map_pair (',' map_pair)* '}' ;
map_pair ::= expr '=>' expr ;
keyword ::= identifier ':' expr ;
atom ::= ':' identifier ;
boolean ::= 'true' | 'false' ;
binop ::= '+' | '-' | '*' | '/' | '==' | '<>' | '<' | '>' | '&&' | ' |  | ' | '++' | ' | >' ;
identifier ::= [a-z_][a-zA-Z0-9_]*[?!]? ;
text ::= '"' [^"]* '"' ;
<number> ::= /[0-9]+/ ;

# --- Coverage completion: remaining language constructs ---
<multi_clause_fn> ::= "fn" <fn_clause> ( ";" <fn_clause> )* "end" ;
<fn_clause> ::= pattern <auto_fn_clause_0> "->" expression_list ;
<bitstring_segment> ::= expression "::" bit_modifiers ;
<binary_comprehension> ::= "for" "<<" comprehension_segments ">>" <auto_binary_comprehension_0> <auto_binary_comprehension_1> "," "do:" expression ;
<sigil> ::= "~" sigil_char sigil_delimiter sigil_body sigil_delimiter <auto_sigil_0> ;
<access_syntax> ::= expression "[" ( expression | atom_literal ) "]" ;
<auto_param_0> ::= /[' args? ']/ ;
<auto_fn_clause_0> ::= /[ guard ]/ ;
<auto_binary_comprehension_0> ::= /[ comprehension_filters ]/ ;
<auto_binary_comprehension_1> ::= /[ "into:" expression ]/ ;
<auto_sigil_0> ::= /[ sigil_modifier_list ]/ ;

/* Comments (issue #189) */
<hash-comment> ::= /#[^\n]*/
<comment> ::= <hash-comment>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   identifier, number, string/char literals, punctuation and comments as token
   rules. String/char/block-comment patterns are the proven CSharp10 ones. */
<lx_ws> ::= /[ \t\r\n]+/ => { skip }
<lx_backslash> ::= /\\/
<lx_identifier> ::= /[A-Za-z_][A-Za-z0-9_]*/
<lx_number> ::= /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
<lx_string> ::= /"([^"\\\n]|\\.)*"/
<lx_char0> ::= /'[^'\n]'/
<lx_char1> ::= /'\x5C.'/
<lx_char2> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<lx_char3> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
<lx_block_comment0> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= "."
<lx_p9> ::= "?"
<lx_p10> ::= ":"
<lx_p11> ::= "!"
<lx_p12> ::= "+"
<lx_p13> ::= "-"
<lx_p14> ::= "*"
<lx_p15> ::= "/"
<lx_p16> ::= "%"
<lx_p17> ::= "="
<lx_p18> ::= "<"
<lx_p19> ::= ">"
<lx_p20> ::= "&"
<lx_p21> ::= "|"
<lx_p22> ::= "^"
<lx_p23> ::= "~"
<lx_p24> ::= "@"
<lx_p25> ::= "`"
<lx_p26> ::= '"'
<lx_p27> ::= "'"
<lx_p28> ::= "=>"
<lx_p29> ::= "->"
<lx_p30> ::= "=="
<lx_p31> ::= "!="
<lx_p32> ::= "<="
<lx_p33> ::= ">="
<lx_p34> ::= "&&"
<lx_p35> ::= "||"
<lx_p36> ::= "++"
<lx_p37> ::= "--"
<lx_p38> ::= "+="
<lx_p39> ::= "-="
<lx_p40> ::= "*="
<lx_p41> ::= "/="
<lx_p42> ::= "%="
<lx_p43> ::= "&="
<lx_p44> ::= "|="
<lx_p45> ::= "^="
<lx_p46> ::= "<<"
<lx_p47> ::= ">>"
<lx_p48> ::= "::"
<lx_p49> ::= ".."
<lx_p50> ::= "..."
<lx_p51> ::= "**"
<lx_p52> ::= "??"
<lx_p53> ::= "?."
<lx_p54> ::= "<>"
<lx_hash_comment> ::= /#[^\n]*/ => { skip }
<lx_line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
