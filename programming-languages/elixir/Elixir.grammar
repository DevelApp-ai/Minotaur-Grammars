Grammar: Elixir
FormatType: EBNF
TokenSplitter: Space

program  ::= exprs ;
exprs    ::= expr+ ;
expr     ::= def_module | def | defp | assignment | pipe_expr | call | literal | identifier | struct_access | expr binop expr ;
def_module ::= 'defmodule' alias 'do' exprs 'end' ;
def      ::= 'def' (call_head | name_and_guard) (',' 'do:' expr | 'do' exprs 'end') ;
defp     ::= 'defp' call_head (',' 'do:' expr | 'do' exprs 'end') ;
call_head ::= identifier '(' params? ')' ('when' guard)? ;
name_and_guard ::= identifier 'when' guard ;
guard    ::= expr ;
params   ::= param (',' param)* ;
param    ::= identifier | '_' | identifier '\' expr ;
assignment ::= identifier '=' expr ;
pipe_expr ::= expr ('|>' call)+ ;
call     ::= (module_ref '.')? identifier '(' args? ')' ( 'do' exprs 'end' )? ;
module_ref ::= alias ;
args     ::= expr (',' expr)* ;
struct_access ::= expr '.' identifier ;
alias    ::= [A-Z][a-zA-Z0-9_.]* ;
literal  ::= number | text | atom | boolean | 'nil' | list | tuple | map | keyword ;
list     ::= '[' args? ']' ;
tuple    ::= '{' args? '}' ;
map      ::= '%' '{' map_pair (',' map_pair)* '}' ;
map_pair ::= expr '=>' expr ;
keyword  ::= identifier ':' expr ;
atom     ::= ':' identifier ;
boolean  ::= 'true' | 'false' ;
binop    ::= '+' | '-' | '*' | '/' | '==' | '<>' | '<' | '>' | '&&' | '||' | '++' | '|>' ;
identifier ::= [a-z_][a-zA-Z0-9_]*[?!]? ;
text     ::= '"' [^"]* '"' ;
number   ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
alias_stmt ::= 'alias' qualified_id ('as' alias)? ; ;
use_stmt ::= 'use' qualified_id (',' args)? ; ;
import_stmt ::= 'import' qualified_id (',' args)? ; ;
module_attr ::= '@' identifier expr ; ;
struct_lit ::= '%' alias '{' pair (',' pair)* '}' ; ;
with_expr ::= 'with' pattern '<-' expr (',' pattern '<-' expr)* 'do' exprs ('else' (pattern '->' exprs)+)? 'end' ; ;
cond_expr ::= 'cond' 'do' (expr '->' exprs)+ 'end' ; ;
try_expr ::= 'try' 'do' exprs ('rescue' (pattern '->' exprs)+)? ('catch' (pattern '->' exprs)+)? ('after' exprs)? 'end' ; ;
for_comp ::= 'for' pattern '<-' expr (',' pattern '<-' expr)* ('into' expr)? 'do' exprs 'end' ; ;
protocol_def ::= 'defprotocol' alias 'do' func_decl* 'end' ; ;
impl_def ::= 'defimpl' alias ',' 'for:' alias 'do' exprs 'end' ; ;
