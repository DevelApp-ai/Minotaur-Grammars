Grammar: Elixir
FormatType: EBNF

<program> ::= <exprs> ;
<exprs> ::= <expr>+ ;
<expr> ::= <def_module> | <def> | <defp> | assignment | pipe_expr | call | literal | identifier | struct_access | <expr> binop <expr> ;
<def_module> ::= 'defmodule' alias 'do' <exprs> 'end' ;
<def> ::= 'def' (<call_head> | <name_and_guard>) (',' 'do:' <expr> | 'do' <exprs> 'end') ;
<defp> ::= 'defp' <call_head> (',' 'do:' <expr> | 'do' <exprs> 'end') ;
<call_head> ::= identifier '(' <params>? ')' ('when' <guard>)? ;
<name_and_guard> ::= identifier 'when' <guard> ;
<guard> ::= <expr> ;
<params> ::= <param> (',' <param>)* ;
<param> ::= identifier | '_' | identifier '\' expr ;
assignment ::= identifier '=' expr ;
pipe_expr ::= expr (' | >' call)+ ;
call ::= (module_ref '.')? identifier '(' args? ')' ( 'do' exprs 'end' )? ;
module_ref ::= alias ;
args ::= expr (',' expr)* ;
struct_access ::= expr '.' identifier ;
alias ::= [A-Z][a-zA-Z0-9_.]* ;
literal ::= number | text | atom | boolean | 'nil' | list | tuple | map | keyword ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Elixir: # comments, atoms :x, sigils ~s(...), heredocs, char ?a, operators |> <- => */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<heredoc> ::= /[\x22]{3}([^\x22]|[\x22][^\x22]|[\x22]{2}[^\x22])*[\x22]{3}/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<sigil> ::= /~[a-zA-Z]\([^)]*\)/
<sigil> ::= /~[a-zA-Z]\[[^\]]*\]/
<sigil> ::= /~[a-zA-Z]\{[^}]*\}/
<sigil> ::= /~[a-zA-Z]<[^>]*>/
<sigil> ::= /~[a-zA-Z]\x22([^\x22\\]|\\.)*\x22/
<sigil> ::= /~[a-zA-Z]'([^'\\]|\\.)*'/
<sigil> ::= /~[a-zA-Z]\x2F[^\x2F\n]*\x2F/
<sigil> ::= /~[a-zA-Z]\|[^\|\n]*\|/
<char> ::= /\?u[0-9a-fA-F]{4}/
<char> ::= /\?\\./
<char> ::= /\?[a-zA-Z0-9]/
<atom> ::= /:[a-zA-Z_][a-zA-Z0-9_]*[!?]?/
<atom> ::= /\x3A\x22([^\x22\\]|\\.)*\x22/
<atom> ::= /:[+\-*<>=!&|^~.\x2F]+/
<number> ::= /0[xX][0-9a-fA-F]+/
<number> ::= /[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9]+)?/
<number> ::= /\.[0-9][0-9_]*([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*[!?]?/
<lx_op0> ::= "->"
<lx_op1> ::= "|>"
<lx_op2> ::= "<-"
<lx_op3> ::= "=>"
<lx_op4> ::= "=~"
<lx_op5> ::= "++"
<lx_op6> ::= "--"
<lx_op7> ::= "<>"
<lx_op8> ::= ".."
<lx_op9> ::= "&&"
<lx_op10> ::= "||"
<lx_op11> ::= "=="
<lx_op12> ::= "!="
<lx_op13> ::= "==="
<lx_op14> ::= "!=="
<lx_op15> ::= "<="
<lx_op16> ::= ">="
<lx_op17> ::= "<<"
<lx_op18> ::= ">>"
<lx_op19> ::= "::"
<op_single> ::= /[-+*\x2F%&|^~<>=!@.:]/
<backslash> ::= /\\/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
