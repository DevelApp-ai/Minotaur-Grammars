Grammar: PHP
FormatType: EBNF
TokenSplitter: Space

<script> ::= <open_tag> <stmt>* ;
<open_tag> ::= '<?php' ;
<stmt> ::= <assignment> | <func_def> | <class_def> | <if_stmt> | <while_stmt> | <foreach_stmt> | <expr_stmt> | <return_stmt> ;
<assignment> ::= <variable> '=' <expr> ';' ;
<expr_stmt> ::= <expr> ';' ;
<return_stmt> ::= 'return' <expr>? ';' ;
<func_def> ::= 'function' <identifier> '(' <params>? ')' '{' <stmt>* '}' ;
<class_def> ::= 'class' <identifier> ('extends' <identifier>)? '{' <member>* '}' ;
<member> ::= <visibility>? (<property> | <method>) ;
<visibility> ::= 'public' | 'protected' | 'private' ;
<property> ::= <variable> ('=' <expr>)? ';' ;
<method> ::= 'function' <identifier> '(' <params>? ')' '{' <stmt>* '}' ;
<params> ::= <param> (',' <param>)* ;
<param> ::= <type_hint>? <variable> ('=' <expr>)? ;
<type_hint> ::= <identifier> | '?' <identifier> ;
<if_stmt> ::= 'if' '(' <expr> ')' <block> ('elseif' '(' <expr> ')' <block>)* ('else' <block>)? ;
<while_stmt> ::= 'while' '(' <expr> ')' <block> ;
<foreach_stmt> ::= 'foreach' '(' <expr> 'as' <variable> '=>' <variable> ')' <block> ;
<block> ::= '{' <stmt>* '}' | <stmt> ;
<expr> ::= <literal> | <variable> | <call> | <expr> <binop> <expr> | '(' <expr> ')' ;
<call> ::= (<receiver> '->')? <identifier> '(' <args>? ')' ;
<receiver> ::= <variable> | <expr> ;
<args> ::= <expr> (',' <expr>)* ;
<literal> ::= <number> | <text> | <boolean> | 'null' | <array> ;
<array> ::= 'array' '(' <args>? ')' | '[' <args>? ']' ;
<boolean> ::= 'true' | 'false' | 'TRUE' | 'FALSE' ;
<binop> ::= '+' | '-' | '*' | '/' | '.' | '==' | '===' | '<' | '>' | '&&' | ' |  | ' ;
<variable> ::= '$' <identifier> ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;
<text> ::= '"' <auto_text_0> '"' | '\'' <auto_text_1> '\'' ;
<number> ::= /[0-9]+/ ;

# --- Coverage completion: remaining language constructs ---

<enum_declaration> ::= attribute_list? doc_comment? "enum" <identifier> <auto_enum_declaration_0> "{" <enum_case>* class_member* "}" ;
<enum_case> ::= "case" <identifier> <auto_enum_case_0> ";" ;
<readonly_class> ::= "readonly" class_declaration ;
<readonly_property> ::= property_modifier "readonly" type property_name property_default? ";" ;
<attribute> ::= "#" "[" attribute_name <auto_attribute_0> "]" ;
<nullsafe_call> ::= primary "?->" method_name call_arguments ;
<null_coalesce_assign> ::= lvalue "??=" expression ";" ;
<first_class_callable> ::= function_name "(" "..." ")" ;
<match_expression> ::= "match" "(" expression ")" "{" match_arm* <auto_match_expression_0> "}" ";"? ;

<auto_text_0> ::= /[^"]*/ ;
<auto_text_1> ::= /[^\']*/ ;
<auto_enum_declaration_0> ::= /[ ":" type ]/ ;
<auto_enum_case_0> ::= /[ "=" expression ]/ ;
<auto_attribute_0> ::= /[ "(" argument_list ")" ]/ ;
<auto_match_expression_0> ::= /[ default_arm ]/ ;
