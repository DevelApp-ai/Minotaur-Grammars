Grammar: PHP
FormatType: EBNF
TokenSplitter: Space

script   ::= open_tag stmt* ;
open_tag ::= '<?php' ;
stmt     ::= assignment | func_def | class_def | if_stmt | while_stmt | foreach_stmt | expr_stmt | return_stmt ;
assignment ::= variable '=' expr ';' ;
expr_stmt ::= expr ';' ;
return_stmt ::= 'return' expr? ';' ;
func_def ::= 'function' identifier '(' params? ')' '{' stmt* '}' ;
class_def ::= 'class' identifier ('extends' identifier)? '{' member* '}' ;
member   ::= visibility? (property | method) ;
visibility ::= 'public' | 'protected' | 'private' ;
property ::= variable ('=' expr)? ';' ;
method   ::= 'function' identifier '(' params? ')' '{' stmt* '}' ;
params   ::= param (',' param)* ;
param    ::= type_hint? variable ('=' expr)? ;
type_hint ::= identifier | '?' identifier ;
if_stmt  ::= 'if' '(' expr ')' block ('elseif' '(' expr ')' block)* ('else' block)? ;
while_stmt ::= 'while' '(' expr ')' block ;
foreach_stmt ::= 'foreach' '(' expr 'as' variable '=>' variable ')' block ;
block    ::= '{' stmt* '}' | stmt ;
expr     ::= literal | variable | call | expr binop expr | '(' expr ')' ;
call     ::= (receiver '->')? identifier '(' args? ')' ;
receiver ::= variable | expr ;
args     ::= expr (',' expr)* ;
literal  ::= number | text | boolean | 'null' | array ;
array    ::= 'array' '(' args? ')' | '[' args? ']' ;
boolean  ::= 'true' | 'false' | 'TRUE' | 'FALSE' ;
binop    ::= '+' | '-' | '*' | '/' | '.' | '==' | '===' | '<' | '>' | '&&' | '||' ;
variable ::= '$' identifier ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text     ::= '"' [^"]* '"' | '\'' [^\']* '\'' ;
number   ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
namespace_stmt ::= 'namespace' identifier (';' | '{' stmt* '}') ; ;
interface_def ::= 'interface' identifier ('extends' identifier (',' identifier)*)? '{' method* '}' ; ;
trait_def ::= 'trait' identifier '{' member* '}' ; ;
use_trait ::= 'use' identifier (',' identifier)* ('{' '}')? ';' ; ;
try_stmt ::= 'try' block ('catch' '(' type_hint variable ')' block)* ('finally' block)? ; ;
switch_stmt ::= 'switch' '(' expr ')' '{' case_clause* '}' ; ;
case_clause ::= ('case' expr | 'default') ':' stmt* ; ;
match_stmt ::= 'match' '(' expr ')' '{' match_arm (',' match_arm)* '}' ; ;
match_arm ::= expr (',' expr)* '=>' expr ; ;
arrow_fn ::= 'fn' '(' params? ')' (':' type_hint)? '=>' expr ';' ; ;
instanceof ::= expr 'instanceof' identifier ; ;
const_decl ::= 'const' identifier '=' expr ';' ; ;
static_call ::= 'static' '::' identifier '(' args? ')' ';' ; ;
