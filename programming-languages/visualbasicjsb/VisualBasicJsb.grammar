Grammar: VisualBasicJsb
Keywords: Imports, Namespace, End, Partial, Public, Class, Property, Enum

<whitespace> ::= /[ \t\r\n]+/ => { skip }
<line_comment> ::= /'[^\n]*/ => { skip }

<identifier> ::= /[A-Za-z_][A-Za-z0-9_]*/
<qualified_name> ::= /[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+/
<bracketed_name> ::= /\[[A-Za-z_][A-Za-z0-9_]*\]/
<json_property_anno> ::= /<JsonProperty\("([^"\\]|\\.)*"\)>/
<json_property_converter_anno> ::= /<JsonProperty\("([^"\\]|\\.)*"\), JsonConverter\(GetType\([A-Za-z_][A-Za-z0-9_]*\)\)>/
<imports_block> ::= /Imports[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*([ \t\r\n]+Imports[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*)*/
<as_type> ::= /As[ \t]+(List\x28Of List\x28Of [A-Za-z_][A-Za-z0-9_]*\x29\x29|List\x28Of [A-Za-z_][A-Za-z0-9_]*\x29|[A-Za-z_][A-Za-z0-9_]*)\??/
<init_expr> ::= /=[ \t]+(New[ \t]+List\x28Of (List\x28Of )?[A-Za-z_][A-Za-z0-9_]*\x29+[ \t]*\x28\x29|New[ \t]+[A-Za-z_][A-Za-z0-9_]*\x28"([^"\\]|\\.)*"\x29|[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+\x28"([^"\\]|\\.)*"\x29)/

<imports_kw(priority:10)> ::= 'Imports'
<namespace_kw(priority:10)> ::= 'Namespace'
<end_kw(priority:10)> ::= 'End'
<partial_kw(priority:10)> ::= 'Partial'
<public_kw(priority:10)> ::= 'Public'
<class_kw(priority:10)> ::= 'Class'
<property_kw(priority:10)> ::= 'Property'
<enum_kw(priority:10)> ::= 'Enum'

<compilation_unit> ::= <imports_block> <namespace_decl>
<namespace_decl> ::= 'Namespace' <ns_name> <class_seq> 'End' 'Namespace'
<ns_name> ::= <bracketed_name> | <qualified_name>

<class_seq> ::= <class_seq> <class_decl>
<class_seq> ::= <class_decl>

<class_decl> ::= 'Partial' 'Public' 'Class' <identifier> <class_item_seq> 'End' 'Class'
<class_decl> ::= 'Partial' 'Public' 'Class' <identifier> 'End' 'Class'
<class_item_seq> ::= <class_item_seq> <class_item>
<class_item_seq> ::= <class_item>
<class_item> ::= <member>
<class_item> ::= <class_decl>
<class_item> ::= <enum_decl>

<member> ::= <json_property_anno> 'Public' 'Property' <identifier> <as_type>
<member> ::= <json_property_anno> 'Public' 'Property' <identifier> <as_type> <init_expr>
<member> ::= <json_property_converter_anno> 'Public' 'Property' <identifier> <as_type>

<enum_decl> ::= 'Public' 'Enum' <identifier> 'End' 'Enum'
<enum_decl> ::= 'Public' 'Enum' <identifier> <identifier> 'End' 'Enum'
<enum_decl> ::= 'Public' 'Enum' <identifier> <identifier> <identifier> 'End' 'Enum'
<enum_decl> ::= 'Public' 'Enum' <identifier> <identifier> <identifier> <identifier> 'End' 'Enum'
<enum_decl> ::= 'Public' 'Enum' <identifier> <identifier> <identifier> <identifier> <identifier> 'End' 'Enum'
