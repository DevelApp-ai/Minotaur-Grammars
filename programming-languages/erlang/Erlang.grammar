Grammar: Erlang
FormatType: EBNF

<module> ::= <attribute>* <form>* ;
<attribute> ::= '-' ('module' | 'export' | 'import' | 'behaviour') '(' <attr_args> ')' '.' ;
<attr_args> ::= <atom> | '(' <export_fns>? ')' ;
<export_fns> ::= <export_fn> (',' <export_fn>)* ;
<export_fn> ::= <atom> '/' <number> ;
<form> ::= <function_clauses> '.' ;
<function_clauses> ::= <function_clause> (';' <function_clause>)* ;
<function_clause> ::= <atom> '(' <args>? ')' ('when' <guard>)? '->' <exprs> ;
<guard> ::= <guard_expr> (',' <guard_expr>)* ;
<guard_expr> ::= <expr> ;
<args> ::= <expr> (',' <expr>)* ;
<exprs> ::= <expr> (',' <expr>)* ;
<expr> ::= <literal> | <var> | <call> | <tuple> | <list> | <map> | <binary> | <case_expr> | <fun_expr> | <receive_expr> | <expr> <binop> <expr> ;
<call> ::= (<module_ref> ':')? <atom> '(' <args>? ')' ;
<module_ref> ::= <atom> | <var> ;
<tuple> ::= '{' <args>? '}' ;
<list> ::= '[' <args>? ']' ;
<map> ::= '#' '{' <map_pair> (',' <map_pair>)* '}' ;
<map_pair> ::= <expr> '=>' <expr> ;
<binary> ::= '<<' '>>' ;
<case_expr> ::= 'case' <expr> 'of' <clause>+ 'end' ;
<clause> ::= <pattern> ('when' <guard>)? '->' <exprs> ';' ;
<pattern> ::= <var> | <literal> | <tuple> | <list> ;
<fun_expr> ::= 'fun' (<atom> '/' <number> | '(' <params>? ')' '->' <exprs> 'end') ;
<params> ::= <var> (',' <var>)* ;
<receive_expr> ::= 'receive' <clause>+ 'end' ;
<var> ::= /('_'|[A-Z])[a-zA-Z0-9_]*/ ;
<atom> ::= /[a-z][a-zA-Z0-9_@]*/ ;
<literal> ::= <number> | <text> | <atom> ;
<binop> ::= '+' | '-' | '*' | '/' | '==' | '=:=' | '=/=' | '<' | '>' | 'andalso' | 'orelse' | '++' ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Erlang/OTP: % comments, quoted atoms, vars, $c chars, radix 16#FF, bitstrings << >> */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /%[^\n]*/ => { skip }
<text> ::= /"([^"\\\n]|\\.)*"/
<char> ::= /\$\x5C./
<char> ::= /\$./
<atom_quoted> ::= /'([^'\\\n]|\\.)*'/
<atom> ::= /[a-z_][a-zA-Z0-9_@]*/
<var> ::= /[A-Z_][a-zA-Z0-9_@]*/
<number> ::= /[0-9]+#[0-9a-zA-Z]+/
<number> ::= /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?/
<number> ::= /[0-9]+[eE][+-]?[0-9]+/
<number> ::= /[0-9]+/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<lx_op0> ::= "->"
<lx_op1> ::= "-->"
<lx_op2> ::= "=>"
<lx_op3> ::= "=:="
<lx_op4> ::= "=/="
<lx_op5> ::= "<-"
<lx_op6> ::= "++"
<lx_op7> ::= "--"
<lx_op8> ::= "=<"
<lx_op9> ::= ">="
<lx_op10> ::= "=="
<lx_op11> ::= "/="
<lx_op12> ::= "||"
<lx_op13> ::= "::"
<lx_op14> ::= "!"
<op_single> ::= /[-+*\x2F=<>=|?:@^&~#]+/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= "."
<lx_p9> ::= '"'
<lx_p10> ::= "'"
