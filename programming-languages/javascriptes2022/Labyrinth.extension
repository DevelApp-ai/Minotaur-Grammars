# Labyrinth grammar extension for JavaScript (ES2022) -- optional overlay
# (Minotaur-Grammars issue #184).
#
# This file is OPTIONAL: JavaScriptES2022.grammar loads and works unchanged
# without it. Its presence marks this grammar as a Labyrinth *target*
# grammar: SAST rule patterns (Minotaur's Labyrinth rule engine) written in
# JavaScript (ES2022) can then use the pattern operators below. The overlay is applied on
# top of the base grammar through StepParser overlay composition
# (DevelApp-ai/ENFAStepLexer-StepParser#65, #66; DevelApp-ai/Minotaur#88).
# Absence of this file is not an error -- it just means JavaScript (ES2022) cannot host
# Labyrinth rule patterns yet.
#
# File format: identical to the extensions/*.extension files parsed by
# Minotaur's GrammarExtensionLoader (DevelApp-ai/Minotaur#88), so one
# mechanism covers both.

Grammar: CEBNF
BaseGrammar: JavaScriptES2022.grammar
MergeStrategy: Additive

/* Labyrinth pattern operators (added; never replace base productions).
   Later Labyrinth layers may add further operators (pattern-inside,
   pattern-not, ...) here. */

/* $NAME metavariable: matches and captures a node as a bindable metavar */
LABYRINTH_METAVAR = \$[A-Z_][A-Z0-9_]*

/* ... ellipsis: zero-or-more match in production position */
LABYRINTH_ELLIPSIS = \.\.\.

/* Production-position wrappers so $NAME / ... can stand wherever an
   expression, statement, type or item is expected inside a pattern. */
labyrinth-metavar ::= LABYRINTH_METAVAR
labyrinth-ellipsis ::= LABYRINTH_ELLIPSIS
