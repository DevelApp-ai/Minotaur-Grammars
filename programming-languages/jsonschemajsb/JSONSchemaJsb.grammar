<member> ::= <oneof_kw> ':' '[' <schema> ']'
<member> ::= <oneof_kw> ':' '[' <schema> ',' <schema> ']'
<member> ::= <oneof_kw> ':' '[' <schema> ',' <schema> ',' <schema> ']'
<member> ::= <id_kw> ':' <json_string>
<member> ::= <schema_kw> ':' <json_string>

<member_seq> ::= <member>
<member_seq> ::= <member> ',' <member>
<member_seq> ::= <member> ',' <member> ',' <member>
<member_seq> ::= <member> ',' <member> ',' <member> ',' <member>
