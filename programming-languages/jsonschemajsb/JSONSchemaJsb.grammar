<member> ::= <required_kw> ':' '[' <json_string> ',' <json_string> ',' <json_string> ',' <json_string> ',' <json_string> ',' <json_string> ']'
<member> ::= <required_kw> ':' '[' <json_string> ',' <json_string> ',' <json_string> ',' <json_string> ',' <json_string> ',' <json_string> ',' <json_string> ']'
<member> ::= <ref_kw> ':' <json_string>
<member> ::= <definitions_kw> ':' '{' <prop_seq> '}'
<member> ::= <allof_kw> ':' '[' ']'
<member> ::= <allof_kw> ':' '[' <schema> ']'
<member> ::= <allof_kw> ':' '[' <schema> ',' <schema> ']'
<member> ::= <allof_kw> ':' '[' <schema> ',' <schema> ',' <schema> ']'
<member> ::= <anyof_kw> ':' '[' ']'
