<member_seq> ::= <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member>
<member_seq> ::= <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member>
<member_seq> ::= <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member> ',' <member>

<prop_entry> ::= <json_string> ':' <schema> | <title_kw> ':' <schema> | <description_kw> ':' <schema> | <comment_kw> ':' <schema> | <examples_kw> ':' <schema> | <enum_kw> ':' <schema> | <type_kw> ':' <schema> | <format_kw> ':' <schema> | <maxlength_kw> ':' <schema> | <minlength_kw> ':' <schema> | <pattern_kw> ':' <schema> | <items_kw> ':' <schema> | <additionalprops_kw> ':' <schema> | <properties_kw> ':' <schema> | <required_kw> ':' <schema> | <ref_kw> ':' <schema> | <definitions_kw> ':' <schema> | <allof_kw> ':' <schema> | <anyof_kw> ':' <schema> | <oneof_kw> ':' <schema> | <id_kw> ':' <schema> | <schema_kw> ':' <schema> | <string_type_kw> ':' <schema> | <object_type_kw> ':' <schema> | <array_type_kw> ':' <schema> | <integer_type_kw> ':' <schema> | <boolean_type_kw> ':' <schema> | <date_fmt_kw> ':' <schema> | <datetime_fmt_kw> ':' <schema> | <time_fmt_kw> ':' <schema> | <email_fmt_kw> ':' <schema> | <iriref_fmt_kw> ':' <schema> | <false_kw> ':' <schema>

<prop_seq> ::= <prop_entry>
<prop_seq> ::= <prop_entry> ',' <prop_entry>
