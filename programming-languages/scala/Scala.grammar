Grammar: Scala
FormatType: EBNF

<program> ::= <object_def> | <class_def> | <trait_def> | <func_def> | <stmt>* ;
<object_def> ::= 'object' <identifier> ('extends' <type>)? '{' <member>* '}' ;
<class_def> ::= 'class' <identifier> ('(' <params>? ')')? ('extends' <type>)? '{' <member>* '}' ;
<trait_def> ::= 'trait' <identifier> '{' <member>* '}' ;
<func_def> ::= 'def' <identifier> ('(' <params>? ')')? (':' <type>)? '=' <expr_or_block> ;
<member> ::= <func_def> | <val_def> | <var_def> | <stmt> | <expr> '.' <identifier> ;
<val_def> ::= 'val' (<identifier> | '(' <ids> ')') (':' <type>)? '=' <expr> ;
<var_def> ::= 'var' <identifier> (':' <type>)? '=' <expr> ;
<params> ::= <param> (',' <param>)* ;
<param> ::= <identifier> ':' <type> ('=' <expr>)? ;
<expr_or_block> ::= <expr> | '{' <stmt>* '}' ;
<stmt> ::= <comment> | <expr> | <val_def> | <var_def> | <func_def> | <match_expr> ;
<match_expr> ::= <expr> 'match' '{' <case_clause>* '}' ;
<case_clause> ::= 'case' <pattern> '=>' block ;
<pattern> ::= <identifier> | <literal> | '_' | '(' <pattern> ',' <pattern> ')' ;
<expr> ::= <literal> | <identifier> | <call> | <member> | <expr> <binop> <expr> | '(' <expr> ')' | <lambda> | <if_expr> ;
<if_expr> ::= 'if' '(' <expr> ')' <expr> 'else' <expr> ;
<call> ::= <expr> '(' <args>? ')' ;
<lambda> ::= '(' <ids>? ')' '=>' <expr> | <identifier> '=>' <expr> ;
<ids> ::= <identifier> (',' <identifier>)* ;
<args> ::= <expr> (',' <expr>)* ;
<type> ::= <qualified_id> ('[' <types> ']')? ;
<types> ::= <type> (',' <type>)* ;
<literal> ::= <number> | <text> | <boolean> | 'Nil' | 'None' ;
<boolean> ::= 'true' | 'false' ;
<binop> ::= '+' | '-' | '*' | '/' | '==' | '::' | '<' | '>' | '&&' | '||' | ':+' ;
<qualified_id> ::= <identifier> ('.' <identifier>)* ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;
<text> ::= /'"'[^"]*'"'/ ;
<number> ::= /[0-9]+/ ;

# --- Coverage completion: remaining language constructs ---
<extension_clause> ::= "extension" <auto_extension_clause_0> extension_method* ;
<export_clause> ::= "export" ref_expression <auto_export_clause_0> ;
<union_type> ::= <type> " | " <type> ;
<intersection_type> ::= <type> "&" <type> ;
<opaque_type> ::= "opaque" "type" type_name <auto_opaque_type_0> "=" <type> ;
<end_marker> ::= "end" ( <identifier> | "if" | "while" | "match" | "try" | "new" | "val" | "extension" ) ;
<given_with> ::= "given" <auto_given_with_0> ":" <type> "with" template_body ;
<auto_extension_clause_0> ::= /[ "(" extension_parameter_list ")" ]/ ;
<auto_export_clause_0> ::= /[ "." "*" | export_selector_list ]/ ;
<auto_opaque_type_0> ::= /[ type_params ]/ ;
<auto_given_with_0> ::= /[ identifier ]/ ;

/* Comments (issue #189) */
<single-line-comment> ::= /\/\/[^\n]*/
<multi-line-comment> ::= /\/\*([^*]|\*+[^*/])*\*+\//
<comment> ::= <single-line-comment> | <multi-line-comment>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   identifier, number, string/char literals, punctuation and comments as token
   rules. String/char/block-comment patterns are the proven CSharp10 ones. */
<lx_ws> ::= /[ \t\r\n]+/ => { skip }
<lx_backslash> ::= /\\/
<lx_identifier> ::= /[A-Za-z_][A-Za-z0-9_]*/
<lx_number> ::= /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
<lx_string> ::= /"([^"\\\n]|\\.)*"/
<lx_char0> ::= /'[^'\n]'/
<lx_char1> ::= /'\x5C.'/
<lx_char2> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<lx_char3> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
<lx_block_comment0> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= "."
<lx_p9> ::= "?"
<lx_p10> ::= ":"
<lx_p11> ::= "!"
<lx_p12> ::= "+"
<lx_p13> ::= "-"
<lx_p14> ::= "*"
<lx_p15> ::= "/"
<lx_p16> ::= "%"
<lx_p17> ::= "="
<lx_p18> ::= "<"
<lx_p19> ::= ">"
<lx_p20> ::= "&"
<lx_p21> ::= "|"
<lx_p22> ::= "^"
<lx_p23> ::= "~"
<lx_p24> ::= "@"
<lx_p25> ::= "`"
<lx_p26> ::= '"'
<lx_p27> ::= "'"
<lx_p28> ::= "=>"
<lx_p29> ::= "->"
<lx_p30> ::= "=="
<lx_p31> ::= "!="
<lx_p32> ::= "<="
<lx_p33> ::= ">="
<lx_p34> ::= "&&"
<lx_p35> ::= "||"
<lx_p36> ::= "++"
<lx_p37> ::= "--"
<lx_p38> ::= "+="
<lx_p39> ::= "-="
<lx_p40> ::= "*="
<lx_p41> ::= "/="
<lx_p42> ::= "%="
<lx_p43> ::= "&="
<lx_p44> ::= "|="
<lx_p45> ::= "^="
<lx_p46> ::= "<<"
<lx_p47> ::= ">>"
<lx_p48> ::= "::"
<lx_p49> ::= ".."
<lx_p50> ::= "..."
<lx_p51> ::= "**"
<lx_p52> ::= "??"
<lx_p53> ::= "?."
<lx_p54> ::= "<>"
<lx_line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<lx_hash_comment> ::= /#[^\n]*/ => { skip }
<lx_block_comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
