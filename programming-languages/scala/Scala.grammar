Grammar: Scala
FormatType: EBNF
TokenSplitter: Space

program ::= object_def | class_def | trait_def | func_def | stmt* ;
object_def ::= 'object' identifier ('extends' type)? '{' member* '}' ;
class_def  ::= 'class' identifier ('(' params? ')')? ('extends' type)? '{' member* '}' ;
trait_def  ::= 'trait' identifier '{' member* '}' ;
func_def   ::= 'def' identifier ('(' params? ')')? (':' type)? '=' expr_or_block ;
member  ::= func_def | val_def | var_def | stmt ;
val_def ::= 'val' (identifier | '(' ids ')') (':' type)? '=' expr ;
var_def ::= 'var' identifier (':' type)? '=' expr ;
params  ::= param (',' param)* ;
param   ::= identifier ':' type ('=' expr)? ;
expr_or_block ::= expr | '{' stmt* '}' ;
stmt    ::= expr | val_def | var_def | func_def | match_expr ;
match_expr ::= expr 'match' '{' case_clause* '}' ;
case_clause ::= 'case' pattern '=>' block ;
pattern ::= identifier | literal | '_' | '(' pattern ',' pattern ')' ;
expr    ::= literal | identifier | call | member | expr binop expr | '(' expr ')' | lambda | if_expr ;
if_expr ::= 'if' '(' expr ')' expr 'else' expr ;
call    ::= expr '(' args? ')' ;
member  ::= expr '.' identifier ;
lambda  ::= '(' ids? ')' '=>' expr | identifier '=>' expr ;
ids     ::= identifier (',' identifier)* ;
args    ::= expr (',' expr)* ;
type    ::= qualified_id ('[' types ']')? ;
types   ::= type (',' type)* ;
literal ::= number | text | boolean | 'Nil' | 'None' ;
boolean ::= 'true' | 'false' ;
binop   ::= '+' | '-' | '*' | '/' | '==' | '::' | '<' | '>' | '&&' | '||' | ':+' ;
qualified_id ::= identifier ('.' identifier)* ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text    ::= '"' [^"]* '"' ;
number  ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
case_class ::= 'case' 'class' identifier ('(' params? ')')? (':' type_list)? ; ;
for_comp ::= 'for' '{' for_gen (';' for_gen)* '}' 'yield'? expr ; ;
for_gen ::= identifier '<-' expr ('if' expr)? ; ;
try_expr ::= 'try' expr_or_block ('catch' '{' case_clause* '}')? ('finally' expr_or_block)? ; ;
implicit_param ::= 'implicit' param ; ;
implicit_val ::= 'implicit' 'val' identifier ':' type '=' expr ; ;
given_def ::= 'given' identifier? ':' type '=' expr ; ;
using_param ::= 'using' param ; ;
package_object ::= 'package' 'object' identifier '{' member* '}' ; ;
type_bounds ::= identifier ('<:' type)? ('>:' type)? ; ;
self_type ::= identifier ':' type '=>' ; ;
