<for_statement> ::= 'for' '(' <expr> ';' <expr> ';' <expr> ')' <statement_or_block>
<foreach_statement> ::= 'foreach' '(' <expr> 'as' <variable> ')' <statement_or_block>
<foreach_statement> ::= 'foreach' '(' <expr> 'as' <variable> '=>' <variable> ')' <statement_or_block>

<try_statement> ::= 'try' '{' <statement_seq>? '}' <catch_clause> <finally_clause>?
<try_statement> ::= 'try' '{' <statement_seq>? '}' <finally_clause>
<catch_clause> ::= 'catch' '(' <type_ref> <variable> ')' '{' <statement_seq>? '}'
