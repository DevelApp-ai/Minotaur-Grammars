<throw_statement> ::= 'throw' <expr> ';'
<goto_statement> ::= 'goto' <identifier> ';'

<echo_statement> ::= 'echo' <expr> ';'
<echo_statement> ::= 'echo' <expr> ',' <expr> ';'

<unset_statement> ::= 'unset' '(' <unset_list> ';'
<unset_list> ::= <expr> ')'
<unset_list> ::= <expr> ',' <unset_list>

<statement_or_block> ::= <statement>
<statement_or_block> ::= '{' <statement_seq>? '}'


<attribute_groups> ::= <attribute_groups> <attribute_group>
<attribute_groups> ::= <attribute_group>
