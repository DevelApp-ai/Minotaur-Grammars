<top_statement> ::= <declare_block> | <namespace_statement> | <use_declaration> | <class_declaration> | <interface_declaration> | <trait_declaration> | <enum_declaration> | <function_declaration>


<declare_block> ::= 'declare' '(' <declare_item> ')' ';'
