<use_declaration> ::= 'use' <qualified_name> ';'
<use_declaration> ::= 'use' <use_type>? <qualified_name> ';'
<use_type> ::= 'function' | 'const'


<statement> ::= <function_declaration>

<statement_seq> ::= <statement_seq> <statement>
<statement_seq> ::= <statement>

<if_statement> ::= 'if' '(' <expr> ')' <statement_or_block> <elseif_seq>? <else_clause>?
<elseif_seq> ::= <elseif_seq> <elseif_clause>
<elseif_seq> ::= <elseif_clause>
<elseif_clause> ::= 'elseif' '(' <expr> ')' <statement_or_block>
<else_clause> ::= 'else' <statement_or_block>

<while_statement> ::= 'while' '(' <expr> ')' <statement_or_block>
