Grammar: RLang001
FormatType: EBNF

<program> ::= <stmt>* ;
<stmt> ::= <assignment> | <func_def> | <if_stmt> | <for_stmt> | <while_stmt> | <library_stmt> | <expr_stmt> ;
<library_stmt> ::= ('library' | 'require') '(' <identifier> ')' ;
<assignment> ::= <lvalue> ('<-' | '=') <expr> ;
<lvalue> ::= <identifier> | <indexed> ;
<indexed> ::= <identifier> '$' <identifier> | <identifier> '[' <expr> ']' ;
<func_def> ::= <identifier> '<-' 'function' '(' <params>? ')' '{' <stmt>* '}' | 'function' '(' <params>? ')' '{' <stmt>* '}' ;
<params> ::= <param> (',' <param>)* ;
<param> ::= <identifier> ('=' <expr>)? ;
<if_stmt> ::= 'if' '(' <expr> ')' <expr_or_block> ('else' <expr_or_block>)? ;
<for_stmt> ::= 'for' '(' <identifier> 'in' <expr> ')' <expr_or_block> ;
<while_stmt> ::= 'while' '(' <expr> ')' <expr_or_block> ;
<expr_or_block> ::= <expr> | '{' <stmt>* '}' ;
<expr_stmt> ::= <expr> ';' ;
<expr> ::= <literal> | <identifier> | <call> | <indexed> | <expr> <binop> <expr> | '(' <expr> ')' | <formula> ;
<call> ::= <identifier> '(' <args>? ')' ;
<args> ::= <arg> (',' <arg>)* ;
<arg> ::= (<identifier> '=')? <expr> ;
<formula> ::= '~' <expr> ;
<literal> ::= <number> | <text> | <boolean> | 'NULL' | 'NA' | <vector> ;
<vector> ::= 'c' '(' <args>? ')' ;
<boolean> ::= 'TRUE' | 'FALSE' | 'T' | 'F' ;
<binop> ::= '+' | '-' | '*' | '/' | '^' | '==' | '<' | '>' | '<=' | '>=' | '&' | ' | ' | '%%' ;
<identifier> ::= /[a-zA-Z_.][a-zA-Z0-9_.]*/ ;
<text> ::= /'"'[^"]*'"'/ ;
<number> ::= /[0-9]+('.'[0-9]+)?/ ;

# --- Extended coverage: additional language constructs ---
<native_pipe> ::= <expr> ' | >' <call> ;
<in_op> ::= <expr> '%in%' <expr> ;
<repeat_stmt> ::= 'repeat' <expr_or_block> ;
<break_next> ::= ('break' | 'next') ;
<switch_call> ::= 'switch' '(' <expr> (',' <arg>)* ')' ;
<try_catch> ::= 'tryCatch' '(' <expr> ',' 'error' '=' <call> ')' ;
<s3_generic> ::= <identifier> '.' <identifier> '(' <args>? ')' ;
<apply_family> ::= ('sapply' | 'lapply' | 'vapply' | 'apply' | 'mapply') '(' <args> ')' ;
<double_index> ::= <identifier> '[[' <expr> ']]' ;
<seq_colon> ::= <expr> ':' <expr> ;

# --- Coverage completion: remaining language constructs ---
<set_class> ::= "setClass" "(" string <auto_set_class_0> <auto_set_class_1> ")" ;
<set_method> ::= "setMethod" "(" string "," signature_list "," function_definition ")" ;
<set_generic> ::= "setGeneric" "(" string "," function_definition ")" ;
<two_sided_formula> ::= expression "~" expression ;
<raw_string> ::= "r" quote_char "(" raw_body ")" quote_char ;
<pipe_expr> ::= expression ( " | >" | "%>%" | "% |  | %" | "%in%" ) expression ;
<auto_set_class_0> ::= /[ "," slot_list ]/ ;
<auto_set_class_1> ::= /[ "," contains_clause ]/ ;

/* Comments (issue #189) */
<hash-comment> ::= /#[^\n]*/
<comment> ::= <hash-comment>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   identifier, number, string/char literals, punctuation and comments as token
   rules. String/char/block-comment patterns are the proven CSharp10 ones. */
<lx_ws> ::= /[ \t\r\n]+/ => { skip }
<lx_backslash> ::= /\\/
<lx_identifier> ::= /[A-Za-z_][A-Za-z0-9_]*/
<lx_number> ::= /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
<lx_string> ::= /"([^"\\\n]|\\.)*"/
<lx_char0> ::= /'[^'\n]'/
<lx_char1> ::= /'\x5C.'/
<lx_char2> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<lx_char3> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
<lx_block_comment0> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= "."
<lx_p9> ::= "?"
<lx_p10> ::= ":"
<lx_p11> ::= "!"
<lx_p12> ::= "+"
<lx_p13> ::= "-"
<lx_p14> ::= "*"
<lx_p15> ::= "/"
<lx_p16> ::= "%"
<lx_p17> ::= "="
<lx_p18> ::= "<"
<lx_p19> ::= ">"
<lx_p20> ::= "&"
<lx_p21> ::= "|"
<lx_p22> ::= "^"
<lx_p23> ::= "~"
<lx_p24> ::= "@"
<lx_p25> ::= "`"
<lx_p26> ::= '"'
<lx_p27> ::= "'"
<lx_p28> ::= "=>"
<lx_p29> ::= "->"
<lx_p30> ::= "=="
<lx_p31> ::= "!="
<lx_p32> ::= "<="
<lx_p33> ::= ">="
<lx_p34> ::= "&&"
<lx_p35> ::= "||"
<lx_p36> ::= "++"
<lx_p37> ::= "--"
<lx_p38> ::= "+="
<lx_p39> ::= "-="
<lx_p40> ::= "*="
<lx_p41> ::= "/="
<lx_p42> ::= "%="
<lx_p43> ::= "&="
<lx_p44> ::= "|="
<lx_p45> ::= "^="
<lx_p46> ::= "<<"
<lx_p47> ::= ">>"
<lx_p48> ::= "::"
<lx_p49> ::= ".."
<lx_p50> ::= "..."
<lx_p51> ::= "**"
<lx_p52> ::= "??"
<lx_p53> ::= "?."
<lx_p54> ::= "<>"
<lx_hash_comment> ::= /#[^\n]*/ => { skip }
<lx_line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
