Grammar: Nim
FormatType: EBNF

<program> ::= <stmt>*
<stmt> ::= <var-decl> | <let-decl> | <const-decl> | <proc-def> | <type-def> | <if-stmt> | <for-stmt> | <while-stmt> | <expr-stmt> | <comment-stmt>
<var-decl> ::= "var" <ident-list> (":" <type>)? ("=" <expr>)?
<let-decl> ::= "let" <ident-list> (":" <type>)? ("=" <expr>)?
<const-decl> ::= "const" <ident> (":" <type>)? "=" <expr>
<ident-list> ::= <ident-def> ("," <ident-def>)*
<ident-def> ::= <identifier> (":" <type>)? ("=" <expr>)?
<proc-def> ::= "proc" <identifier> ("(" <params>? ")")? (":" <type>)? <block>
<params> ::= <param> (";" <param>)*
<param> ::= <ident-def> | "var" <ident-def>
<type-def> ::= "type" <identifier> "=" <object-type>
<object-type> ::= "object" <block> | "enum" <block> | <type>
<type> ::= <identifier> ("[" <type> ("," <type>)* "]")? | <identifier> "." <identifier>
<if-stmt> ::= "if" <expr> ":" <block> ("elif" <expr> ":" <block>)* ("else" ":" <block>)?
<for-stmt> ::= "for" <identifier> "in" <expr> ":" <block>
<while-stmt> ::= "while" <expr> ":" <block>
<block> ::= <stmt>*
<expr-stmt> ::= <expr>
<comment-stmt> ::= "discard" <expr>?
<expr> ::= <assignment>
<assignment> ::= <lvalue> "=" <expr> | <or-expr>
<lvalue> ::= <identifier> ("." <identifier> | "[" <expr> "]")*
<or-expr> ::= <and-expr> ("or" <and-expr>)*
<and-expr> ::= <not-expr> ("and" <not-expr>)*
<not-expr> ::= "not" <not-expr> | <comparison>
<comparison> ::= <add> (("==" | "!=" | "<" | "<=" | ">" | ">=") <add>)?
<add> ::= <mul> (("+" | "-" | "&") <mul>)*
<mul> ::= <unary> (("*" | "/" | "div" | "mod" | "%") <unary>)*
<unary> ::= ("-" | "+")? <postfix>
<postfix> ::= <primary> ("(" <args>? ")" | "." <identifier> | "[" <expr> "]" | "{" <args> "}")*
<args> ::= <expr> ("," <expr>)* | <identifier> ":" <expr>
<primary> ::= <identifier> | <number> | <string> | <char> | "(" <expr> ")" | "[" <args> "]" | "@[" <args> "]"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Nim 2: ws, # and #[ ]# comments, triple/raw strings, strings, chars, numbers, identifiers (with _), operators. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /\#\[\([^#]|#[^\]])*#\]/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /r"([^"\\]|\\.)*"/
<string> ::= /"([^"\\\n]|\\.)*"/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[fFlL]?)/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\.\.|\x2F|div|mod|and|not|xor|shl|shr|->|=>|::|:=|==|!=|<=|>=|\+|\*|or|\||\^|\?|\.|\(|\)|\[|\]|\{|\}|\$|\\|<|>|-|%|&|~|!|:|,|;|@|"|'/
