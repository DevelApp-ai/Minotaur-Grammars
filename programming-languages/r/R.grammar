# --- Coverage completion: remaining language constructs ---

set_class ::= "setClass" "(" string [ "," slot_list ] [ "," contains_clause ] ")" ;
set_method ::= "setMethod" "(" string "," signature_list "," function_definition ")" ;
set_generic ::= "setGeneric" "(" string "," function_definition ")" ;
two_sided_formula ::= expression "~" expression ;
raw_string ::= "r" quote_char "(" raw_body ")" quote_char ;
pipe_expr ::= expression ( "|>" | "%>%" | "%||%" | "%in%" ) expression ;
