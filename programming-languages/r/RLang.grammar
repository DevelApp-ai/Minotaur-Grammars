Grammar: RLang
FormatType: EBNF

<program> ::= <stmt>* ;
<stmt> ::= <assignment> | <func_def> | <if_stmt> | <for_stmt> | <while_stmt> | <library_stmt> | <expr_stmt> ;
<library_stmt> ::= ('library' | 'require') '(' <identifier> ')' ;
<assignment> ::= <lvalue> ('<-' | '=') <expr> ;
<lvalue> ::= <identifier> | <indexed> ;
<indexed> ::= <identifier> '$' <identifier> | <identifier> '[' <expr> ']' ;
<func_def> ::= <identifier> '<-' 'function' '(' <params>? ')' '{' <stmt>* '}' | 'function' '(' <params>? ')' '{' <stmt>* '}' ;
<params> ::= <param> (',' <param>)* ;
<param> ::= <identifier> ('=' <expr>)? ;
<if_stmt> ::= 'if' '(' <expr> ')' <expr_or_block> ('else' <expr_or_block>)? ;
<for_stmt> ::= 'for' '(' <identifier> 'in' <expr> ')' <expr_or_block> ;
<while_stmt> ::= 'while' '(' <expr> ')' <expr_or_block> ;
<expr_or_block> ::= <expr> | '{' <stmt>* '}' ;
<expr_stmt> ::= <expr> ';' ;
<expr> ::= <literal> | <identifier> | <call> | <indexed> | <expr> <binop> <expr> | '(' <expr> ')' | <formula> ;
<call> ::= <identifier> '(' <args>? ')' ;
<args> ::= <arg> (',' <arg>)* ;
<arg> ::= (<identifier> '=')? <expr> ;
<formula> ::= '~' <expr> ;
<literal> ::= <number> | <text> | <boolean> | 'NULL' | 'NA' | <vector> ;
<vector> ::= 'c' '(' <args>? ')' ;
<boolean> ::= 'TRUE' | 'FALSE' | 'T' | 'F' ;
<binop> ::= '+' | '-' | '*' | '/' | '^' | '==' | '<' | '>' | '<=' | '>=' | '&' | ' | ' | '%%' ;
<identifier> ::= /[a-zA-Z_.][a-zA-Z0-9_.]*/ ;

<text> ::= <string>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   R 4.1+: # comments, raw strings r"(..)"/r'(..)', <- and |> pipes, native pipe, %op%, slots $ @ */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /r\x22\([^)]*\)\x22/
<string> ::= /r'\([^)]*\)'/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<backtick_ident> ::= /`[^`\n]+`/
<number> ::= /0[xX][0-9a-fA-F.]+([pP][+-]?[0-9]+)?/
<number> ::= /[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9]+)?[Ll]?/
<number> ::= /\.[0-9][0-9_]*([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z.][a-zA-Z0-9._]*/
<slot> ::= /[$@]/
<backslash> ::= /\\/
<lx_op0> ::= "<-"
<lx_op1> ::= "<<-"
<lx_op2> ::= "->"
<lx_op3> ::= "->>"
<lx_op4> ::= "=>"
<lx_op5> ::= "=="
<lx_op6> ::= "!="
<lx_op7> ::= "<="
<lx_op8> ::= ">="
<lx_op9> ::= "&&"
<lx_op10> ::= "||"
<lx_op11> ::= ".."
<lx_op12> ::= "..."
<lx_op13> ::= "::"
<lx_op14> ::= ":::"
<lx_op15> ::= "|>"
<pct_op> ::= /%[^%\s]*%/
<op_single> ::= /[-+*\x2F&|^~<>=!?:@.]/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
