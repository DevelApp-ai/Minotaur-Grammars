Grammar: GrammarFile001
FormatType: EBNF

﻿Grammar: CEBNF

<grammar contents> ::= <start-lines> <EOL> <additional lines>
<start-lines>      ::= <first-line> [<second-line>]
<first-line>       ::= "Grammar:" <opt-whitespace> <word> <opt-whitespace> <EOL>
<second-line>      ::= "TokenSplitter:" <opt-whitespace> ( "None" | "Space" | <regex> ) <opt-whitespace> <EOL>
<regex>            ::= "\"" <text> "\""
<text>             ::= ("a-zA-Z0-9" | "_" | "-" | "(" | ")" | "*" | ".")+
<additional lines> ::= TOKEN* <EOL>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Meta grammar (.grammar/.extension/project files): ws, EOL, words, strings, comments. */
<opt-whitespace> ::= /[ \t]*/
<EOL> ::= /\n|\r\n/
<word> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<ANSI_WORD> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<TOKEN> ::= /[^\s]+/
<lx_string> ::= /"([^"\\\n]|\\.)*"/
<lx_hash_comment> ::= /#[^\n]*/ => { skip }
<lx_line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
