Grammar: REXX
FormatType: EBNF

<program> ::= <clause>*
<clause> ::= <label> ":" | <stmt>
<label> ::= <identifier>
<stmt> ::= <assign> | <if> | <do> | <call> | <say> | <parse> | <return> | <expr>
<assign> ::= <var> "=" <expr>
<var> ::= <identifier>
<if> ::= "IF" <expr> "THEN" <stmt> ("ELSE" <stmt>)?
<do> ::= "DO" <var> "=" <expr> "TO" <expr> ("BY" <expr>)? <stmt>* "END" | "DO" <expr> "TIMES" <stmt>* "END"
<call> ::= "CALL" <identifier> <args>?
<say> ::= "SAY" <expr>
<parse> ::= "PARSE" <src> <template>
<src> ::= "ARG" | "VALUE" <expr> "WITH"
<template> ::= <var> (<string> <var>)*
<return> ::= "RETURN" <expr>?
<args> ::= <expr> ("," <expr>)*
<expr> ::= <concat>
<concat> ::= <rel> ("||" <rel>)*
<rel> ::= <add> (("=" | "==" | "\=" | "<>" | "<" | "<=" | ">" | ">=") <add>)?
<add> ::= <mul> (("+" | "-") <mul>)*
<mul> ::= <unary> (("*" | "/" | "%" | "//" | "**") <unary>)*
<unary> ::= ("-" | "+")? <primary>
<primary> ::= <identifier> | <number> | <string> | "(" <expr> ")" | <identifier> "(" <args> ")"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   REXX: ws, -- and /* */ comments, single/double-quoted strings, identifiers with . ? !, numbers, operators incl || concat. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /--[^\n]*/ => { skip }
<comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[a-zA-Z]?)/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_.?!$]*/
<string> ::= /'([^'\\\n]|\\.)*'/
<op> ::= /\x2F\x2F|\|\||\*\*|\x2F|\\=|\^=|==|<>|<=|>=|<<|>>|\+|\*|\||\(|\)|\.|\\|<|>|=|-|%|&|,|;|:|"|'/
