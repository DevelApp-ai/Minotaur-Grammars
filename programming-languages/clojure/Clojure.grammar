Grammar: Clojure
Language version: Clojure 1.2+ (defrecord/deftype; atoms since 1.0).
FormatType: EBNF

<program> ::= <form>* ;
<form> ::= <list> | <vector> | <map> | <set> | <literal> | <symbol> | <keyword> | <quote> ;
<quote> ::= '\'' <form> ;
<list> ::= '(' <form>* ')' ;
<vector> ::= '[' <form>* ']' ;
<map> ::= '{' (<form> <form>)* '}' ;
<set> ::= '#{' <form>* '}' ;
<symbol> ::= <ns_symbol> | <plain_symbol> ;
<ns_symbol> ::= <plain_symbol> '/' <plain_symbol> ;
<plain_symbol> ::= /[a-zA-Z*+!_?<>=.\/-][a-zA-Z0-9*+!_?<>=.\/-]*/ ;
<keyword> ::= ':' (<plain_symbol> | <ns_symbol>) ;
<literal> ::= <number> | <text> | <char> | 'nil' | 'true' | 'false' ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Clojure: ; comments, symbols/keywords, chars \a, numbers incl. ratios/radix */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /[;][^\n]*/ => { skip }
<number> ::= /[+-]?[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?/
<number> ::= /[+-]?[0-9]+[eE][+-]?[0-9]+/
<number> ::= /[+-]?[0-9]+\x2F[0-9]+/
<number> ::= /0[xX][0-9a-fA-F]+/
<number> ::= /[0-9]+[rR][0-9a-zA-Z]+/
<number> ::= /0[0-7]+/
<number> ::= /[+-]?[0-9]+/
<text> ::= /"([^"\\\n]|\\.)*"/
<char> ::= /\\u[0-9a-fA-F]{4}/
<char> ::= /\\o[0-7]{1,3}/
<char> ::= /\\[a-zA-Z]+/
<char> ::= /\\./
<plain_symbol> ::= /[a-zA-Z*+!_?<>=.\x2F~%-][a-zA-Z0-9*+!_?<>=.\x2F~%:-]*/
<keyword> ::= /::[a-zA-Z0-9*+!_?<>=.\x2F~?-]+/
<keyword> ::= /:[a-zA-Z0-9*+!_?<>=.\x2F~?-]+/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<lx_hash> ::= /#/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
<lx_p10> ::= "`"
<lx_p11> ::= "~"
<lx_p12> ::= "@"
<lx_p13> ::= "^"
<lx_p14> ::= "#"
