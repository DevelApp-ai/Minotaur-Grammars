Grammar: Clojure
FormatType: EBNF
TokenSplitter: Space

program  ::= form* ;
form     ::= list | vector | map | set | literal | symbol | keyword | quote ;
quote    ::= '\'' form ;
list     ::= '(' form* ')' ;
vector   ::= '[' form* ']' ;
map      ::= '{' (form form)* '}' ;
set      ::= '#{' form* '}' ;
symbol   ::= ns_symbol | plain_symbol ;
ns_symbol ::= plain_symbol '/' plain_symbol ;
plain_symbol ::= [a-zA-Z*+!_?<>=./-][a-zA-Z0-9*+!_?<>=./-]* ;
keyword  ::= ':' (plain_symbol | ns_symbol) ;
literal  ::= number | text | char | 'nil' | 'true' | 'false' ;
char     ::= '\\' [a-zA-Z] ;
text     ::= '"' [^"]* '"' ;
number   ::= [0-9]+ ('.' [0-9]+)? ;

# --- Extended coverage: additional language constructs ---
destruct_map ::= '{' (':' plain_symbol plain_symbol)* '}' ; ;
destruct_rest ::= '&' plain_symbol ; ;
thread_first ::= '(->' form+ ')' ; ;
thread_last ::= '(->>' form+ ')' ; ;
let_fn ::= '(letfn' '[' ( '(' plain_symbol vector form+ ')' )* ']' form* ')' ; ;
loop_recur ::= '(loop' '[' (form form)* ']' form* ('(recur' form* ')')? ')' ; ;
try_catch ::= '(try' form* ('(catch' plain_symbol plain_symbol form+ ')')* ('(finally' form+ ')')? ')' ; ;
def_multi ::= '(defmulti' plain_symbol form* ')' ; ;
def_method ::= '(defmethod' plain_symbol form form+ ')' ; ;
metadata_form ::= '^' map form ; ;
