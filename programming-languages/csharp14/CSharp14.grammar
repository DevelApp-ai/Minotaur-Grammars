<ns_head> ::= /namespace[^\n{};]+/
<attr_list> ::= /\[[^\[\]\n]*\]/
<modifiers(priority:10)> ::= /(public|private|protected|internal|static|sealed|abstract|partial|readonly|ref|unsafe|extern|new|override|virtual|async|required|file|const|volatile)( (public|private|protected|internal|static|sealed|abstract|partial|readonly|ref|unsafe|extern|new|override|virtual|async|required|file|const|volatile))*/
