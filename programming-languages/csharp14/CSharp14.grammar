Grammar: CSharp14
FormatType: EBNF

Keywords: abstract, as, base, bool, break, byte, case, catch, char, checked, class, const, continue, decimal, default, delegate, do, double, else, enum, event, explicit, extern, false, finally, fixed, float, for, foreach, goto, if, implicit, in, int, interface, internal, is, lock, long, namespace, new, null, object, operator, out, override, params, private, protected, public, readonly, ref, return, sbyte, sealed, short, sizeof, stackalloc, static, string, struct, switch, this, throw, true, try, typeof, uint, ulong, unchecked, unsafe, ushort, using, virtual, void, volatile, while, add, alias, ascending, async, await, by, descending, dynamic, equals, from, get, global, group, into, join, let, nameof, notnull, on, orderby, partial, remove, select, set, unmanaged, value, var, when, where, with, yield, and, or, not, record, init, file, scoped, required
<link_token> ::= <identifier> | <string_literal>

<whitespace> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /\x2F\x2F[^\n]*/ => { skip }
/* Block comments: within-rule group/alternation, compiled by the engine to a
   forward-only NFA (ENFAStepLexer-StepParser issue #129). */
<comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<identifier> ::= /[a-zA-Z_@][a-zA-Z0-9_]*/
<integer_literal> ::= /[0-9]+/
<integer_literal> ::= /0[xX][0-9a-fA-F]+/
<integer_literal> ::= /0[bB][01]+/
<integer_literal> ::= /[0-9]+[uUlL][uUlL]?/
/* Digit separators (C# 7+): 1_000_000, 0xDEAD_BEEF, 0b1010_1010.
   Underscores must sit between digits, hence the two-digit bookends. */
<integer_literal> ::= /[0-9][0-9_]*[0-9]/
<integer_literal> ::= /0[xX][0-9a-fA-F][0-9a-fA-F_]*[0-9a-fA-F]/
<integer_literal> ::= /0[bB][01][01_]*[01]/
<real_literal> ::= /[0-9]*\.[0-9]+/
<real_literal> ::= /[0-9]+\.[0-9]*[fFdDmM]/
<real_literal> ::= /[0-9]*\.[0-9]+[eE][+-]?[0-9]+/
<real_literal> ::= /[0-9]+[eE][+-]?[0-9]+/
<char_literal> ::= /'[^'\n]'/
/* Char escapes as same-named alternatives ('\n', '\'', '\\', '\u0041',
   '\x41'); \x5C is a literal backslash so the pattern stays inside the
   supported linear subset. */
<char_literal> ::= /'\x5C.'/
<char_literal> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<char_literal> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
/* Regular strings with escaped interior characters (\"a\\\"b\"). */
<string_literal> ::= /"([^"\\\n]|\\.)*"/
/* Verbatim strings with doubled quotes (@"a""b"). */
<verbatim_string_literal> ::= /@"([^"]|"")*"/
<interpolated_string_literal> ::= /\$"([^"\\\n]|\\.)*"/
/* Raw string literals (C# 10): at least three quotes, interior quotes allowed
   as long as no run of three closes the literal early. */
<raw_string_literal> ::= /[\x22]{3}[^\x22]*[\x22]{3}/
<raw_string_literal> ::= /[\x22]{3}([^\x22]|[\x22][^\x22]|[\x22]{2}[^\x22])*[\x22]{3}/
