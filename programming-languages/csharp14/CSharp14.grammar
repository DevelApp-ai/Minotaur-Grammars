<pp_directive> ::= /#[^\n]*/ => { skip }
<using_directive(priority:10)> ::= /using[^\n;{}]*;/
<ns_head> ::= /namespace[^\n{};]+/
<attr_list> ::= /\[[^\[\]\n]*\]/
<modifiers(priority:10)> ::= /(public|private|protected|internal|static|sealed|abstract|partial|readonly|ref|unsafe|extern|new|override|virtual|async|required|file|const|volatile)( (public|private|protected|internal|static|sealed|abstract|partial|readonly|ref|unsafe|extern|new|override|virtual|async|required|file|const|volatile))*/
<class_head> ::= /(class|interface|struct|record)[^\n{};]*/
<enum_head> ::= /enum[^\n{};]*/
<delegate_stmt> ::= /delegate[^\n{}();]*\([^()]*\)[^\n{};]*;/
<field_init(priority:10)> ::= /=([^;{}\n"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}\n"']|"[^"\n]*"|'[^'\n]*')*\})+;/
<arrow_tail> ::= /=>([^;\n{}"']|"[^"\n]*"|'[^'\n]*')+;/
<params_token> ::= /\(([^()]|\([^()]*\))*\)/
<params_semi> ::= /\(([^()]|\([^()]*\))*\)[ \t]*;/
<ctor_colon_part> ::= /:(this|base)\(([^()]|\([^()]*\))*\)/
<jump_stmt> ::= /(return|break|continue|goto|throw|await|yield)([^;{}"'\n]|"[^"\n]*"|'[^'\n]*')*;/
<var_stmt> ::= /var[ \t][^;{}\n]*;/
<flow_head> ::= /(if|for|foreach|while|switch|lock|fixed|using|catch|checked|unchecked)[^\n{}]*\)/
<case_label> ::= /(case|default)[^\n{};]*:/
<qual_type> ::= /[A-Za-z_@][A-Za-z0-9_]*(\.[A-Za-z_@][A-Za-z0-9_]+)+(<([^<>]|<[^<>]*>)*>)?/
<gen_type> ::= /[A-Za-z_@][A-Za-z0-9_]*<([^<>]|<[^<>]*>)*>/
<array_type> ::= /[A-Za-z_@][A-Za-z0-9_]*(\[[^\]\n]*\])+/
