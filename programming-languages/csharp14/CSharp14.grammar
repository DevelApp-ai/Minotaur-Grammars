<field_init(priority:10)> ::= /=([^;{}\n"']|"[^"\n]*"|'[^'\n]*'|\(([^;(){}"']|"[^"\n]*"|'[^'\n]*')*\)|\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*')*\})*\})*\}|\n[ \t]*\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*')*\})*\})*\})+;/
<arrow_tail> ::= /=>([^;\n{}"']|"[^"\n]*"|'[^'\n]*')+;/
<params_token> ::= /\(([^()]|\(([^()]|\(([^()]|\([^()]*\))*\))*\))*\)/
<params_semi> ::= /\(([^()]|\(([^()]|\(([^()]|\([^()]*\))*\))*\))*\)[ \t]*;/
<ctor_colon_part> ::= /:(this|base)\(([^()]|\([^()]*\))*\)/
<jump_stmt> ::= /(return|break|continue|goto|throw|await|yield)([^;"'\n{}]|"[^"\n]*"|'[^'\n]*'|\(([^;()]|"[^"\n]*"|'[^'\n]*'|\(([^;()]|"[^"\n]*"|'[^'\n]*')*\)|\{[^;{}]*\})*\)|\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*')*\})*\})*\}|\n[ \t]*\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*'|\{([^;{}"']|"[^"\n]*"|'[^'\n]*')*\})*\})*\})*;/
