Grammar: Swift001
FormatType: EBNF

<program> ::= <import_stmt>* <decl>* ;
<import_stmt> ::= 'import' <identifier> ;
<decl> ::= <comment> | <func_decl> | <class_decl> | <struct_decl> | <enum_decl> | <var_decl> | <let_decl> ;
<func_decl> ::= 'func' <identifier> '(' <params>? ')' ('->' <type>)? '{' <stmt>* '}' ;
<params> ::= <param> (',' <param>)* ;
<param> ::= (<identifier> ':')? <identifier> ':' <type> ('=' <expr>)? ;
<class_decl> ::= 'class' <identifier> (':' <type_list>)? '{' <decl>* '}' ;
<struct_decl> ::= 'struct' <identifier> (':' <type_list>)? '{' <decl>* '}' ;
<enum_decl> ::= 'enum' <identifier> (':' <type>)? '{' <enum_case>* '}' ;
<enum_case> ::= 'case' <identifier> ('(' <types>? ')')? ;
<types> ::= <type> (',' <type>)* ;
<var_decl> ::= 'var' <identifier> ':' <type> ('=' <expr>)? ;
<let_decl> ::= 'let' <identifier> (':' <type>)? '=' <expr> ;
<stmt> ::= <expr_stmt> | <return_stmt> | <if_stmt> | <guard_stmt> | <for_stmt> | <while_stmt> | <decl> ;
<expr_stmt> ::= <expr> ;
<return_stmt> ::= 'return' <expr>? ;
<if_stmt> ::= 'if' <expr> '{' <stmt>* '}' ('else' 'if' <expr> '{' <stmt>* '}')* ('else' '{' <stmt>* '}')? ;
<guard_stmt> ::= 'guard' <expr> 'else' '{' <stmt>* '}' ;
<for_stmt> ::= 'for' <identifier> 'in' <expr> '{' <stmt>* '}' ;
<while_stmt> ::= 'while' <expr> '{' <stmt>* '}' ;
<expr> ::= <literal> | <identifier> | <call> | <member> | <expr> <binop> <expr> | '(' <expr> ')' | <closure> ;
<call> ::= <expr> '(' <args>? ')' ;
<member> ::= <expr> '.' <identifier> ;
<args> ::= <arg> (',' <arg>)* ;
<arg> ::= (<identifier> ':')? <expr> ;
<closure> ::= '{' (<params>)? '->' <type>? 'in' <stmt>* '}' ;
<type> ::= <identifier> | '[' <type> ']' | <type> '?' | <type> '!' ;
<type_list> ::= <type> (',' <type>)* ;
<literal> ::= <number> | <text> | <boolean> | 'nil' ;
<boolean> ::= 'true' | 'false' ;
<binop> ::= '+' | '-' | '*' | '/' | '==' | '<' | '>' | '&&' | '||' | '?.' | '??' ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;
<text> ::= /'"'[^"]*'"'/ ;
<number> ::= /[0-9]+('.'[0-9]+)?/ ;

# --- Coverage completion: remaining language constructs ---
<actor_declaration> ::= attribute_list? access_modifier? "actor" <identifier> inheritance_clause? type_constraints? actor_body ;
<async_modifier> ::= ( "async" | "async" "throws" | "reasync" | "rethrows" ) ;
<await_expression> ::= ( "await" | "try" "await" | "await" "try" ) expression ;
<property_wrapper> ::= wrapper_attribute variable_declaration ;
<result_builder_annotation> ::= "@" <identifier> <auto_result_builder_annotation_0> declaration ;
<deinit_block> ::= "deinit" code_block ;
<required_initializer> ::= "required" initializer_declaration ;
<lazy_property> ::= "lazy" variable_declaration ;
<inout_parameter> ::= parameter_name ":" "inout" type_annotation ;
<auto_result_builder_annotation_0> ::= /[ "(" argument_list ")" ]/ ;

/* Comments (issue #189) */
<single-line-comment> ::= /\/\/[^\n]*/
<multi-line-comment> ::= /\/\*([^*]|\*+[^*/])*\*+\//
<comment> ::= <single-line-comment> | <multi-line-comment>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   identifier, number, string/char literals, punctuation and comments as token
   rules. String/char/block-comment patterns are the proven CSharp10 ones. */
<lx_ws> ::= /[ \t\r\n]+/ => { skip }
<lx_backslash> ::= /\\/
<lx_identifier> ::= /[A-Za-z_][A-Za-z0-9_]*/
<lx_number> ::= /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
<lx_string> ::= /"([^"\\\n]|\\.)*"/
<lx_char0> ::= /'[^'\n]'/
<lx_char1> ::= /'\x5C.'/
<lx_char2> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<lx_char3> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
<lx_block_comment0> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= "."
<lx_p9> ::= "?"
<lx_p10> ::= ":"
<lx_p11> ::= "!"
<lx_p12> ::= "+"
<lx_p13> ::= "-"
<lx_p14> ::= "*"
<lx_p15> ::= "/"
<lx_p16> ::= "%"
<lx_p17> ::= "="
<lx_p18> ::= "<"
<lx_p19> ::= ">"
<lx_p20> ::= "&"
<lx_p21> ::= "|"
<lx_p22> ::= "^"
<lx_p23> ::= "~"
<lx_p24> ::= "@"
<lx_p25> ::= "`"
<lx_p26> ::= '"'
<lx_p27> ::= "'"
<lx_p28> ::= "=>"
<lx_p29> ::= "->"
<lx_p30> ::= "=="
<lx_p31> ::= "!="
<lx_p32> ::= "<="
<lx_p33> ::= ">="
<lx_p34> ::= "&&"
<lx_p35> ::= "||"
<lx_p36> ::= "++"
<lx_p37> ::= "--"
<lx_p38> ::= "+="
<lx_p39> ::= "-="
<lx_p40> ::= "*="
<lx_p41> ::= "/="
<lx_p42> ::= "%="
<lx_p43> ::= "&="
<lx_p44> ::= "|="
<lx_p45> ::= "^="
<lx_p46> ::= "<<"
<lx_p47> ::= ">>"
<lx_p48> ::= "::"
<lx_p49> ::= ".."
<lx_p50> ::= "..."
<lx_p51> ::= "**"
<lx_p52> ::= "??"
<lx_p53> ::= "?."
<lx_p54> ::= "<>"
<lx_line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<lx_hash_comment> ::= /#[^\n]*/ => { skip }
<lx_block_comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
