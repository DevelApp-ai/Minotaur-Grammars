Grammar: Swift
FormatType: EBNF

<program> ::= <import_stmt>* <decl>* ;
<import_stmt> ::= 'import' <identifier> ;
<decl> ::= <comment> | <func_decl> | <class_decl> | <struct_decl> | <enum_decl> | <var_decl> | <let_decl> ;
<func_decl> ::= 'func' <identifier> '(' <params>? ')' ('->' <type>)? '{' <stmt>* '}' ;
<params> ::= <param> (',' <param>)* ;
<param> ::= (<identifier> ':')? <identifier> ':' <type> ('=' <expr>)? ;
<class_decl> ::= 'class' <identifier> (':' <type_list>)? '{' <decl>* '}' ;
<struct_decl> ::= 'struct' <identifier> (':' <type_list>)? '{' <decl>* '}' ;
<enum_decl> ::= 'enum' <identifier> (':' <type>)? '{' <enum_case>* '}' ;
<enum_case> ::= 'case' <identifier> ('(' <types>? ')')? ;
<types> ::= <type> (',' <type>)* ;
<var_decl> ::= 'var' <identifier> ':' <type> ('=' <expr>)? ;
<let_decl> ::= 'let' <identifier> (':' <type>)? '=' <expr> ;
<stmt> ::= <expr_stmt> | <return_stmt> | <if_stmt> | <guard_stmt> | <for_stmt> | <while_stmt> | <decl> ;
<expr_stmt> ::= <expr> ;
<return_stmt> ::= 'return' <expr>? ;
<if_stmt> ::= 'if' <expr> '{' <stmt>* '}' ('else' 'if' <expr> '{' <stmt>* '}')* ('else' '{' <stmt>* '}')? ;
<guard_stmt> ::= 'guard' <expr> 'else' '{' <stmt>* '}' ;
<for_stmt> ::= 'for' <identifier> 'in' <expr> '{' <stmt>* '}' ;
<while_stmt> ::= 'while' <expr> '{' <stmt>* '}' ;
<expr> ::= <literal> | <identifier> | <call> | <member> | <expr> <binop> <expr> | '(' <expr> ')' | <closure> ;
<call> ::= <expr> '(' <args>? ')' ;
<member> ::= <expr> '.' <identifier> ;
<args> ::= <arg> (',' <arg>)* ;
<arg> ::= (<identifier> ':')? <expr> ;
<closure> ::= '{' (<params>)? '->' <type>? 'in' <stmt>* '}' ;
<type> ::= <identifier> | '[' <type> ']' | <type> '?' | <type> '!' ;
<type_list> ::= <type> (',' <type>)* ;
<literal> ::= <number> | <text> | <boolean> | 'nil' ;
<boolean> ::= 'true' | 'false' ;
<binop> ::= '+' | '-' | '*' | '/' | '==' | '<' | '>' | '&&' | '||' | '?.' | '??' ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;

<comment> ::= <line_comment> | <block_comment>
<text> ::= <string> | <identifier>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Swift 5.5: // and /* */ comments, raw strings #".."#, interpolation, ..< ... operators, $0 closures */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<block_comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /[\x22]{3}([^\x22]|[\x22][^\x22]|[\x22]{2}[^\x22])*[\x22]{3}/
<raw_string> ::= /#\x22[^\x22]*\x22#/
<raw_string> ::= /##\x22[^\x22]*\x22##/
<number> ::= /0[xX][0-9a-fA-F_]+/
<number> ::= /0[oO][0-7_]+/
<number> ::= /0[bB][01_]+/
<number> ::= /[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?/
<number> ::= /\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<dollar_ident> ::= /\$[a-zA-Z0-9_]+/
<lx_op0> ::= "->"
<lx_op1> ::= "..<"
<lx_op2> ::= "..."
<lx_op3> ::= "=="
<lx_op4> ::= "!="
<lx_op5> ::= "<="
<lx_op6> ::= ">="
<lx_op7> ::= "&&"
<lx_op8> ::= "||"
<lx_op9> ::= "??"
<lx_op10> ::= "?."
<lx_op11> ::= "??="
<lx_op12> ::= "+="
<lx_op13> ::= "-="
<lx_op14> ::= "*="
<lx_op15> ::= "/="
<lx_op16> ::= "%="
<lx_op17> ::= "&="
<lx_op18> ::= "|="
<lx_op19> ::= "^="
<lx_op20> ::= "<<"
<lx_op21> ::= ">>"
<lx_op22> ::= "<<="
<lx_op23> ::= ">>="
<lx_op24> ::= "&+"
<lx_op25> ::= "&-"
<lx_op26> ::= "*&"
<op_single> ::= /[-+*\x2F%&|^~<>=!?@.]/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
<lx_p10> ::= ":"
<lx_p11> ::= "#"
