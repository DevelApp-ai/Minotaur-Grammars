Grammar: Lua
FormatType: EBNF
TokenSplitter: Space

chunk    ::= block ;
block    ::= stmt* ;
stmt     ::= assignment | local_decl | func_def | if_stmt | while_stmt | for_stmt | repeat_stmt | return_stmt | expr_stmt ;
assignment ::= var_list '=' expr_list ;
var_list ::= var (',' var)* ;
var      ::= identifier | prefixexp '[' expr ']' | prefixexp '.' identifier ;
prefixexp ::= var | '(' expr ')' ;
local_decl ::= 'local' (attnamelist | func_def) ;
attnamelist ::= name_attrib (',' name_attrib)* ('=' expr_list)? ;
name_attrib ::= identifier ('<' identifier '>')? ;
expr_list ::= expr (',' expr)* ;
func_def ::= 'function' funcname '(' params? ')' block 'end' ;
funcname ::= identifier ('.' identifier)* (':' identifier)? ;
params   ::= identifier (',' identifier)* ;
if_stmt  ::= 'if' expr 'then' block ('elseif' expr 'then' block)* ('else' block)? 'end' ;
while_stmt ::= 'while' expr 'do' block 'end' ;
for_stmt ::= numeric_for | generic_for ;
numeric_for ::= 'for' identifier '=' expr ',' expr (',' expr)? 'do' block 'end' ;
generic_for ::= 'for' identifier (',' identifier)* 'in' expr_list 'do' block 'end' ;
repeat_stmt ::= 'repeat' block 'until' expr ;
return_stmt ::= 'return' expr_list? ';' ;
expr_stmt ::= prefixexp | call ;
call     ::= prefixexp '(' args? ')' | prefixexp ':' identifier '(' args? ')' ;
args     ::= expr_list | table | text ;
expr     ::= literal | var | call | expr binop expr | '(' expr ')' | function_expr ;
function_expr ::= 'function' '(' params? ')' block 'end' ;
binop    ::= '+' | '-' | '*' | '/' | '%' | '^' | '==' | '~=' | '<' | '>' | '<=' | '>=' | '..' | 'and' | 'or' ;
literal  ::= number | text | boolean | 'nil' | table ;
table    ::= '{' field* '}' ;
field    ::= '[' expr ']' '=' expr | identifier '=' expr | expr ;
boolean  ::= 'true' | 'false' ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text     ::= '"' [^"]* '"' ;
number   ::= [0-9]+ ('.' [0-9]+)? ;

# --- Extended coverage: additional language constructs ---
goto_stmt ::= 'goto' identifier ; ;
label_stmt ::= '::' identifier '::' ; ;
method_def ::= 'function' prefixexp ':' identifier '(' params? ')' block 'end' ; ;
varargs ::= '...' ; ;
long_string ::= '[' '='* '[' [^\]]* ']' '='* ']' ; ;
int_div ::= expr '//' expr ; ;
bitwise_op ::= expr ('&' | '|' | '~' | '<<' | '>>') expr ; ;
length_op ::= '#' expr ; ;
error_call ::= 'error' '(' args? ')' ; ;
