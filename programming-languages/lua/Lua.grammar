Grammar: Lua
FormatType: EBNF

/*
 * Lua grammar for the Minotaur parser platform.
 *
 * Coverage: Lua 5.4 (pinned in docs/language-versions.md): assignments,
 * local declarations with <close>/<const> attributes (5.4), function
 * definitions (incl. method ':' names and string/table call args), if/
 * while/for (numeric and generic)/repeat-until, do/end, goto/labels/break
 * (5.2), return, varargs '...', tables, long strings [[..]]/[==[..]==],
 * long comments --[[..]]/--[==[..]==], string escapes, hex floats (0x1p4),
 * integer division '//' and bitwise operators (5.3).
 *
 * Lexer core at the bottom: single-terminal token rules only. Regex
 * alternatives inside productions do not materialize into lexer rules in the
 * engine (ENFAStepLexer-StepParser #129/#133); short-string patterns are the
 * proven CSharp10 ones, '/' is written \x2F inside regexes.
 */

<chunk> ::= <block> ;
<block> ::= <stmt>* <return_stmt>? ;
<stmt> ::= <comment>
         | ';'
         | <assignment>
         | <local_decl>
         | <func_def>
         | <if_stmt>
         | <while_stmt>
         | <for_stmt>
         | <repeat_stmt>
         | <do_stmt>
         | <goto_stmt>
         | <label_stmt>
         | <break_stmt>
         | <expr_stmt> ;
<do_stmt> ::= 'do' <block> 'end' ;
<goto_stmt> ::= 'goto' <identifier> ;
<label_stmt> ::= '::' <identifier> '::' ;
<break_stmt> ::= 'break' ;
<assignment> ::= <var_list> '=' <expr_list> ;
<var_list> ::= <var> (',' <var>)* ;
<var> ::= <identifier> | <prefixexp> '[' <expr> ']' | <prefixexp> '.' <identifier> ;
<prefixexp> ::= <var> | '(' <expr> ')' ;
<local_decl> ::= 'local' <attnamelist> | 'local' <func_def> ;
<attnamelist> ::= <name_attrib> (',' <name_attrib>)* ('=' <expr_list>)? ;
<name_attrib> ::= <identifier> ('<' <identifier> '>')? ;
<expr_list> ::= <expr> (',' <expr>)* ;
<func_def> ::= 'function' <funcname> '(' <params>? ')' <block> 'end' ;
<funcname> ::= <identifier> ('.' <identifier>)* (':' <identifier>)? ;
<params> ::= <namelist> (',' '...')? | '...' ;
<namelist> ::= <identifier> (',' <identifier>)* ;
<if_stmt> ::= 'if' <expr> 'then' <block> ('elseif' <expr> 'then' <block>)* ('else' <block>)? 'end' ;
<while_stmt> ::= 'while' <expr> 'do' <block> 'end' ;
<for_stmt> ::= <numeric_for> | <generic_for> ;
<numeric_for> ::= 'for' <identifier> '=' <expr> ',' <expr> (',' <expr>)? 'do' <block> 'end' ;
<generic_for> ::= 'for' <namelist> 'in' <expr_list> 'do' <block> 'end' ;
<repeat_stmt> ::= 'repeat' <block> 'until' <expr> ;
<return_stmt> ::= 'return' <expr_list>? ';'?
<expr_stmt> ::= <prefixexp> | <call> ;
<call> ::= <prefixexp> <args> | <prefixexp> ':' <identifier> <args> ;
<args> ::= '(' <expr_list>? ')' | <string> | <table> ;
<expr> ::= 'nil' | 'true' | 'false' | '...'
         | <literal> | <var> | <call> | <table> | <function_expr>
         | <unop> <expr>
         | <expr> <binop> <expr>
         | '(' <expr> ')' ;
<function_expr> ::= 'function' '(' <params>? ')' <block> 'end' ;
<binop> ::= '+' | '-' | '*' | '/' | '//' | '%' | '^' | '..'
          | '==' | '~=' | '<=' | '>=' | '<' | '>'
          | 'and' | 'or' | '&' | '|' | '~' | '<<' | '>>' ;
<unop> ::= 'not' | '-' | '#' | '~' ;
<literal> ::= <number> | <string> ;
<table> ::= '{' <field>* '}' ;
<field> ::= '[' <expr> ']' '=' <expr> | <identifier> '=' <expr> | <expr> ;

/* --- Lexer core: single-terminal token rules only (engine #129/#133) --- */

<whitespace> ::= /[ \t\r\n]+/ => { skip }

/* Long comments first: greedy longest match lets them win over <line_comment>
   when the bracket form is present. */
<long_comment> ::= /--\[\[([^\]]|\][^\]])*\]\]/ => { skip }
<long_comment> ::= /--\[=\[([^\]]|\][^\]])*\]=\]/ => { skip }
<long_comment> ::= /--\[==\[([^\]]|\][^\]])*\]==\]/ => { skip }
<line_comment> ::= /--[^\n]*/ => { skip }

<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/

<number> ::= /0[xX][0-9a-fA-F]+(\.[0-9a-fA-F]*)?([pP][+-]?[0-9]+)?/
<number> ::= /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?/
<number> ::= /[0-9]+[eE][+-]?[0-9]+/
<number> ::= /\.[0-9]+([eE][+-]?[0-9]+)?/
<number> ::= /[0-9]+/

<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<long_string> ::= /\[\[([^\]]|\][^\]])*\]\]/
<long_string> ::= /\[=\[([^\]]|\][^\]])*\]=\]/
<long_string> ::= /\[==\[([^\]]|\][^\]])*\]==\]/

<lx_op0> ::= "=="
<lx_op1> ::= "~="
<lx_op2> ::= "<="
<lx_op3> ::= ">="
<lx_op4> ::= ".."
<lx_op5> ::= "..."
<lx_op6> ::= "//"
<lx_op7> ::= "<<"
<lx_op8> ::= ">>"
<lx_op9> ::= "::"
<lx_op_single> ::= /[-+*\x2F%^&|~<>=#:.]/

<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"

<comment> ::= <line_comment> | <long_comment>
