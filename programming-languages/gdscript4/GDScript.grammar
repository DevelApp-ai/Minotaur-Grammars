Grammar: GDScript
FormatType: EBNF

<module> ::= <stmt>*
<stmt> ::= <func-def> | <class-def> | <var-decl> | <const-decl> | <signal-decl> | <annotated> | <expr-stmt> | <if> | <for> | <while> | <match> | <block>
<annotated> ::= <annotation>+ <stmt>
<annotation> ::= "@" <name> ("(" <args>? ")")?
<name> ::= <identifier> ("." <identifier>)*
<func-def> ::= "func" <identifier> "(" <params>? ")" ("->" <type>)? ":" <block>
<params> ::= <param> ("," <param>)*
<param> ::= <identifier> (":" <type>)? ("=" <expr>)?
<class-def> ::= "class_name" <name> | "class" <identifier> ("extends" <name>)? ":" <block>
<var-decl> ::= "var" <identifier> (":" <type>)? (":=" <expr> | "=" <expr>)?
<const-decl> ::= "const" <identifier> (":" <type>)? "=" <expr>
<signal-decl> ::= "signal" <identifier> ("(" <params> ")")?
<type> ::= <name>
<if> ::= "if" <expr> ":" <block> ("elif" <expr> ":" <block>)* ("else" ":" <block>)?
<for> ::= "for" <identifier> "in" <expr> ":" <block>
<while> ::= "while" <expr> ":" <block>
<match> ::= "match" <expr> ":" <match-branch>*
<match-branch> ::= <pattern> ("," <pattern>)* ("if" <expr>)? ":" <block>
<pattern> ::= <identifier> | <literal> | "_" | "[" <pattern> ("," <pattern>)* "]"
<block> ::= <stmt>+
<expr-stmt> ::= <expr>
<expr> ::= <assignment>
<assignment> ::= <lvalue> ("=" | "+=" | "-=") <expr> | <ternary>
<lvalue> ::= <identifier> ("." <identifier> | "[" <expr> "]")*
<ternary> ::= <or> ("if" <or> "else" <ternary>)?
<or> ::= <and> ("or" <and>)*
<and> ::= <not> ("and" <not>)*
<not> ::= "not" <not> | <comparison>
<comparison> ::= <add> (("==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "is") <add>)?
<add> ::= <mul> (("+" | "-" | "&") <mul>)*
<mul> ::= <unary> (("*" | "/" | "//" | "%") <unary>)*
<unary> ::= ("-" | "+" | "~")? <postfix>
<postfix> ::= <primary> ("(" <args>? ")" | "." <identifier> ("(" <args>? ")")? | "[" <expr> "]")*
<args> ::= <expr> ("," <expr>)* | <identifier> "=" <expr>
<primary> ::= <identifier> | <number> | <string> | <triple-sq> | "true" | "false" | "null" | "(" <expr> ")" | "[" <args> "]" | "{" <dict-entries> "}" | "$" <name> | "%" <name>
<dict-entries> ::= <expr> ":" <expr> ("," <expr> ":" <expr>)*
<literal> ::= <number> | <string> | "true" | "false" | "null"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   GDScript 4 (Godot): ws, # comments, triple strings, strings, numbers, identifiers, annotations @, python-like operators. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[a-zA-Z]?)/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<triple-sq> ::= /'''([^']|'[^'])*'''/
<op> ::= /\x2F\x2F|\x2F=|\*\*|\.\.|\x2F|\+=|\*=|and|not|==|!=|<=|>=|-=|%=|:=|->|=>|\.|\+|\*|or|in|is|as|\||\^|<<|>>|\?|\(|\)|\[|\]|\{|\}|\$|\\|<|>|-|%|&|~|!|:|,|;|@|"|'/
