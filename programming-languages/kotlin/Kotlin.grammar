Grammar: Kotlin
FormatType: EBNF

<file> ::= <package_stmt>? <import_stmt>* <decl>* ;
<package_stmt> ::= 'package' <qualified_id> ;
<import_stmt> ::= 'import' <qualified_id> ;
<decl> ::= <comment> | <fun_decl> | <class_decl> | <object_decl> | <val_decl> | <var_decl> ;
<fun_decl> ::= 'fun' (<type> '.')? <identifier> '(' <params>? ')' (':' <type>)? '{' <stmt>* '}' ;
<params> ::= <param> (',' <param>)* ;
<param> ::= <identifier> ':' <type> ('=' <expr>)? ;
<class_decl> ::= ('class' | 'data' 'class') <identifier> ('(' <params>? ')')? (':' <type_list>)? '{' <decl>* '}' ;
<object_decl> ::= 'object' <identifier> (':' <type_list>)? '{' <decl>* '}' ;
<val_decl> ::= 'val' <identifier> (':' <type>)? '=' <expr> ;
<var_decl> ::= 'var' <identifier> (':' <type>)? ('=' <expr>)? ;
<stmt> ::= <expr_stmt> | <return_stmt> | <if_stmt> | <for_stmt> | <while_stmt> | <when_stmt> | <decl> ;
<expr_stmt> ::= <expr> ;
<return_stmt> ::= 'return' <expr>? ;
<if_stmt> ::= 'if' '(' <expr> ')' <block> ('else' <block>)? ;
<for_stmt> ::= 'for' '(' <identifier> 'in' <expr> ')' <block> ;
<while_stmt> ::= 'while' '(' <expr> ')' <block> ;
<when_stmt> ::= 'when' '(' <expr> ')' '{' <when_entry>* '}' ;
<when_entry> ::= (<expr> | 'else') '->' (<block> | <expr>) ;
<block> ::= '{' <stmt>* '}' | <stmt> ;
<expr> ::= <literal> | <identifier> | <call> | <member> | <null_check> | <expr> <binop> <expr> | '(' <expr> ')' | <lambda> ;
<call> ::= <expr> '(' <args>? ')' ;
<member> ::= <expr> '.' <identifier> ;
<null_check> ::= <expr> ('!!' | '?') ;
<args> ::= (<identifier> '=')? <expr> (',' (<identifier> '=')? <expr>)* ;
<lambda> ::= '{' (<params> '->')? <stmt>* '}' ;
<type> ::= <qualified_id> | 'List' '<' <type> '>' | <type> '?' ;
<type_list> ::= <type> (',' <type>)* ;
<literal> ::= <number> | <text> | <boolean> | 'null' ;
<boolean> ::= 'true' | 'false' ;
<binop> ::= '+' | '-' | '*' | '/' | '==' | '!=' | '<' | '>' | '&&' | '||' | '?:' ;
<qualified_id> ::= <identifier> ('.' <identifier>)* ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Kotlin 1.9: // and /* */ comments, triple raw strings, backtick idents, elvis ?: */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<block_comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<string> ::= /[\x22]{3}([^\x22]|[\x22][^\x22]|[\x22]{2}[^\x22])*[\x22]{3}/
<char> ::= /'[^'\n]'/
<char> ::= /'\x5C.'/
<char> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<char> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
<number> ::= /0[xX][0-9a-fA-F_]+/
<number> ::= /0[bB][01_]+/
<number> ::= /[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?[fFlL]?/
<number> ::= /\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?[fF]?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<backtick_ident> ::= /`[^`\n]+`/
<lx_op0> ::= "->"
<lx_op1> ::= "=>"
<lx_op2> ::= "::"
<lx_op3> ::= ".."
<lx_op4> ::= "?."
<lx_op5> ::= "?:"
<lx_op6> ::= "!!"
<lx_op7> ::= "=="
<lx_op8> ::= "!="
<lx_op9> ::= "==="
<lx_op10> ::= "!=="
<lx_op11> ::= "&&"
<lx_op12> ::= "||"
<lx_op13> ::= "++"
<lx_op14> ::= "--"
<lx_op15> ::= "+="
<lx_op16> ::= "-="
<lx_op17> ::= "*="
<lx_op18> ::= "/="
<lx_op19> ::= "%="
<lx_op20> ::= "&="
<lx_op21> ::= "|="
<lx_op22> ::= "^="
<lx_op23> ::= "<<"
<lx_op24> ::= ">>"
<lx_op25> ::= ">>>"
<lx_op26> ::= "<<="
<lx_op27> ::= ">>="
<lx_op28> ::= ">>>="
<op_single> ::= /[-+*\x2F%&|^~<>=!@.]/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
