Grammar: Kotlin
FormatType: EBNF
TokenSplitter: Space

file     ::= package_stmt? import_stmt* decl* ;
package_stmt ::= 'package' qualified_id ;
import_stmt ::= 'import' qualified_id ;
decl     ::= fun_decl | class_decl | object_decl | val_decl | var_decl ;
fun_decl ::= 'fun' (type '.')? identifier '(' params? ')' (':' type)? '{' stmt* '}' ;
params   ::= param (',' param)* ;
param    ::= identifier ':' type ('=' expr)? ;
class_decl ::= ('class'|'data' 'class') identifier ('(' params? ')')? (':' type_list)? '{' decl* '}' ;
object_decl ::= 'object' identifier (':' type_list)? '{' decl* '}' ;
val_decl ::= 'val' identifier (':' type)? '=' expr ;
var_decl ::= 'var' identifier (':' type)? ('=' expr)? ;
stmt     ::= expr_stmt | return_stmt | if_stmt | for_stmt | while_stmt | when_stmt | decl ;
expr_stmt ::= expr ;
return_stmt ::= 'return' expr? ;
if_stmt  ::= 'if' '(' expr ')' block ('else' block)? ;
for_stmt ::= 'for' '(' identifier 'in' expr ')' block ;
while_stmt ::= 'while' '(' expr ')' block ;
when_stmt ::= 'when' '(' expr ')' '{' when_entry* '}' ;
when_entry ::= (expr|'else') '->' (block|expr) ;
block    ::= '{' stmt* '}' | stmt ;
expr     ::= literal | identifier | call | member | null_check | expr binop expr | '(' expr ')' | lambda ;
call     ::= expr '(' args? ')' ;
member   ::= expr '.' identifier ;
null_check ::= expr ('!!' | '?') ;
args     ::= (identifier '=')? expr (',' (identifier '=')? expr)* ;
lambda   ::= '{' (params '->')? stmt* '}' ;
type     ::= qualified_id | 'List' '<' type '>' | type '?' ;
type_list ::= type (',' type)* ;
literal  ::= number | text | boolean | 'null' ;
boolean  ::= 'true' | 'false' ;
binop    ::= '+' | '-' | '*' | '/' | '==' | '!=' | '<' | '>' | '&&' | '||' | '?:' ;
qualified_id ::= identifier ('.' identifier)* ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text     ::= '"' [^"]* '"' ;
number   ::= [0-9]+ ('.' [0-9]+)? ;

# --- Coverage completion: remaining language constructs ---

inline_function ::= modifier_list? "inline" fun_declaration ;
reified_type_parameter ::= "reified" [ "in" | "out" ] type_name [ ":" type_bound ] ;
crossinline_parameter ::= "crossinline" lambda_parameter ;
vararg_parameter ::= "vararg" parameter_name ":" type [ "=" expression ] ;
operator_function ::= "operator" fun_declaration ;
infix_function ::= "infix" fun_declaration ;
tailrec_function ::= "tailrec" fun_declaration ;
data_object ::= "data" "object" identifier [ ":" delegation_list ] class_body? ;
implicit_lambda ::= "{" statement* "}" ;
