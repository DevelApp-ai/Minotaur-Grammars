Grammar: Perl
FormatType: EBNF
TokenSplitter: Space

program  ::= (use_stmt | stmt)* ;
use_stmt ::= 'use' (strict | warnings | qualified_id) ';' ;
strict   ::= 'strict' ;
warnings ::= 'warnings' ;
stmt     ::= assignment | my_decl | sub_def | if_stmt | while_stmt | foreach_stmt | expr_stmt ;
assignment ::= lvalue '=' expr ';' ;
lvalue   ::= scalar_var | array_var | hash_var ;
my_decl  ::= 'my' lvalue ('=' expr)? ';' ;
sub_def  ::= 'sub' identifier '{' stmt* '}' ;
if_stmt  ::= 'if' '(' expr ')' block ('elsif' '(' expr ')' block)* ('else' block)? ;
while_stmt ::= 'while' '(' expr ')' block ;
foreach_stmt ::= 'foreach' 'my'? scalar_var '(' expr ')' block ;
block    ::= '{' stmt* '}' ;
expr_stmt ::= expr ';' ;
expr     ::= literal | var | call | expr binop expr | '(' expr ')' ;
call     ::= ( '&'? identifier | qualified_id ) '(' args? ')' ;
args     ::= expr (',' expr)* ;
var      ::= scalar_var | array_var | hash_var ;
scalar_var ::= '$' identifier ;
array_var  ::= '@' identifier ;
hash_var   ::= '%' identifier ;
literal  ::= number | text | list ;
list     ::= '(' args? ')' ;
binop    ::= '+' | '-' | '*' | '/' | '.' | '==' | 'eq' | 'ne' | '<' | '>' | '&&' | '||' ;
qualified_id ::= identifier ('::' identifier)* ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text     ::= '"' [^"]* '"' ;
number   ::= [0-9]+ ;

# --- Coverage completion: remaining language constructs ---

ternary_expression ::= expression "?" expression ":" expression ;
postfix_modifier ::= statement ( "if" | "unless" | "while" | "until" | "for" | "foreach" ) expression ;
list_slice ::= array_name "[" expression_list "]" ;
hash_slice ::= hash_name "{" expression_list "}" ;
regex_binding ::= expression ( "=~" | "!~" ) ( regex_literal | match_operator | substitution | transliteration ) ;
match_operator ::= "m" delimiter regex_body delimiter [ regex_flags ] ;
sub_signature ::= "sub" identifier "(" sig_parameter_list ")" block ;
