Grammar: Perl
FormatType: EBNF

<program> ::= (<use_stmt> | <stmt>)* ;
<use_stmt> ::= 'use' (<strict> | <warnings> | <qualified_id>) ';' ;
<strict> ::= 'strict' ;
<warnings> ::= 'warnings' ;
<stmt> ::= <comment> | <assignment> | <my_decl> | <sub_def> | <if_stmt> | <while_stmt> | <foreach_stmt> | <expr_stmt> ;
<assignment> ::= <lvalue> '=' <expr> ';' ;
<lvalue> ::= <scalar_var> | <array_var> | <hash_var> ;
<my_decl> ::= 'my' <lvalue> ('=' <expr>)? ';' ;
<sub_def> ::= 'sub' <identifier> '{' <stmt>* '}' ;
<if_stmt> ::= 'if' '(' <expr> ')' <block> ('elsif' '(' <expr> ')' <block>)* ('else' <block>)? ;
<while_stmt> ::= 'while' '(' <expr> ')' <block> ;
<foreach_stmt> ::= 'foreach' 'my'? <scalar_var> '(' <expr> ')' <block> ;
<block> ::= '{' <stmt>* '}' ;
<expr_stmt> ::= <expr> ';' ;
<expr> ::= <literal> | <var> | <call> | <expr> <binop> <expr> | '(' <expr> ')' ;
<call> ::= ( '&'? <identifier> | <qualified_id> ) '(' <args>? ')' ;
<args> ::= <expr> (',' <expr>)* ;
<var> ::= <scalar_var> | <array_var> | <hash_var> ;
<scalar_var> ::= '$' <identifier> ;
<array_var> ::= '@' <identifier> ;
<hash_var> ::= '%' <identifier> ;
<literal> ::= <number> | <text> | <list> ;
<list> ::= '(' <args>? ')' ;
<binop> ::= '+' | '-' | '*' | '/' | '.' | '==' | 'eq' | 'ne' | '<' | '>' | '&&' | '||' ;
<qualified_id> ::= <identifier> ('::' <identifier>)* ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Perl 5.36: # comments, q/qq/qw/qr/m/s/tr with / and {} delimiters, sigil vars $ @ % & * */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<backtick_str> ::= /`([^`\\]|\\.)*`/
<qstr> ::= /q\x2F([^\x2F\\]|\\.)*\x2F/
<qstr> ::= /qq\x2F([^\x2F\\]|\\.)*\x2F/
<qstr> ::= /qw\x2F([^\x2F\\]|\\.)*\x2F[a-z]*/
<qstr> ::= /qr\x2F([^\x2F\\]|\\.)*\x2F[a-z]*/
<qstr> ::= /m\x2F([^\x2F\\]|\\.)*\x2F[a-z]*/
<qstr> ::= /s\x2F([^\x2F\\]|\\.)*\x2F([^\x2F\\]|\\.)*\x2F[a-z]*/
<qstr> ::= /tr\x2F([^\x2F\\]|\\.)*\x2F([^\x2F\\]|\\.)*\x2F[a-z]*/
<qstr> ::= /q\{[^}]*\}/
<qstr> ::= /qq\{[^}]*\}/
<qstr> ::= /qw\{[^}]*\}/
<var> ::= /[$@%&*][a-zA-Z_][a-zA-Z0-9_:]*/
<var> ::= /[$@%&*]/
<number> ::= /0[xX][0-9a-fA-F_]+/
<number> ::= /0[bB][01_]+/
<number> ::= /[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9]+)?/
<number> ::= /\.[0-9][0-9_]*([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<lx_op0> ::= "=~"
<lx_op1> ::= "!~"
<lx_op2> ::= "->"
<lx_op3> ::= "=>"
<lx_op4> ::= "++"
<lx_op5> ::= "--"
<lx_op6> ::= "**"
<lx_op7> ::= "=="
<lx_op8> ::= "!="
<lx_op9> ::= "<="
<lx_op10> ::= ">="
<lx_op11> ::= "<=>"
<lx_op12> ::= "&&"
<lx_op13> ::= "||"
<lx_op14> ::= "//"
<lx_op15> ::= ".."
<lx_op16> ::= "..."
<lx_op17> ::= "<<"
<lx_op18> ::= ">>"
<lx_op19> ::= "+="
<lx_op20> ::= "-="
<lx_op21> ::= "*="
<lx_op22> ::= "/="
<lx_op23> ::= "%="
<lx_op24> ::= ".="
<op_single> ::= /[-+*\x2F%&|^~<>=!?:@.]/
<backslash> ::= /\\/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
<lx_p10> ::= "`"
