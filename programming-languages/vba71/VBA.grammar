Grammar: VBA
FormatType: EBNF

<module> ::= <decl>*
<decl> ::= <sub> | <function> | <global-decl> | <option>
<option> ::= "Option" <identifier> <identifier>
<sub> ::= ("Public" | "Private")? "Sub" <identifier> "(" <params>? ")" <stmt>* "End" "Sub"
<function> ::= ("Public" | "Private")? "Function" <identifier> "(" <params>? ")" ("As" <type>)? <stmt>* "End" "Function"
<params> ::= <param> ("," <param>)*
<param> ::= ("ByVal" | "ByRef")? <identifier> ("As" <type>)? ("=" <expr>)?
<type> ::= <identifier> ("(" ")")?
<global-decl> ::= ("Dim" | "Public" | "Private" | "Global") <var-list> ("As" <type>)?
<var-list> ::= <identifier> ("(" <expr>? ")")? ("," <identifier> ("(" <expr>? ")")?)? 
<stmt> ::= <assign> | <if> | <for> | <while> | <do> | <call> | <return> | <dim> | "'" <identifier> | <expr>
<dim> ::= "Dim" <var-list> ("As" <type>)?
<assign> ::= <lvalue> "=" <expr>
<lvalue> ::= <identifier> ("." <identifier> | "(" <args> ")")*
<if> ::= "If" <expr> "Then" <stmt>* ("ElseIf" <expr> "Then" <stmt>)* ("Else" <stmt>*)? "End" "If"
<for> ::= "For" <identifier> "=" <expr> ("To" | "Step") <expr> <stmt>* "Next"
<while> ::= "While" <expr> <stmt>* "Wend"
<do> ::= "Do" ("While" <expr>)? <stmt>* "Loop" ("While" <expr>)?
<call> ::= <name> ("(" <args>? ")")?
<return> ::= "Return" <expr>?
<name> ::= <identifier>
<args> ::= <expr> ("," <expr>)*
<expr> ::= <or>
<or> ::= <and> ("Or" <and>)*
<and> ::= <not> ("And" <not>)*
<not> ::= "Not" <not> | <rel>
<rel> ::= <concat> (("=" | "<>" | "<" | "<=" | ">" | ">=") <concat>)?
<concat> ::= <add> ("&" <add>)*
<add> ::= <mul> (("+" | "-") <mul>)*
<mul> ::= <unary> (("*" | "/" | "\" | "Mod") <unary>)*
<unary> ::= ("-" | "+")? <primary>
<primary> ::= <identifier> | <number> | <string> | "(" <expr> ")" | "True" | "False" | "Nothing"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   VBA: ws, ' line comments, double-quoted strings with "" doubling, identifiers with _, numbers, operators incl \ and Mod/And/Or. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /'[^\n]*/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[a-zA-Z]?)/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<string> ::= /"([^"]|"")*"/
<op> ::= /\x2F|<=|>=|<>|\+|\*|\\|\^|\(|\)|\.|<|>|=|-|&|,|;|:|_|#|@|"/
