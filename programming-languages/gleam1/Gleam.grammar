Grammar: Gleam
FormatType: EBNF

<module> ::= <import>* <def>*
<import> ::= "import" <name> ("as" <identifier>)?
<name> ::= <identifier> ("." <identifier>)*
<def> ::= <fn-def> | <type-def> | <const-def> | <type-alias>
<fn-def> ::= "pub"? "fn" <identifier> "(" <params>? ")" ("->" <type>)? "{" <stmt>* "}"
<params> ::= <param> ("," <param>)*
<param> ::= <label>? <identifier> ":" <type> | "_" ":" <type>
<label> ::= <identifier> " "
<type-def> ::= "pub"? "type" <name> "{" <variant>* "}"
<variant> ::= <constructor> "(" <type> ("," <type>)* ")"
<constructor> ::= /[A-Z][a-zA-Z0-9_]*/
<type-alias> ::= "pub"? "type" <name> "=" <type>
<const-def> ::= "pub"? "const" <identifier> "=" <literal>
<type> ::= <name> | <constructor> ("(" <type> ("," <type>)* ")")? | "List" "(" <type> ")" | "#(" <type> ("," <type>)* ")" | <identifier> "(" <type> ("," <type>)* ")"
<stmt> ::= <let> | <assign> | <expr> | <case> | <if>
<let> ::= "let" <pattern> "=" <expr>
<assign> ::= <name> "=" <expr
<pattern> ::= <identifier> | <constructor> "(" <pattern> ("," <pattern>)* ")" | "[" <pattern> (";" <pattern>)* "]" | "_" | "#(" <pattern> ("," <pattern>)* ")"
<case> ::= "case" <expr> ("," <expr>)* "{" <clause>+ "}"
<clause> ::= <pattern> ("if" <expr>)? "->" <expr>
<if> ::= "if" <expr> "{" <stmt>* "}" ("else" "{" <stmt>* "}")?
<expr> ::= <pipe>
<pipe> ::= <call> ("|>" <call>)*
<call> ::= <primary> ("(" <args>? ")")?
<args> ::= <labeled-arg> ("," <labeled-arg>)*
<labeled-arg> ::= <expr> | <identifier> ":" <expr>
<primary> ::= <identifier> | <constructor> | <number> | <string> | "(" <expr> ")" | "[" <expr> (";" <expr>)* "]" | "{" <expr> "}"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Gleam 1.x (BEAM): ws, // comments, strings, numbers, identifiers, pipe |> and operators. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[a-zA-Z]?)/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\+\+|\+\.|\.\.|\x2F|\|\||\|>|-\.|==|!=|<=|>=|<>|\.|\+|\*|&&|\(|\)|\[|\]|\{|\}|\\|<|>|-|%|=|:|,|;|@|"|'/
