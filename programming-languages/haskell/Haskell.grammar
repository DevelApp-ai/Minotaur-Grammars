Grammar: Haskell
FormatType: EBNF

/*
 * Haskell grammar for the Minotaur parser platform.
 *
 * Coverage: Haskell 2010 core (modules with export lists, imports incl.
 * qualified/as/hiding, data/type/newtype with deriving, class/instance,
 * type signatures, function bindings with guards and where-clauses, lambda,
 * let/in, if/then/else, case, do-notation, list comprehensions and ranges,
 * operator sections, record construction) plus MultiWayIf and LambdaCase -
 * pinned in docs/language-versions.md.
 *
 * Lexer core at the bottom: single-terminal token rules only. Regex
 * alternatives inside productions do not materialize into lexer rules in the
 * engine (ENFAStepLexer-StepParser #129/#133); string/char patterns are the
 * proven CSharp10 ones, '/' is written \x2F inside regexes.
 */

<module> ::= <module_decl>? <import_stmt>* <top_decl>* ;

<module_decl> ::= 'module' <modid> '(' <export_list>? ')' 'where' ;
<export_list> ::= <export> (',' <export>)* ;
<export> ::= <qname> ('(' <export_list>? ')')? | 'module' <modid> ;
<modid> ::= <conid> ('.' <conid>)* ;
<qname> ::= <identifier> ('.' <identifier>)* ;

<import_stmt> ::= 'import' 'qualified'? <modid> ('as' <modid>)? ('hiding'? '(' <import_list>? ')')? ;
<import_list> ::= <import_item> (',' <import_item>)* ;
<import_item> ::= <qname> ('(' <import_list> ')')? | 'module' <modid> ;

<top_decl> ::= <data_decl> | <type_decl> | <newtype_decl> | <class_decl> | <instance_decl> | <decl> ;
<decl> ::= <signature> | <func_decl> | <infix_decl> ;

<data_decl> ::= 'data' <context>? <conid> <type_var>* ('=' <constructor> ('|' <constructor>)*)? <deriving>? ;
<newtype_decl> ::= 'newtype' <context>? <conid> <type_var>* '=' <constructor> <deriving>? ;
<type_decl> ::= 'type' <conid> <type_var>* '=' <type> ;
<deriving> ::= 'deriving' ('(' <conid> (',' <conid>)* ')' | <conid>) ;
<constructor> ::= <conid> ('{' <field> (',' <field>)* '}')? <btype>*
                | <btype>+ <conop> <btype>+ ;
<field> ::= <var> '::' <type> ;
<context> ::= <type> (',' <type>)* '=>' ;
<class_decl> ::= 'class' <context>? <conid> <type_var> 'where' <decl>* ;
<instance_decl> ::= 'instance' <context>? <conid> <type>* 'where' <decl>* ;
<signature> ::= <var> (',' <var>)* '::' <type> ;
<infix_decl> ::= ('infix' | 'infixl' | 'infixr') <number>? <op> (',' <op>)* ;
<op> ::= <symop> | '`' <qname> '`' ;
<func_decl> ::= <var> <apat>* ('=' <expr> | <guard>+ '=' <expr>) <where_clause>? ;
<guard> ::= '|' <expr> ;
<where_clause> ::= 'where' <decls> ;
<decls> ::= <decl> (';' <decl>)* ;

<type> ::= <btype> ('->' <type>)? ;
<btype> ::= <atype>+ ;
<atype> ::= <identifier> | '(' <type> ')' | '[' <type> ']' | '(' ')' | '(' <type> (',' <type>)* ')' ;

<expr> ::= <infixexp> | <lambda> | <let_expr> | <if_expr> | <case_expr> | <do_expr> | <list_comp> ;
<infixexp> ::= <lexp> (<binop> <lexp>)* ;
<binop> ::= <symop> | '`' <qname> '`' | 'and' | 'or' ;
<lexp> ::= '-'? <aexp>+ ;
<aexp> ::= <qname> | <literal> | '(' <expr> ')' | <list> | <section> | <record_con> ;
<list> ::= '[' (<expr> (',' <expr>)*)? ']' | '[' <expr> '..' <expr>? ']' ;
<section> ::= '(' <expr>? <binop> <expr>? ')' ;
<record_con> ::= <qname> '{' (<field_val> (',' <field_val>)*)? '}' ;
<field_val> ::= <qname> '=' <expr> | <qname> | '.' ;
<list_comp> ::= '[' <expr> '|' <qual> (',' <qual>)* ']' ;
<qual> ::= <apat> '<-' <expr> | 'let' <decls> | <expr> ;
<lambda> ::= <backslash> <apat>+ '->' <expr> | <backslash> 'case' <alt>+ ;
<let_expr> ::= 'let' <decls> 'in' <expr> ;
<if_expr> ::= 'if' <expr> 'then' <expr> 'else' <expr>
            | 'if' '|' <guard>+ '->' <expr> ;
<case_expr> ::= 'case' <expr> 'of' <alt>+ ;
<alt> ::= <pat> <guard>* '->' <expr> <where_clause>? ;
<do_expr> ::= 'do' <stmt>+ ;
<stmt> ::= <apat> '<-' <expr> | 'let' <decls> | <expr> ;
<pat> ::= <apat> (<conop> <apat>)* ;
<conop> ::= ':' <symop> ;
<apat> ::= '_'
         | <qvar>
         | <qcon> <apat>*
         | <literal>
         | '-' <number>
         | '(' <pat> ')'
         | '[' <pat> (',' <pat>)* ']'
         | <qcon> '{' (<qname> '=' <pat> | '.') (',' (<qname> '=' <pat> | '.'))* '}'
         | '~' <apat>
         | '!' <apat> ;
<literal> ::= <number> | <string> | <char> ;
<var> ::= <identifier> ;
<conid> ::= <identifier> ;
<qvar> ::= <identifier> ('.' <identifier>)* ;
<qcon> ::= <identifier> ('.' <identifier>)* ;
<type_var> ::= <identifier> ;

/* --- Lexer core: single-terminal token rules only (engine #129/#133) --- */

<whitespace> ::= /[ \t\r\n]+/ => { skip }

/* Haskell line comment: '--' to end of line (greedy longest match lets this
   win over <symop> whenever anything follows on the line). */
<line_comment> ::= /--[^\n]*/ => { skip }

/* Haskell block comment {- ... -} (non-nested; pragmas {-# ... #-} match
   this rule too and are skipped). */
<block_comment> ::= /\x7B-([^-]|-+[^-}])*-+\x7D/ => { skip }

<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_']*/
<symop> ::= /[:!#$%&*+.\x2F<=>?@^|~-]+/
<backslash> ::= /\\/

<number> ::= /0[xX][0-9a-fA-F]+/
<number> ::= /0[oO][0-7]+/
<number> ::= /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?/
<number> ::= /[0-9]+[eE][+-]?[0-9]+/
<number> ::= /[0-9]+/

<string> ::= /"([^"\\\n]|\\.)*"/
<char0> ::= /'[^'\n]'/
<char1> ::= /'\x5C.'/
<char2> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<char3> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
<char> ::= <char0> | <char1> | <char2> | <char3>

<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= "`"
<lx_p9> ::= '"'
<lx_p10> ::= "'"
