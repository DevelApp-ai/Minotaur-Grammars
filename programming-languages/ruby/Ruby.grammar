Grammar: Ruby
FormatType: EBNF
TokenSplitter: Space

program     ::= stmt* ;
stmt        ::= assignment | if_stmt | def | class_def | module_def | expr | while_stmt ;
assignment  ::= identifier '=' expr ;
if_stmt     ::= 'if' expr stmt* ('elsif' expr stmt*)* ('else' stmt*)? 'end' ;
while_stmt  ::= 'while' expr stmt* 'end' ;
def         ::= 'def' method_name '(' params? ')' stmt* 'end' ;
method_name ::= identifier | operator ;
params      ::= param (',' param)* ;
param       ::= identifier (':' identifier)? ;
class_def   ::= 'class' const_id ('<' const_id)? stmt* 'end' ;
module_def  ::= 'module' const_id stmt* 'end' ;
expr        ::= literal | var | call | expr binop expr | '(' expr ')' ;
call        ::= (receiver '.')? method_name ('(' args? ')')? block? ;
receiver    ::= var | const_id ;
block       ::= '{' '|' params? '|' stmt* '}' ;
args        ::= expr (',' expr)* ;
literal     ::= number | text | symbol | array | hash | boolean | 'nil' ;
array       ::= '[' args? ']' ;
hash        ::= '{' hash_pair (',' hash_pair)* '}' ;
hash_pair   ::= (symbol|text) '=>' expr ;
symbol      ::= ':' identifier ;
operator    ::= '+' | '-' | '*' | '/' | '==' | '<' | '>' | '<=' | '>=' ;
binop       ::= operator ;
var         ::= identifier | instance_var | class_var | global_var ;
instance_var ::= '@' identifier ;
class_var   ::= '@@' identifier ;
global_var  ::= '$' identifier ;
const_id    ::= [A-Z][a-zA-Z0-9_]* ;
identifier  ::= [a-zA-Z_][a-zA-Z0-9_]*[?!]? ;
boolean     ::= 'true' | 'false' ;
text        ::= '"' [^"]* '"' ;
number      ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
begin_rescue ::= 'begin' stmt* ('rescue' const_id? '=>' identifier? stmt*)* ('else' stmt*)? ('ensure' stmt*)? 'end' ; ;
unless_stmt ::= 'unless' expr stmt* ('else' stmt*)? 'end' ; ;
case_stmt ::= 'case' expr? ('when' args stmt*)+ ('else' stmt*)? 'end' ; ;
do_block ::= 'do' '|' params? '|' stmt* 'end' ; ;
class_self ::= 'class' '<<' 'self' stmt* 'end' ; ;
module_function ::= 'module_function' ; ;
attr_accessor ::= ('attr_accessor' | 'attr_reader' | 'attr_writer') symbol (symbol)* ; ;
range_lit ::= expr ('..' | '...') expr ; ;
safe_nav ::= expr '&.' method_name ; ;
ternary ::= expr '?' expr ':' expr ; ;
interp ::= '#{' expr '}' ; ;
require_stmt ::= ('require' | 'require_relative') text ; ;
