Grammar: Ruby
FormatType: EBNF

<program> ::= <stmt>* ;
<stmt> ::= <comment> | <assignment> | <if_stmt> | <def> | <class_def> | <module_def> | <expr> | <while_stmt> ;
<assignment> ::= <identifier> '=' <expr> ;
<if_stmt> ::= 'if' <expr> <stmt>* ('elsif' <expr> <stmt>*)* ('else' <stmt>*)? 'end' ;
<while_stmt> ::= 'while' <expr> <stmt>* 'end' ;
<def> ::= 'def' <method_name> '(' <params>? ')' <stmt>* 'end' ;
<method_name> ::= <identifier> | <operator> ;
<params> ::= <param> (',' <param>)* ;
<param> ::= <identifier> (':' <identifier>)? ;
<class_def> ::= 'class' <const_id> ('<' <const_id>)? <stmt>* 'end' ;
<module_def> ::= 'module' <const_id> <stmt>* 'end' ;
<expr> ::= <literal> | <var> | <call> | <expr> <binop> <expr> | '(' <expr> ')' ;
<call> ::= (<receiver> '.')? <method_name> ('(' <args>? ')')? <block>? ;
<receiver> ::= <var> | <const_id> ;
<block> ::= '{' ' | ' <params>? ' | ' <stmt>* '}' ;
<args> ::= <expr> (',' <expr>)* ;
<literal> ::= <number> | <text> | <symbol> | <array> | <hash> | <boolean> | 'nil' ;
<array> ::= '[' <args>? ']' ;
<hash> ::= '{' <hash_pair> (',' <hash_pair>)* '}' ;
<hash_pair> ::= (<symbol> | <text>) '=>' <expr> ;
<symbol> ::= ':' <identifier> ;
<operator> ::= '+' | '-' | '*' | '/' | '==' | '<' | '>' | '<=' | '>=' ;
<binop> ::= <operator> ;
<var> ::= <identifier> | <instance_var> | <class_var> | <global_var> ;
<instance_var> ::= '@' <identifier> ;
<class_var> ::= '@@' <identifier> ;
<global_var> ::= '$' <identifier> ;
<const_id> ::= /[A-Z][a-zA-Z0-9_]*/ ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*[?!]?/ ;
<boolean> ::= 'true' | 'false' ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Ruby 2.3+: # comments, :symbols, %w/%i sigils, ?a chars, @ivars $gvars, -> => .. ... */
<whitespace> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<psigil> ::= /%[qQwWiIrs]\{[^}]*\}/
<psigil> ::= /%[qQwWiIrs]\[[^\]]*\]/
<psigil> ::= /%[qQwWiIrs]\([^)]*\)/
<psigil> ::= /%[qQwWiIrs]<[^>]*>/
<psigil> ::= /%[qQwWiIrs]\x2F([^\x2F\\]|\\.)*\x2F/
<symbol> ::= /::/
<symbol> ::= /\x3A\x22([^\x22\\]|\\.)*\x22/
<symbol> ::= /:[a-zA-Z_][a-zA-Z0-9_]*[!?=]?/
<symbol> ::= /:[+\-*<>=!&|^~.\x2F%]+/
<char> ::= /\?\\./
<char> ::= /\?[^\s\\]/
<gvar> ::= /[$@]{1,2}[a-zA-Z_][a-zA-Z0-9_]*/
<gvar> ::= /[$@]{1,2}/
<number> ::= /0[xX][0-9a-fA-F_]+/
<number> ::= /0[bB][01_]+/
<number> ::= /0[oO]?[0-7_]+/
<number> ::= /[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9]+)?[ri]?/
<number> ::= /\.[0-9][0-9_]*([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*[!?=]?/
<lx_op0> ::= "=>"
<lx_op1> ::= "->"
<lx_op2> ::= "=="
<lx_op3> ::= "==="
<lx_op4> ::= "!="
<lx_op5> ::= "=~"
<lx_op6> ::= "!~"
<lx_op7> ::= "<=>"
<lx_op8> ::= ".."
<lx_op9> ::= "..."
<lx_op10> ::= "<<"
<lx_op11> ::= ">>"
<lx_op12> ::= "**"
<lx_op13> ::= "&&"
<lx_op14> ::= "||"
<lx_op15> ::= "+="
<lx_op16> ::= "-="
<lx_op17> ::= "*="
<lx_op18> ::= "/="
<lx_op19> ::= "%="
<lx_op20> ::= "&="
<lx_op21> ::= "|="
<lx_op22> ::= "^="
<lx_op23> ::= "<<="
<lx_op24> ::= ">>="
<lx_op25> ::= "**="
<op_single> ::= /[-+*\x2F%&|^~<>=!?:@:.]/
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= '"'
<lx_p9> ::= "'"
<lx_p10> ::= "`"
