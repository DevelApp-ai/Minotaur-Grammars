Grammar: Perl001
FormatType: EBNF

<program> ::= (<use_stmt> | <stmt>)* ;
<use_stmt> ::= 'use' (<strict> | <warnings> | <qualified_id>) ';' ;
<strict> ::= 'strict' ;
<warnings> ::= 'warnings' ;
<stmt> ::= <comment> | <assignment> | <my_decl> | <sub_def> | <if_stmt> | <while_stmt> | <foreach_stmt> | <expr_stmt> ;
<assignment> ::= <lvalue> '=' <expr> ';' ;
<lvalue> ::= <scalar_var> | <array_var> | <hash_var> ;
<my_decl> ::= 'my' <lvalue> ('=' <expr>)? ';' ;
<sub_def> ::= 'sub' <identifier> '{' <stmt>* '}' ;
<if_stmt> ::= 'if' '(' <expr> ')' <block> ('elsif' '(' <expr> ')' <block>)* ('else' <block>)? ;
<while_stmt> ::= 'while' '(' <expr> ')' <block> ;
<foreach_stmt> ::= 'foreach' 'my'? <scalar_var> '(' <expr> ')' <block> ;
<block> ::= '{' <stmt>* '}' ;
<expr_stmt> ::= <expr> ';' ;
<expr> ::= <literal> | <var> | <call> | <expr> <binop> <expr> | '(' <expr> ')' ;
<call> ::= ( '&'? <identifier> | <qualified_id> ) '(' <args>? ')' ;
<args> ::= <expr> (',' <expr>)* ;
<var> ::= <scalar_var> | <array_var> | <hash_var> ;
<scalar_var> ::= '$' <identifier> ;
<array_var> ::= '@' <identifier> ;
<hash_var> ::= '%' <identifier> ;
<literal> ::= <number> | <text> | <list> ;
<list> ::= '(' <args>? ')' ;
<binop> ::= '+' | '-' | '*' | '/' | '.' | '==' | 'eq' | 'ne' | '<' | '>' | '&&' | '||' ;
<qualified_id> ::= <identifier> ('::' <identifier>)* ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/ ;
<text> ::= /'"'[^"]*'"'/ ;
<number> ::= /[0-9]+/ ;

# --- Coverage completion: remaining language constructs ---
<ternary_expression> ::= expression "?" expression ":" expression ;
<postfix_modifier> ::= statement ( "if" | "unless" | "while" | "until" | "for" | "foreach" ) expression ;
<list_slice> ::= array_name "[" expression_list "]" ;
<hash_slice> ::= hash_name "{" expression_list "}" ;
<regex_binding> ::= expression ( "=~" | "!~" ) ( regex_literal | <match_operator> | substitution | transliteration ) ;
<match_operator> ::= "m" delimiter regex_body delimiter <auto_match_operator_0> ;
<sub_signature> ::= "sub" <identifier> "(" sig_parameter_list ")" <block> ;
<auto_match_operator_0> ::= /[ regex_flags ]/ ;

/* Comments (issue #189) */
<hash-comment> ::= /#[^\n]*/
<comment> ::= <hash-comment>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   identifier, number, string/char literals, punctuation and comments as token
   rules. String/char/block-comment patterns are the proven CSharp10 ones. */
<lx_ws> ::= /[ \t\r\n]+/ => { skip }
<lx_backslash> ::= /\\/
<lx_identifier> ::= /[A-Za-z_][A-Za-z0-9_]*/
<lx_number> ::= /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
<lx_string> ::= /"([^"\\\n]|\\.)*"/
<lx_char0> ::= /'[^'\n]'/
<lx_char1> ::= /'\x5C.'/
<lx_char2> ::= /'\x5Cu[0-9a-fA-F]{4}'/
<lx_char3> ::= /'\x5Cx[0-9a-fA-F]{1,4}'/
<lx_block_comment0> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<lx_p0> ::= "("
<lx_p1> ::= ")"
<lx_p2> ::= "{"
<lx_p3> ::= "}"
<lx_p4> ::= "["
<lx_p5> ::= "]"
<lx_p6> ::= ";"
<lx_p7> ::= ","
<lx_p8> ::= "."
<lx_p9> ::= "?"
<lx_p10> ::= ":"
<lx_p11> ::= "!"
<lx_p12> ::= "+"
<lx_p13> ::= "-"
<lx_p14> ::= "*"
<lx_p15> ::= "/"
<lx_p16> ::= "%"
<lx_p17> ::= "="
<lx_p18> ::= "<"
<lx_p19> ::= ">"
<lx_p20> ::= "&"
<lx_p21> ::= "|"
<lx_p22> ::= "^"
<lx_p23> ::= "~"
<lx_p24> ::= "@"
<lx_p25> ::= "`"
<lx_p26> ::= '"'
<lx_p27> ::= "'"
<lx_p28> ::= "=>"
<lx_p29> ::= "->"
<lx_p30> ::= "=="
<lx_p31> ::= "!="
<lx_p32> ::= "<="
<lx_p33> ::= ">="
<lx_p34> ::= "&&"
<lx_p35> ::= "||"
<lx_p36> ::= "++"
<lx_p37> ::= "--"
<lx_p38> ::= "+="
<lx_p39> ::= "-="
<lx_p40> ::= "*="
<lx_p41> ::= "/="
<lx_p42> ::= "%="
<lx_p43> ::= "&="
<lx_p44> ::= "|="
<lx_p45> ::= "^="
<lx_p46> ::= "<<"
<lx_p47> ::= ">>"
<lx_p48> ::= "::"
<lx_p49> ::= ".."
<lx_p50> ::= "..."
<lx_p51> ::= "**"
<lx_p52> ::= "??"
<lx_p53> ::= "?."
<lx_p54> ::= "<>"
<lx_hash_comment> ::= /#[^\n]*/ => { skip }
<lx_line_comment> ::= /\x2F\x2F[^\n]*/ => { skip }
