Grammar: Scheme
FormatType: EBNF

<program> ::= <form>*
<form> ::= <atom> | "(" <form>* ")" | "[" <form>* "]" | "'" <form> | "`" <form> | "," <form> | ",@" <form> | "#" <datum>
<atom> ::= <identifier> | <number> | <string> | <boolean>
<boolean> ::= "#t" | "#f"
<datum> ::= <boolean> | <charlit> | <number>
<charlit> ::= "#\" <identifier>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Scheme R7RS: ws, ; and #| |# comments, strings with escapes, #\ chars, #t/#f, radix numbers, quote/quasiquote/unquote. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /;[^\n]*/ => { skip }
<comment> ::= /\#\|([^|]|\|[^#])*\|\#/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /#[xobd][0-9a-fA-F]+|[+-]?[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\x2F|,@|\(|\)|\[|\]|\.|->|\+|\*|<=|>=|\?|\\|'|`|,|#|-|<|>|=|!|:|"|'/
