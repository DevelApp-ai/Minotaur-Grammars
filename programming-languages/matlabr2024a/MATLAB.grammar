Grammar: MATLAB
FormatType: EBNF

<program> ::= <stmt>*
<stmt> ::= <assign> | <if> | <for> | <while> | <func-def> | <expr> ";"? | "..." <stmt>?
<assign> ::= <lvalue> "=" <expr> ";"?
<lvalue> ::= <identifier> ("." <identifier> | "(" <args> ")" | "{" <args> "}")*
<if> ::= "if" <expr> <stmt>* ("elseif" <expr> <stmt>)* ("else" <stmt>*)? "end"
<for> ::= "for" <identifier> "=" <expr> <stmt>* "end"
<while> ::= "while" <expr> <stmt>* "end"
<func-def> ::= "function" (<type> "=")? <identifier> "(" <params>? ")" <stmt>* "end"
<params> ::= <identifier> ("," <identifier>)*
<args> ::= <expr> ("," <expr>)*
<expr> ::= <or>
<or> ::= <and> ("||" <and>)*
<and> ::= <rel> ("&&" <rel>)*
<rel> ::= <add> (("==" | "~=" | "<" | "<=" | ">" | ">=") <add>)?
<add> ::= <mul> (("+" | "-") <mul>)*
<mul> ::= <unary> (<op> <unary>)*
<unary> ::= ("-" | "+" | "~")? <postfix>
<postfix> ::= <primary> ("'" | ".'" | "(" <args>? ")" | "[" <args> "]" | "." <identifier> | "{" <args> "}")*
<primary> ::= <identifier> | <number> | <string> | "(" <expr> ")" | "[" <args>? "]"

<type> ::= <identifier> ("." <identifier>)*

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   MATLAB R2024a: ws, % comments (and %{ %} block), single/double-quoted strings, numbers with i/j suffix, identifiers, operators incl ... and transpose. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /%[^\n]*/ => { skip }
<comment> ::= /\%\{([^%]|\%[^}])*\%\}/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[ijIJ]?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<string> ::= /'([^']|'')*'/
<op> ::= /\.\.\.|\.\x2F|\|\||\*\*|\.\*|\.\^|\x2F|\.'|==|~=|<=|>=|&&|\+|\*|\\|\^|\(|\)|\[|\]|\{|\}|\.|<|>|~|=|-|:|;|,|@|'/
