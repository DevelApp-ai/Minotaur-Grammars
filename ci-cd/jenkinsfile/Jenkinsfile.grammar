Grammar: Jenkinsfile
FormatType: EBNF
TokenSplitter: Space

pipeline    ::= 'pipeline' '{' agent stages post? environment? parameters? options? triggers? tools? '}' ;
agent        ::= 'agent' agent_body ;
agent_body   ::= 'none' | 'any' | '{' agent_label '}' ;
agent_label  ::= 'label' text ;
stages       ::= 'stages' '{' stage+ '}' ;
stage        ::= 'stage' text '{' stage_body '}' ;
stage_body   ::= stages | steps | parallel ;
parallel     ::= 'parallel' '{' branch+ '}' ;
branch       ::= identifier '{' steps '}' ;
steps        ::= 'steps' '{' step* '}' ;
step         ::= sh | echo_step | script_step | checkout | dir | withCredentials | generic_step ;
sh           ::= 'sh' text ';'? ;
echo_step    ::= 'echo' text ;
script_step  ::= 'script' '{' groovy_stmt* '}' ;
checkout     ::= 'checkout' 'scm' ;
dir          ::= 'dir' text '{' step* '}' ;
withCredentials ::= 'withCredentials' '{' step* '}' ;
generic_step ::= identifier (arg_list)? ';'? ;
arg_list     ::= '(' pair (',' pair)* ')' ;
post         ::= 'post' '{' post_cond* '}' ;
post_cond    ::= ('always' | 'success' | 'failure' | 'unstable' | 'changed') '{' step* '}' ;
environment  ::= 'environment' '{' env_pair* '}' ;
env_pair     ::= identifier '=' text ;
parameters   ::= 'parameters' '{' param_def* '}' ;
param_def    ::= 'string' '(' 'name' ':' text 'defaultValue' ':' text ')' ;
options      ::= 'options' '{' option_def* '}' ;
option_def   ::= 'timestamps' | 'skipStagesAfterUnstable' | generic_step ;
triggers     ::= 'triggers' '{' trigger_def* '}' ;
trigger_def  ::= 'cron' text | 'pollSCM' text ;
tools        ::= 'tools' '{' tool_pair* '}' ;
tool_pair    ::= identifier text ;
groovy_stmt  ::= text ;
identifier   ::= [a-zA-Z_][a-zA-Z0-9_]* ;
pair         ::= identifier ':' scalar ;
scalar       ::= text | number | boolean ;
boolean      ::= 'true' | 'false' ;
text         ::= '"' [^"]* '"' | '\'' [^\']* '\'' ;
number       ::= [0-9]+ ;

# --- Coverage completion: remaining language constructs ---
when_block ::= 'when' '{' when_cond+ '}' ; ;
when_cond ::= ('branch' | 'tag' | 'environment' identifier) text | 'expression' '{' groovy_stmt* '}' | 'allOf' '{' when_cond+ '}' | 'anyOf' '{' when_cond+ '}' | 'not' '{' when_cond '}' ; ;
docker_agent ::= 'docker' '{' 'image' text 'args' text? 'registryUrl' text? 'registryCredentialsId' text? 'label' text? '}' ; ;
kubernetes_agent ::= 'kubernetes' '{' groovy_stmt* '}' ; ;
library_stmt ::= '@Library' '(' text (',' text)* ')' identifier ; ;
library_step ::= 'library' identifier ; ;
stage_options ::= 'options' '{' option_def+ '}' ; ;
skip_default_checkout ::= 'skipDefaultCheckout' '(' ')' ; ;
ws_step ::= 'ws' text '{' step* '}' ; ;
with_env ::= 'withEnv' '(' '[' text (',' text)* ']' ')' '{' step* '}' ; ;
