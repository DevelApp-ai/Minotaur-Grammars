Grammar: LESS
FormatType: EBNF
TokenSplitter: Space

<stylesheet> ::= <statement>* ;
<statement> ::= <variable_decl> | <nested_rule> | <mixin_decl> | <mixin_call> | <import_stmt> | <property> | <comment> ;
<variable_decl> ::= '@' <identifier> ':' <value> ';' ;
<import_stmt> ::= '@import' <text> ';' ;
<mixin_decl> ::= <mixin_def> | <param_mixin> ;
<mixin_def> ::= '.' <identifier> '{' <statement>* '}' ;
<param_mixin> ::= '.' <identifier> '(' <params>? ')' '{' <statement>* '}' ;
<params> ::= <param>( ',' <param>)* ;
<param> ::= '@' <identifier>( ':' <value>)? | '...' ;
<mixin_call> ::= '.' <identifier>( '(' <args>? ')')? ';' ;
<args> ::= <value>( ',' <value>)* ;
<nested_rule> ::= <selector> '{' <statement>* '}' ;
<selector> ::= <selector_text> ;
<property> ::= <prop_name> ':' <value> ';' ;
<prop_name> ::= <identifier> ;
<value> ::= <term>( <term>)* ;
<term> ::= <number> | <text> | <color> | <identifier> | '@' <identifier> | <function_call> | <operation> ;
<operation> ::= '(' <value> ')' ;
<function_call> ::= <identifier> '(' <args>? ')' ;
<comment> ::= '/*' <auto_comment_1> '*/' | '//' <auto_comment_2> ;
<selector_text> ::= ( "." "#" "&" "a" "-" "zA" "-" "Z" ":" "\" <auto_selector_text_3> "\" "]" "=" "(), ">"+ "~"* "-" )? ;
<color> ::= '#' <auto_color_4> ;
<identifier> ::= <auto_identifier_5> <auto_identifier_6> ;
<text> ::= '"' <auto_text_7> '"' ;
<number> ::= <auto_number_8>( '.' <auto_number_8>)?( 'px' | 'em' | 'rem' | '%')? ;

# --- Coverage completion: remaining language constructs ---

<merge_syntax> ::= <property> "+"? ":" "value_list" ";" ;
<property_interpolation> ::= "@{" <identifier> "}" ;
<parent_selector> ::= "&" ( "combinator" "simple_selector" )? ;
<nested_media> ::= "@media" "media_query_list" "block" ;
<guarded_mixin> ::= "mixin_name" "(" "parameters" ")" "when" "guard_condition" ";" ;

<auto_comment_1> ::= /^**/ ;
<auto_comment_2> ::= /^\n*/ ;
<auto_selector_text_3> ::= // ;
<auto_color_4> ::= /0-9a-fA-F+/ ;
<auto_identifier_5> ::= /a-zA-Z-/ ;
<auto_identifier_6> ::= /a-zA-Z0-9-*/ ;
<auto_text_7> ::= /^"*/ ;
<auto_number_8> ::= /0-9+/ ;
