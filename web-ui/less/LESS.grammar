Grammar: LESS
FormatType: EBNF
TokenSplitter: Space

stylesheet ::= statement* ;
statement  ::= variable_decl | nested_rule | mixin_decl | mixin_call | import_stmt | property | comment ;
variable_decl ::= '@' identifier ':' value ';' ;
import_stmt ::= '@import' text ';' ;
mixin_decl ::= mixin_def | param_mixin ;
mixin_def ::= '.' identifier '{' statement* '}' ;
param_mixin ::= '.' identifier '(' params? ')' '{' statement* '}' ;
params    ::= param (',' param)* ;
param     ::= '@' identifier (':' value)? | '...' ;
mixin_call ::= '.' identifier ('(' args? ')')? ';' ;
args      ::= value (',' value)* ;
nested_rule ::= selector '{' statement* '}' ;
selector  ::= selector_text ;
property  ::= prop_name ':' value ';' ;
prop_name ::= identifier ;
value     ::= term (term)* ;
term      ::= number | text | color | identifier | '@' identifier | function_call | operation ;
operation ::= '(' value ')' ;
function_call ::= identifier '(' args? ')' ;
comment   ::= '/*' [^*]* '*/' | '//' [^\n]* ;
selector_text ::= [.#&a-zA-Z:\[\]=" (),>+~*-]+ ;
color     ::= '#' [0-9a-fA-F]+ ;
identifier ::= [a-zA-Z-][a-zA-Z0-9-]* ;
text      ::= '"' [^"]* '"' ;
number    ::= [0-9]+ ('.' [0-9]+)? ('px'|'em'|'rem'|'%')? ;

# --- Extended coverage: additional language constructs ---
extend_less ::= ':extend' '(' selector ')' ; ;
when_guard ::= '&' 'when' '(' condition ')' '{' statement* '}' ; ;
condition ::= term (('and' | 'or')? term)* ; ;
comparison ::= term ('=' | '>' | '<' | '>=' | '<=') term ; ;
default_guard ::= '(' 'default' ')' ; ;
namespace_block ::= '#' identifier '{' statement* '}' ; ;
import_options ::= '@import' '(' identifier ')' text ';' ; ;
escaped_value ::= '~' text ; ;
