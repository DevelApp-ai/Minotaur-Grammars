Grammar: HTML
FormatType: EBNF
TokenSplitter: Space

document ::= doctype? html_elem ;
doctype  ::= '<!DOCTYPE' 'html' '>' ;
html_elem ::= '<html' attrs? '>' content '<' '/html' '>' ;
content  ::= node* ;
node     ::= element | text | comment ;
element  ::= open_tag content? close_tag | void_tag ;
open_tag ::= '<' tag_name attrs? '>' ;
close_tag ::= '<' '/' tag_name '>' ;
void_tag ::= '<' tag_name attrs? '/'? '>' ;
tag_name ::= identifier ;
attrs    ::= attr (attr)* ;
attr     ::= attr_name ('=' attr_value)? ;
attr_name ::= identifier ;
attr_value ::= '"' [^"]* '"' | '\'' [^\']* '\'' ;
comment  ::= '<!--' [^-->]* '-->' ;
text     ::= [^<]+ ;
identifier ::= [a-zA-Z][a-zA-Z0-9-]* ;

# --- Coverage completion: remaining language constructs ---

custom_element ::= "<" custom_element_name attribute* ( "/>" | ">" content* "</" custom_element_name ">" ) ;
custom_element_name ::= identifier "-" identifier ( "-" identifier )* ;
svg_element ::= "<" svg_tag_name attribute* ( "/>" | ">" content* "</" svg_tag_name ">" ) ;
mathml_element ::= "<" mathml_tag_name attribute* ( "/>" | ">" content* "</" mathml_tag_name ">" ) ;
template_element ::= "<template" attribute* ">" content* "</template>" ;
hex_entity ::= "&#x" hex_digit+ ";" ;
