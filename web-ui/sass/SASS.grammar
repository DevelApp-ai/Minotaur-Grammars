Grammar: SASS
FormatType: EBNF
TokenSplitter: Space

stylesheet ::= statement* ;
statement  ::= variable_decl | nested_rule | mixin_decl | include | import_stmt | property | comment ;
variable_decl ::= '$' identifier ':' value ';' ;
import_stmt ::= '@import' text ';' ;
mixin_decl ::= '@mixin' identifier ('(' params? ')')? '{' statement* '}' ;
include   ::= '@include' identifier ('(' args? ')')? ';' ;
params    ::= '$' identifier (':' value)? (',' '$' identifier (':' value)?)* ;
args      ::= value (',' value)* ;
nested_rule ::= selector '{' statement* '}' ;
selector  ::= selector_text ;
property  ::= prop_name ':' value ';' ;
prop_name ::= identifier ;
value     ::= term (term)* ;
term      ::= number | text | color | identifier | '$' identifier | function_call | '!' flag ;
function_call ::= identifier '(' args? ')' ;
flag      ::= 'important' ;
comment   ::= '/*' [^*]* '*/' | '//' [^\n]* ;
selector_text ::= [.#&a-zA-Z:\[\]=" (),>+~*-]+ ;
color     ::= '#' [0-9a-fA-F]+ ;
identifier ::= [a-zA-Z-][a-zA-Z0-9-]* ;
text      ::= '"' [^"]* '"' ;
number    ::= [0-9]+ ('.' [0-9]+)? ('px'|'em'|'rem'|'%')? ;

# --- Extended coverage: additional language constructs ---
extend_stmt ::= '@extend' selector ';' ; ;
placeholder_sel ::= '%' identifier ; ;
control_if ::= '@if' condition '{' statement* '}' ('@else' 'if' condition '{' statement* '}')* ('@else' '{' statement* '}')? ; ;
control_for ::= '@for' '$' identifier 'from' number 'through' number '{' statement* '}' ; ;
control_each ::= '@each' '$' identifier (',' '$' identifier)? 'in' value '{' statement* '}' ; ;
control_while ::= '@while' condition '{' statement* '}' ; ;
use_stmt ::= '@use' text ('as' identifier)? ';' ; ;
forward_stmt ::= '@forward' text ';' ; ;
interpolation ::= '#{' value '}' ; ;
function_def ::= '@function' identifier '(' params? ')' '{' statement* '}' ; ;
return_stmt ::= '@return' value ';' ; ;

# --- Coverage completion: remaining language constructs ---

media_query ::= "@media" media_query_list block ;
media_feature ::= "(" feature_name ":" feature_value ")" ;
nested_media ::= media_query block media_query* ;
supports_query ::= "@supports" supports_condition block ;
supports_condition ::= supports_negation | supports_operation | "(" declaration ")" ;
default_flag ::= "!default" ;
global_flag ::= "!global" ;
