Grammar: SASS
FormatType: EBNF
TokenSplitter: Space

stylesheet ::= statement* ;
statement  ::= variable_decl | nested_rule | mixin_decl | include | import_stmt | property | comment ;
variable_decl ::= '$' identifier ':' value ';' ;
import_stmt ::= '@import' text ';' ;
mixin_decl ::= '@mixin' identifier ('(' params? ')')? '{' statement* '}' ;
include   ::= '@include' identifier ('(' args? ')')? ';' ;
params    ::= '$' identifier (':' value)? (',' '$' identifier (':' value)?)* ;
args      ::= value (',' value)* ;
nested_rule ::= selector '{' statement* '}' ;
selector  ::= selector_text ;
property  ::= prop_name ':' value ';' ;
prop_name ::= identifier ;
value     ::= term (term)* ;
term      ::= number | text | color | identifier | '$' identifier | function_call | '!' flag ;
function_call ::= identifier '(' args? ')' ;
flag      ::= 'important' ;
comment   ::= '/*' [^*]* '*/' | '//' [^\n]* ;
selector_text ::= [.#&a-zA-Z:\[\]=" (),>+~*-]+ ;
color     ::= '#' [0-9a-fA-F]+ ;
identifier ::= [a-zA-Z-][a-zA-Z0-9-]* ;
text      ::= '"' [^"]* '"' ;
number    ::= [0-9]+ ('.' [0-9]+)? ('px'|'em'|'rem'|'%')? ;
