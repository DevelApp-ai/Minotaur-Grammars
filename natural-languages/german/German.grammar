Grammar: German
TokenSplitter: Space
FormatType: CEBNF
ContextSensitive: true
SymbolTableSharing: hierarchical

/*
 * German Natural Language Grammar - Comprehensive Edition with Regional Dialects
 * 
 * This grammar provides extensive coverage of Standard German (Hochdeutsch) including:
 * - Regular and irregular verb conjugations (all tenses and moods)
 * - Case system (nominative, accusative, dative, genitive)
 * - Gender agreement (masculine, feminine, neuter)
 * - Number agreement (singular, plural)
 * - Strong, weak, and mixed declension patterns
 * - Modal verbs and auxiliaries
 * - Separable and inseparable prefix verbs
 * - V2 word order and verb bracket (Satzklammer)
 * - Subordinate clause structures with nesting
 * - Relative clauses with case marking
 * - Comparative and superlative forms
 * - Compound nouns (extensive productivity)
 * - Multiple tenses and moods
 * - Negation patterns
 * - Reflexive verbs
 * - Passive voice constructions
 * - Regional dialectal variations (Bavarian, Swabian, Saxon, Rhine-Franconian, Low German, Berlin)
 * - Multi-embedded sentences
 * - Discourse structures and markers
 * - Cleft sentences and focus constructions
 * - Tag questions and elliptical structures
 * - Reported speech
 */

Keywords: und, oder, aber, wenn, weil, dass, als, ob, wie, der, die, das, ein, eine, ich, du, er, sie, es, wir, ihr, sie, Sie, mein, dein, sein, ihr, unser, euer, dieser, diese, dieses, jener, welcher, nicht, kein, können, müssen, dürfen, sollen, wollen, mögen, haben, sein, werden, sich, zu, von, mit, nach, bei, in, an, auf, über, unter, vor, hinter, neben, zwischen, doch, halt, eben, mal, schon, noch, ja, nein, vielleicht, also, deshalb, daher, dennoch, trotzdem

/* Dialect markers for German regional varieties */
@DIALECT[bavarian]          /* Bayerisch (Bavaria and Austria) */
@DIALECT[swabian]           /* Schwäbisch (Baden-Württemberg) */
@DIALECT[saxon]             /* Sächsisch (Saxony) */
@DIALECT[rhine_franconian]  /* Rheinfränkisch
 (Rhineland-Palatinate, Hesse) */
@DIALECT[low_german]        /* Niederdeutsch/Plattdeutsch (Northern Germany) */
@DIALECT[berlin]            /* Berlinerisch (Berlin and Brandenburg) */

/* Top-level sentence structure with advanced constructions */
<sentence> ::= <main-clause>
            | <subordinate-clause>
            | <compound-sentence>
            | <complex-sentence>
            | <multi-embedded-sentence>
            | <coordinated-complex-sentence>
            | <cleft-sentence>

/* Main clause with V2 word order */
<main-clause> ::= <declarative-clause>
               | <interrogative-clause>
               | <imperative-clause>
               | <exclamative-clause>
               | <parenthetical-clause>

/* V2 declarative: TopicField + FiniteVerb + MiddleField + VerbComplement + FinalField */
<declarative-clause> ::= <topic-field> <opt-whitespace> <finite-verb> <opt-whitespace> <middle-field>? <opt-whitespace> <verb-complement>? <opt-whitespace> <final-field>? <punctuation>?

/* Topic field (first position) */
<topic-field> ::= <subject>
               | <adverbial>
               | <object>
               | <prepositional-phrase>

/* Middle field with dialectal particles */
<middle-field> ::= <middle-field-element> ( <opt-whitespace> <middle-field-element> )*

<middle-field-element> ::= <subject>
                        | <negation>
                        | <adverb>
                        | <modal-particle>
                        | <object>
                        | <indirect-object>
                        | <reflexive-pronoun>

/* Modal particles with dialectal variations */
<modal-particle> ::= <standard-modal-particle> | <dialect-modal-particle>

<standard-modal-particle> ::= "doch" | "halt" | "eben" | "mal" | "schon" | "noch" | "ja" | "denn" | "etwa" | "bloß" | "nur"

<dialect-modal-particle> ::= @DIALECT[bavarian] ( "halt" | "fei" | "gell" | "gel" | "hoid" )
                          | @DIALECT[swabian] ( "halt" | "gell" | "no" | "hald" )
 
                         | @DIALECT[saxon] ( "nu" | "halt" | "bloß" )
                          | @DIALECT[rhine_franconian] ( "awwer" | "gell" )
                          | @DIALECT[low_german] ( "man" | "blots" | "mal" )
                          | @DIALECT[berlin] ( "wa" | "ne" | "dit" | "det" )

/* Negation with dialectal variations */
<negation> ::= <standard-negation> | <dialect-negation>

<standard-negation> ::= "nicht" | "nie" | "niemals" | "nirgends" | "nirgendwo" | "niemand" | "nichts" | "kein" | "keine" | "keiner"

<dialect-negation> ::= @DIALECT[bavarian] ( "ned" | "net" | "nia" | "nix" | "koa" )
                    | @DIALECT[swabian] ( "net" | "ned" | "nia" | "nex" | "koi" )
                    | @DIALECT[saxon] ( "nich" | "nie" | "nischt" | "keen" )
                    | @DIALECT[rhine_franconian] ( "net" | "nit" | "nie" | "nix" )
                    | @DIALECT[low_german] ( "nich" | "nee" | "nix" | "keen" )
                    | @DIALECT[berlin] ( "nich" | "nüscht" | "keen" | "keene" )

/* Verb complement (separable prefix, infinitive, participle) */
<verb-complement> ::= <separable-prefix>
                   | <infinitive-phrase>
                   | <past-participle>
                   | <present-participle>
                   | <predicate-adjective>

<separable-prefix> ::= "ab" | "an" | "auf" | "aus" | "bei" | "ein" | "fest" | "her" | "hin" | "los" | "mit" | "nach" | "vor" | "weg" | "zu" | "zurück" | "zusammen" | "fort" | "weiter" | "raus" | "rein" | "runter" | "rauf" | "rüber"

<infinitive-phrase> ::= ( "zu" <opt-whitespace> )? <verb-infinitive> ( <opt-whitespace> <object> )?

<predicate-adjective> ::= <adjective>

/* Final field with nested structures */
<final-field> ::= <subordinate-clause>
               | <relative-clause>
               | <prepositional-phrase>
               | <infinitive-clause>
               | <embedded-clause-sequence>

/* Embedded clause sequence (multiple subordinate clauses) */
<embedded-clause-sequence> ::= <subord
inate-clause> ( <opt-whitespace> <coordinating-conjunction>? <opt-whitespace> <subordinate-clause> )+

/* Interrogative clause */
<interrogative-clause> ::= <yes-no-question>
                        | <wh-question>

<yes-no-question> ::= <finite-verb> <opt-whitespace> <subject> <opt-whitespace> <middle-field>? <opt-whitespace> <verb-complement>? <opt-whitespace> <final-field>? "?"

<wh-question> ::= <question-word> <opt-whitespace> <finite-verb> <opt-whitespace> <subject>? <opt-whitespace> <middle-field>? <opt-whitespace> <verb-complement>? <opt-whitespace> <final-field>? "?"

/* Imperative clause */
<imperative-clause> ::= <verb-imperative> <opt-whitespace> <middle-field>? <opt-whitespace> <object>? <opt-whitespace> <adverbial>? ( "!" | "." )?

/* Exclamative clause */
<exclamative-clause> ::= <exclamative-word> <opt-whitespace> <adjective>? <opt-whitespace> <noun-phrase>? <opt-whitespace> <finite-verb>? <opt-whitespace> <middle-field>? "!"

<exclamative-word> ::= "wie" | "was" <opt-whitespace> "für" | "welch" | "so"

/* Subordinate clause (verb-final word order) with nesting */
<subordinate-clause> ::= <simple-subordinate-clause>
                      | <nested-subordinate-clause>
                      | <coordinated-subordinate-clause>

<simple-subordinate-clause> ::= <subordinating-conjunction> <opt-whitespace> <subordinate-content>

<nested-subordinate-clause> ::= <subordinating-conjunction> <opt-whitespace> <nested-subordinate-content>

<nested-subordinate-content> ::= <subject> <opt-whitespace> <middle-field>? <opt-whitespace> <verb-phrase-subordinate> <opt-whitespace> <nested-final-field>

<nested-final-field> ::= <subordinate-clause>
                      | <relative-clause>
                      | <embedded-clause-sequence>
                      | <prepositional-phrase>

<coordinated-subordinate-clause> ::= <subordinate-clause> <opt-whitespace> <coordinating-conjunction> <opt-whitespace> <subordinate-clause>

<subordinate-content> ::= <subject> <opt-whites
pace> <middle-field>? <opt-whitespace> <verb-phrase-subordinate>

<verb-phrase-subordinate> ::= ( <auxiliary-verb> <opt-whitespace> )* <main-verb>

/* Relative clause with nesting */
<relative-clause> ::= <simple-relative-clause>
                   | <nested-relative-clause>

<simple-relative-clause> ::= <relative-pronoun> <opt-whitespace> <subject>? <opt-whitespace> <middle-field>? <opt-whitespace> <finite-verb> <opt-whitespace> <verb-complement>?

<nested-relative-clause> ::= <relative-pronoun> <opt-whitespace> <subject>? <opt-whitespace> <middle-field>? <opt-whitespace> <finite-verb> <opt-whitespace> <verb-complement>? <opt-whitespace> <subordinate-clause>

<relative-pronoun> ::= @CASE[nominative] ( "der" | "die" | "das" | "welcher" | "welche" | "welches" )
                    | @CASE[accusative] ( "den" | "die" | "das" | "welchen" | "welche" | "welches" )
                    | @CASE[dative] ( "dem" | "der" | "dem" | "welchem" | "welcher" | "welchem" )
                    | @CASE[genitive] ( "dessen" | "deren" | "dessen" | "wessen" )

/* Compound and complex sentences */
<compound-sentence> ::= <simple-compound-sentence>
                     | <multi-compound-sentence>

<simple-compound-sentence> ::= <main-clause> <opt-whitespace> <coordinating-conjunction> <opt-whitespace> <main-clause>

<multi-compound-sentence> ::= <main-clause> ( <opt-whitespace> <coordinating-conjunction> <opt-whitespace> <main-clause> ){2,}

<coordinating-conjunction> ::= "und" | "oder" | "aber" | "denn" | "sondern" | "doch" | "sowie" | "sowohl" <opt-whitespace> "als" <opt-whitespace> "auch"

<complex-sentence> ::= <simple-complex-sentence>
                    | <fronted-subordinate-sentence>
                    | <split-complex-sentence>

<simple-complex-sentence> ::= <main-clause> <opt-whitespace> <subordinate-clause>

<fronted-subordinate-sentence> ::= <subordinate-clause> <opt-whitespace> "," <opt-whitespace> <main-clause>

<split-complex-sentence> ::= <subordinate-clause> <opt-whitespa
ce> "," <opt-whitespace> <main-clause> <opt-whitespace> "," <opt-whitespace> <subordinate-clause>

/* Multi-embedded sentence (multiple levels of embedding) */
<multi-embedded-sentence> ::= <main-clause> <opt-whitespace> <subordinate-clause> ( <opt-whitespace> <subordinate-clause> )+
                           | <subordinate-clause> <opt-whitespace> "," <opt-whitespace> <main-clause> <opt-whitespace> <subordinate-clause>

/* Coordinated complex sentence */
<coordinated-complex-sentence> ::= <complex-sentence> <opt-whitespace> <coordinating-conjunction> <opt-whitespace> <complex-sentence>
                                | <main-clause> <opt-whitespace> <coordinated-subordinate-clause>

/* Parenthetical clause */
<parenthetical-clause> ::= <topic-field> <opt-whitespace> <finite-verb> <opt-whitespace> "," <opt-whitespace> <parenthetical-insertion> <opt-whitespace> "," <opt-whitespace> <middle-field>? <opt-whitespace> <verb-complement>? <punctuation>?

<parenthetical-insertion> ::= <subordinate-clause>
                           | <main-clause>
                           | <comment-phrase>

<comment-phrase> ::= <modal-particle> ( <opt-whitespace> <modal-particle> )*

<subordinating-conjunction> ::= "dass" | "ob" | "weil" | "wenn" | "als" | "während" | "bevor" | "nachdem" | "seit" | "bis" | "obwohl" | "damit" | "indem" | "sobald" | "falls" | "sofern" | "sodass" | "so" <opt-whitespace> "dass"

/* Infinitive clause */
<infinitive-clause> ::= "zu" <opt-whitespace> <verb-infinitive> ( <opt-whitespace> <object> )? ( <opt-whitespace> <adverbial> )?

/* Cleft sentences */
<cleft-sentence> ::= <es-cleft>
                  | <wh-cleft>

<es-cleft> ::= "es" <opt-whitespace> "ist" <opt-whitespace> <focused-constituent> <opt-whitespace> <relative-clause>

<wh-cleft> ::= <wh-clause> <opt-whitespace> "ist" <opt-whitespace> <focused-constituent>

<focused-constituent> ::= <noun-phrase>
                       | <prepositional-phrase>
                       | <adverb>

<wh-clause> ::= <i
nterrogative-clause-embedded>

/* Subject with case marking */
<subject> ::= @CASE[nominative] ( <pronoun-subject> | <noun-phrase> | <proper-noun> | <infinitive-as-subject> | <clause-as-subject> )

<infinitive-as-subject> ::= <verb-infinitive> ( <opt-whitespace> <object> )?

<clause-as-subject> ::= "dass" <opt-whitespace> <subordinate-content>

/* Pronouns with case and dialectal distinctions */
<pronoun-subject> ::= <personal-pronoun-nominative>
                   | <demonstrative-pronoun>
                   | <indefinite-pronoun>
                   | <interrogative-pronoun>

<personal-pronoun-nominative> ::= @CASE[nominative] ( <standard-nominative> | <dialect-nominative> )

<standard-nominative> ::= "ich" | "du" | "er" | "sie" | "es" | "wir" | "ihr" | "sie" | "Sie" | "man"

<dialect-nominative> ::= @DIALECT[bavarian] ( "i" | "du" | "ea" | "se" | "des" | "mia" | "enk" | "se" )
                      | @DIALECT[swabian] ( "i" | "du" | "er" | "se" | "es" | "mr" | "ihr" | "se" )
                      | @DIALECT[saxon] ( "sch" | "du" | "er" | "se" | "es" | "mir" | "ihr" | "se" )
                      | @DIALECT[rhine_franconian] ( "isch" | "du" | "er" | "se" | "es" | "mir" | "ihr" | "se" )
                      | @DIALECT[low_german] ( "ik" | "du" | "he" | "se" | "dat" | "wi" | "ji" | "se" )
                      | @DIALECT[berlin] ( "ick" | "du" | "er" | "se" | "det" | "wir" | "ihr" | "se" )

<personal-pronoun-accusative> ::= @CASE[accusative] ( <standard-accusative> | <dialect-accusative> )

<standard-accusative> ::= "mich" | "dich" | "ihn" | "sie" | "es" | "uns" | "euch" | "sie" | "Sie"

<dialect-accusative> ::= @DIALECT[bavarian] ( "mi" | "di" | "eam" | "se" | "des" | "uns" | "enk" | "se" )
                      | @DIALECT[swabian] ( "mi" | "di" | "ihn" | "se" | "es" | "ons" | "eich" | "se" )
                      | @DIALECT[saxon] ( "mich" | "disch" | "ihn" | "se" | "es" | "uns" | "eich" | "se" )
                      | @DIALECT[rhine_franconian] ( "misch" | "disc
h" | "ihn" | "se" | "es" | "uns" | "eisch" | "se" )
                      | @DIALECT[low_german] ( "mi" | "di" | "em" | "se" | "dat" | "uns" | "ju" | "se" )
                      | @DIALECT[berlin] ( "mir" | "dir" | "ihn" | "se" | "det" | "uns" | "euch" | "se" )

<personal-pronoun-dative> ::= @CASE[dative] ( <standard-dative> | <dialect-dative> )

<standard-dative> ::= "mir" | "dir" | "ihm" | "ihr" | "ihm" | "uns" | "euch" | "ihnen" | "Ihnen"

<dialect-dative> ::= @DIALECT[bavarian] ( "mia" | "dia" | "eam" | "ia" | "dem" | "uns" | "enk" | "eana" )
                  | @DIALECT[swabian] ( "mir" | "dir" | "em" | "r" | "em" | "ons" | "eich" | "ne" )
                  | @DIALECT[saxon] ( "mir" | "dir" | "em" | "r" | "em" | "uns" | "eich" | "ne" )
                  | @DIALECT[low_german] ( "mi" | "di" | "em" | "r" | "dat" | "uns" | "ju" | "em" )
                  | @DIALECT[berlin] ( "mir" | "dir" | "ihm" | "r" | "dem" | "uns" | "euch" | "ne" )

<personal-pronoun-genitive> ::= @CASE[genitive] ( "meiner" | "deiner" | "seiner" | "ihrer" | "seiner" | "unser" | "euer" | "ihrer" | "Ihrer" )

<reflexive-pronoun> ::= @REFLEXIVE "mich" | "dich" | "sich" | "uns" | "euch" | "sich"

<pronoun> ::= <personal-pronoun-nominative>
           | <personal-pronoun-accusative>
           | <personal-pronoun-dative>
           | <personal-pronoun-genitive>
           | <possessive-pronoun>
           | <demonstrative-pronoun>
           | <relative-pronoun>
           | <reflexive-pronoun>
           | <indefinite-pronoun>
           | <interrogative-pronoun>

<possessive-pronoun> ::= @GENDER[masculine] @CASE[nominative] ( "mein" | "dein" | "sein" | "ihr" | "unser" | "euer" | "ihr" | "Ihr" )
                      | @GENDER[feminine] @CASE[nominative] ( "meine" | "deine" | "seine" | "ihre" | "unsere" | "eure" | "ihre" | "Ihre" )
                      | @GENDER[neuter] @CASE[nominative] ( "mein" | "dein" | "sein" | "ihr" | "unser" | "euer" | "ihr" | "Ihr" )
                      | @NUMBER[plura
l] @CASE[nominative] ( "meine" | "deine" | "seine" | "ihre" | "unsere" | "eure" | "ihre" | "Ihre" )

<demonstrative-pronoun> ::= @GENDER[masculine] @CASE[nominative] ( "dieser" | "jener" | "der" )
                         | @GENDER[feminine] @CASE[nominative] ( "diese" | "jene" | "die" )
                         | @GENDER[neuter] @CASE[nominative] ( "dieses" | "jenes" | "das" )
                         | @NUMBER[plural] @CASE[nominative] ( "diese" | "jene" | "die" )

<indefinite-pronoun> ::= "man" | "jemand" | "niemand" | "etwas" | "nichts" | "alle" | "einige" | "manche" | "viele" | "wenige" | "andere" | "einer" | "eine" | "eines"

<interrogative-pronoun> ::= "wer" | "was" | "welcher" | "welche" | "welches"

/* Noun Phrase */
<noun-phrase> ::= <determiner>? <opt-whitespace> <adjective-phrase>* <opt-whitespace> <noun> <opt-whitespace> <genitive-modifier>? <opt-whitespace> <relative-clause>?

<determiner> ::= <article>
              | <demonstrative-determiner>
              | <possessive-determiner>

<article> ::= <definite-article> | <indefinite-article>

/* Definite articles */
<definite-article> ::= @GENDER[masculine] @CASE[nominative] "der"
                    | @GENDER[feminine] @CASE[nominative] "die"
                    | @GENDER[neuter] @CASE[nominative] "das"
                    | @NUMBER[plural] @CASE[nominative] "die"
                    | @GENDER[masculine] @CASE[accusative] "den"
                    | @GENDER[feminine] @CASE[accusative] "die"
                    | @GENDER[neuter] @CASE[accusative] "das"
                    | @NUMBER[plural] @CASE[accusative] "die"
                    | @GENDER[masculine] @CASE[dative] "dem"
                    | @GENDER[feminine] @CASE[dative] "der"
                    | @GENDER[neuter] @CASE[dative] "dem"
                    | @NUMBER[plural] @CASE[dative] "den"
                    | @GENDER[masculine] @CASE[genitive] "des"
                    | @GENDER[feminine] @CASE[genitive] "der"
                    | @GENDER[neute
r] @CASE[genitive] "des"
                    | @NUMBER[plural] @CASE[genitive] "der"

/* Indefinite articles */
<indefinite-article> ::= @GENDER[masculine] @CASE[nominative] "ein"
                      | @GENDER[feminine] @CASE[nominative] "eine"
                      | @GENDER[neuter] @CASE[nominative] "ein"
                      | @GENDER[masculine] @CASE[accusative] "einen"
                      | @GENDER[feminine] @CASE[accusative] "eine"
                      | @GENDER[neuter] @CASE[accusative] "ein"
                      | @GENDER[masculine] @CASE[dative] "einem"
                      | @GENDER[feminine] @CASE[dative] "einer"
                      | @GENDER[neuter] @CASE[dative] "einem"
                      | @GENDER[masculine] @CASE[genitive] "eines"
                      | @GENDER[feminine] @CASE[genitive] "einer"
                      | @GENDER[neuter] @CASE[genitive] "eines"

<demonstrative-determiner> ::= <demonstrative-pronoun>

<possessive-determiner> ::= <possessive-pronoun>

/* Nouns */
<noun> ::= <simple-noun>
        | <compound-noun>

<simple-noun> ::= @GENDER[masculine|feminine|neuter] @NUMBER[singular|plural] @CASE[nominative|accusative|dative|genitive] <noun-stem> <noun-suffix>?

<compound-noun> ::= <noun-stem> <opt-whitespace>? <noun>

<noun-stem> ::= /[A-ZÄÖÜ][a-zäöüß]*/

<noun-suffix> ::= "e" | "en" | "er" | "n" | "s" | "es" | "heit" | "keit" | "ung" | "schaft" | "tum" | "nis" | "chen" | "lein"

<genitive-modifier> ::= <noun-phrase>

<proper-noun> ::= /[A-ZÄÖÜ][a-zäöüß]*/
               | <multi-word-proper-noun>

<multi-word-proper-noun> ::= /[A-ZÄÖÜ][a-zäöüß]*/ ( <opt-whitespace> /[A-ZÄÖÜ][a-zäöüß]*/ )+

/* Adjective phrases */
<adjective-phrase> ::= <degree-modifier>? <opt-whitespace> <adjective>

<degree-modifier> ::= "sehr" | "ziemlich" | "recht" | "äußerst" | "extrem" | "wenig" | "zu" | "so" | "ganz" | "überaus" | "höchst" | "außerordentlich"

<adjective> ::= <adjective-positive>
             | <adjective-comparative>
             | <a
djective-superlative>

<adjective-positive> ::= <adjective-strong-decl>
                      | <adjective-weak-decl>
                      | <adjective-mixed-decl>
                      | <adjective-undeclined>

<adjective-strong-decl> ::= @DECLENSION[strong] <adjective-stem> <strong-ending>

<adjective-weak-decl> ::= @DECLENSION[weak] <adjective-stem> <weak-ending>

<adjective-mixed-decl> ::= @DECLENSION[mixed] <adjective-stem> <mixed-ending>

<adjective-undeclined> ::= <adjective-stem>

<strong-ending> ::= "er" | "e" | "es" | "en" | "em" | "er"

<weak-ending> ::= "e" | "en"

<mixed-ending> ::= "er" | "e" | "es" | "en"

<adjective-comparative> ::= @DEGREE[comparative] ( <regular-comparative> | <irregular-comparative> )

<regular-comparative> ::= <adjective-stem> "er"

<irregular-comparative> ::= "besser" | "größer" | "höher" | "näher" | "mehr" | "lieber" | "eher"

<adjective-superlative> ::= @DEGREE[superlative] ( <regular-superlative> | <irregular-superlative> )

<regular-superlative> ::= <adjective-stem> "st" ( "e" | "en" | "er" | "es" )?
                       | "am" <opt-whitespace> <adjective-stem> "sten"

<irregular-superlative> ::= "best" ( "e" | "en" | "er" | "es" )? | "größt" ( "e" | "en" | "er" | "es" )? | "höchst" ( "e" | "en" | "er" | "es" )? | "nächst" ( "e" | "en" | "er" | "es" )? | "meist" ( "e" | "en" | "er" | "es" )? | "liebst" ( "e" | "en" | "er" | "es" )? | "ehest" ( "e" | "en" | "er" | "es" )?

<adjective-stem> ::= /[a-zäöüß]+/

/* Predicate and verb phrases */
<predicate> ::= <verb-phrase>

<verb-phrase> ::= <simple-verb-phrase>
               | <compound-verb-phrase>
               | <modal-verb-phrase>
               | <passive-verb-phrase>

<simple-verb-phrase> ::= <finite-verb> ( <opt-whitespace> <adverb> )?

<finite-verb> ::= <verb-present>
               | <verb-past>

<compound-verb-phrase> ::= <auxiliary-verb> <opt-whitespace> <adverb>? <opt-whitespace> <verb-complement>

<modal-verb-phrase> ::= <modal-verb> <opt-whitespace> <adverb>? 
<opt-whitespace> <infinitive-phrase>

<passive-verb-phrase> ::= @VOICE[passive] <werden-verb> <opt-whitespace> <past-participle>

/* Auxiliary verbs */
<auxiliary-verb> ::= <modal-verb>
                  | <haben-verb>
                  | <sein-verb>
                  | <werden-verb>

<modal-verb> ::= <modal-present> | <modal-past>

<modal-present> ::= @MOOD[modal] ( "kann" | "kannst" | "können" | "könnt" | "will" | "willst" | "wollen" | "wollt" | "muss" | "musst" | "müssen" | "müsst" | "darf" | "darfst" | "dürfen" | "dürft" | "soll" | "sollst" | "sollen" | "sollt" | "mag" | "magst" | "mögen" | "mögt" | "möchte" | "möchtest" | "möchten" | "möchtet" )

<modal-past> ::= @MOOD[modal] @TENSE[past] ( "konnte" | "konntest" | "konnten" | "konntet" | "wollte" | "wolltest" | "wollten" | "wolltet" | "musste" | "musstest" | "mussten" | "musstet" | "durfte" | "durftest" | "durften" | "durftet" | "sollte" | "solltest" | "sollten" | "solltet" | "mochte" | "mochtest" | "mochten" | "mochtet" )

/* Main verb tenses */
<main-verb> ::= <verb-present>
             | <verb-past>
             | <verb-perfect>
             | <verb-pluperfect>
             | <verb-future>
             | <verb-conditional>
             | <verb-infinitive>

<verb-infinitive> ::= ( "zu" <opt-whitespace> )? <verb-stem> ( "en" | "n" )

<verb-present> ::= @TENSE[present] ( <regular-verb-present> | <irregular-verb-present> )

<regular-verb-present> ::= <verb-stem> ( "e" | "st" | "t" | "en" | "t" )

<verb-stem> ::= /[a-zäöüß]+/

<irregular-verb-present> ::= @IRREGULAR "bin" | "bist" | "ist" | "sind" | "seid" | "habe" | "hast" | "hat" | "haben" | "habt" | "werde" | "wirst" | "wird" | "werden" | "werdet" | "gehe" | "gehst" | "geht" | "gehen" | "komme" | "kommst" | "kommt" | "kommen" | "nehme" | "nimmst" | "nimmt" | "nehmen" | "nehmt" | "gebe" | "gibst" | "gibt" | "geben" | "gebt" | "sehe" | "siehst" | "sieht" | "sehen" | "seht" | "esse" | "isst" | "isst" | "essen" | "esst" | "fahre" | "fährst" | "fährt" | "fahren" |
 "fahrt" | "lese" | "liest" | "liest" | "lesen" | "lest" | "spreche" | "sprichst" | "spricht" | "sprechen" | "sprecht" | "laufe" | "läufst" | "läuft" | "laufen" | "lauft" | "schlafe" | "schläfst" | "schläft" | "schlafen" | "schlaft"

<verb-past> ::= @TENSE[past] ( <regular-verb-past> | <irregular-verb-past> )

<regular-verb-past> ::= <verb-stem> ( "te" | "test" | "te" | "ten" | "tet" )

<irregular-verb-past> ::= @IRREGULAR "war" | "warst" | "war" | "waren" | "wart" | "hatte" | "hattest" | "hatte" | "hatten" | "hattet" | "wurde" | "wurdest" | "wurde" | "wurden" | "wurdet" | "ging" | "gingst" | "ging" | "gingen" | "gingt" | "kam" | "kamst" | "kam" | "kamen" | "kamt" | "nahm" | "nahmst" | "nahm" | "nahmen" | "nahmt" | "gab" | "gabst" | "gab" | "gaben" | "gabt" | "sah" | "sahst" | "sah" | "sahen" | "saht" | "aß" | "aßt" | "aß" | "aßen" | "aßt" | "fuhr" | "fuhrst" | "fuhr" | "fuhren" | "fuhrt" | "las" | "last" | "las" | "lasen" | "last" | "sprach" | "sprachst" | "sprach" | "sprachen" | "spracht" | "lief" | "liefst" | "lief" | "liefen" | "lieft" | "schlief" | "schliefst" | "schlief" | "schliefen" | "schlieft"

<verb-perfect> ::= @TENSE[perfect] <perfect-auxiliary> <opt-whitespace> <past-participle>

<perfect-auxiliary> ::= "habe" | "hast" | "hat" | "haben" | "habt" | "bin" | "bist" | "ist" | "sind" | "seid"

<verb-pluperfect> ::= @TENSE[pluperfect] <pluperfect-auxiliary> <opt-whitespace> <past-participle>

<pluperfect-auxiliary> ::= "hatte" | "hattest" | "hatte" | "hatten" | "hattet" | "war" | "warst" | "war" | "waren" | "wart"

<verb-future> ::= @TENSE[future] <future-auxiliary> <opt-whitespace> <verb-infinitive>

<future-auxiliary> ::= "werde" | "wirst" | "wird" | "werden" | "werdet"

<verb-conditional> ::= @MOOD[conditional] "würde" <opt-whitespace> <verb-infinitive>
                    | @MOOD[conditional] <subjunctive-auxiliary> <opt-whitespace> <past-participle>

<subjunctive-auxiliary> ::= "hätte" | "hättest" | "hätte" | "hätten" | "hättet" | "wäre" | "wärst" | "wä
re" | "wären" | "wärt"

<past-participle> ::= <regular-past-participle> | <irregular-past-participle>

<regular-past-participle> ::= "ge" <verb-stem> ( "t" | "et" )

<present-participle> ::= <verb-stem> "end"

<irregular-past-participle> ::= @IRREGULAR "gewesen" | "gehabt" | "geworden" | "gegangen" | "gekommen" | "genommen" | "gegeben" | "gesehen" | "gegessen" | "gefahren" | "gelesen" | "geschrieben" | "gesprochen" | "getrunken" | "gefunden" | "gedacht" | "gebracht" | "gewusst" | "getan" | "gelassen" | "gehalten" | "gestanden" | "verstanden" | "begonnen" | "gewonnen" | "gesungen" | "getragen" | "geschlafen" | "gerufen" | "gelaufen"

<haben-verb> ::= "habe" | "hast" | "hat" | "haben" | "habt" | "hatte" | "hattest" | "hatte" | "hatten" | "hattet"

<sein-verb> ::= "bin" | "bist" | "ist" | "sind" | "seid" | "war" | "warst" | "war" | "waren" | "wart"

<werden-verb> ::= "werde" | "wirst" | "wird" | "werden" | "werdet" | "wurde" | "wurdest" | "wurde" | "wurden" | "wurdet"

<verb-imperative> ::= <verb-stem> ( "e" | "" ) | <irregular-imperative>

<irregular-imperative> ::= "sei" | "seid" | "seien" | "hab" | "habt" | "haben" | "werde" | "werdet" | "werden"

/* Objects */
<object> ::= <direct-object>

<direct-object> ::= @CASE[accusative] ( <noun-phrase> | <pronoun-object> | <clause-object> | <infinitive-phrase> )

<indirect-object> ::= @CASE[dative] ( <noun-phrase> | <pronoun-object> )

<pronoun-object> ::= <personal-pronoun-accusative>
                  | <personal-pronoun-dative>
                  | <demonstrative-pronoun>
                  | <reflexive-pronoun>

/* Clause as object */
<clause-object> ::= <that-clause>
                 | <wh-clause>
                 | <if-whether-clause>
                 | <infinitival-clause>

<that-clause> ::= "dass" <opt-whitespace> <subordinate-content>

<wh-clause> ::= <interrogative-clause-embedded>

<if-whether-clause> ::= "ob" <opt-whitespace> <subordinate-content>

<infinitival-clause> ::= "zu" <opt-whitespace> <verb-infinitive> ( 
<opt-whitespace> <object> )? ( <opt-whitespace> <adverbial> )?

<interrogative-clause-embedded> ::= <question-word> <opt-whitespace> <subordinate-content>

/* Adverbials with dialectal variations */
<adverbial> ::= <adverb>
             | <adverb-phrase>
             | <prepositional-phrase>

<adverb-phrase> ::= <degree-adverb-modifier>? <opt-whitespace> <adverb>

<degree-adverb-modifier> ::= "sehr" | "ziemlich" | "recht" | "ganz"

<adverb> ::= <time-adverb>
          | <place-adverb>
          | <manner-adverb>
          | <degree-adverb>

<time-adverb> ::= <standard-time-adverb> | <dialect-time-adverb>

<standard-time-adverb> ::= "jetzt" | "nun" | "heute" | "gestern" | "morgen" | "bald" | "immer" | "nie" | "oft" | "manchmal" | "schon" | "noch" | "gleich" | "vorher" | "nachher" | "früher" | "später" | "damals" | "neulich" | "sofort" | "gerade" | "eben"

<dialect-time-adverb> ::= @DIALECT[bavarian] ( "iatza" | "heit" | "gestan" | "moang" )
                       | @DIALECT[swabian] ( "jetzt" | "heid" | "geschder" | "morge" )
                       | @DIALECT[saxon] ( "nu" | "heide" | "geschdern" | "morschn" )
                       | @DIALECT[low_german] ( "nu" | "vundaag" | "gistern" | "morgen" )
                       | @DIALECT[berlin] ( "jetzt" | "heite" | "jestern" | "morjen" )

<place-adverb> ::= <standard-place-adverb> | <dialect-place-adverb>

<standard-place-adverb> ::= "hier" | "dort" | "da" | "überall" | "nirgends" | "irgendwo" | "oben" | "unten" | "vorne" | "hinten" | "links" | "rechts" | "draußen" | "drinnen" | "weg" | "fort"

<dialect-place-adverb> ::= @DIALECT[bavarian] ( "do" | "duat" | "oben" | "untn" )
                        | @DIALECT[swabian] ( "do" | "dert" | "obe" | "onte" )
                        | @DIALECT[saxon] ( "hier" | "da" | "oben" | "unten" )
                        | @DIALECT[low_german] ( "hier" | "dar" | "baven" | "nerrn" )
                        | @DIALECT[berlin] ( "hier" | "da" | "oben" | "unten" )

<manner-adverb> ::= "gut" |
 "schlecht" | "schnell" | "langsam" | "gern" | "gerne" | "so" | "anders" | "zusammen" | "allein" | "einfach" | "schwer" | "leicht"

<degree-adverb> ::= "sehr" | "zu" | "ganz" | "ziemlich" | "recht" | "etwas" | "wenig" | "kaum" | "fast" | "etwa"

/* Prepositional phrases */
<prepositional-phrase> ::= <preposition> <opt-whitespace> <noun-phrase>

<preposition> ::= <accusative-preposition>
               | <dative-preposition>
               | <genitive-preposition>
               | <two-way-preposition>

<accusative-preposition> ::= @CASE[accusative] ( "durch" | "für" | "gegen" | "ohne" | "um" | "bis" | "entlang" )

<dative-preposition> ::= @CASE[dative] ( "aus" | "bei" | "mit" | "nach" | "seit" | "von" | "zu" | "gegenüber" | "außer" )

<genitive-preposition> ::= @CASE[genitive] ( "während" | "wegen" | "trotz" | "statt" | "anstatt" | "außerhalb" | "innerhalb" | "oberhalb" | "unterhalb" | "infolge" | "angesichts" )

<two-way-preposition> ::= @CASE[accusative|dative] ( "an" | "auf" | "hinter" | "in" | "neben" | "über" | "unter" | "vor" | "zwischen" )

/* Question words */
<question-word> ::= <interrogative-pronoun>
                 | <interrogative-adverb>

<interrogative-adverb> ::= "wo" | "wohin" | "woher" | "wann" | "warum" | "wie" | "wieso" | "weshalb" | "weswegen"

/* Discourse markers and connectives */
<discourse-marker> ::= <temporal-discourse>
                    | <causal-discourse>
                    | <contrastive-discourse>
                    | <additive-discourse>
                    | <conclusive-discourse>

<temporal-discourse> ::= "zuerst" | "dann" | "danach" | "schließlich" | "zuletzt" | "endlich" | "gleichzeitig" | "inzwischen"

<causal-discourse> ::= "deshalb" | "daher" | "darum" | "folglich" | "infolgedessen" | "demzufolge"

<contrastive-discourse> ::= "dagegen" | "hingegen" | "im" <opt-whitespace> "Gegenteil" | "andererseits" | "dennoch" | "trotzdem" | "allerdings" | "jedoch"

<additive-discourse> ::= "außerdem" | "ferner" | "weiterhin" | "zudem"
 | "überdies" | "darüber" <opt-whitespace> "hinaus" | "ebenso" | "ebenfalls"

<conclusive-discourse> ::= "also" | "kurz" <opt-whitespace> "gesagt" | "mit" <opt-whitespace> "anderen" <opt-whitespace> "Worten" | "zusammenfassend"

/* Tag questions */
<tag-question> ::= <declarative-clause> <opt-whitespace> "," <opt-whitespace> <question-tag> "?"

<question-tag> ::= "nicht" <opt-whitespace> "wahr"
                | "oder"
                | "nicht"
                | "gell"
                | "ne"
                | "wa"

/* Elliptical structures */
<elliptical-clause> ::= <elliptical-response>
                     | <elliptical-coordination>

<elliptical-response> ::= <modal-particle>
                       | <verb-phrase>
                       | 

