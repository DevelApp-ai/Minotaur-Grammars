Grammar: Ancient_Greek
TokenSplitter: Space
FormatType: CEBNF
ContextSensitive: true
SymbolTableSharing: hierarchical

/*
 * Ancient Greek (Ἀρχαία Ἑλληνική) Natural Language Grammar - Comprehensive Edition
 * 
 * This grammar provides extensive coverage of Classical/Attic Greek (5th-4th century BCE) including:
 * - Complete verb system (all tenses, moods, voices)
 * - Full noun declension system (5 cases: nominative, genitive, dative, accusative, vocative)
 * - Three genders (masculine, feminine, neuter)
 * - Three numbers (singular, dual, plural)
 * - Context-sensitive agreement rules (gender, number, case)
 * - Regular expression support for morphological patterns
 * - All three declensions for nouns
 * - Complete adjective declension
 * - Eight parts of speech
 * - Multiple tenses (present, imperfect, future, aorist, perfect, pluperfect, future perfect)
 * - Four moods (indicative, subjunctive, optative, imperative)
 * - Three voices (active, middle, passive)
 * - Participles and infinitives
 * - Complex subordinate clause structures
 */

Keywords: καί, ἤ, δέ, ἀλλά, εἰ, ἐάν, ὅτι, ἵνα, ὅπως, ὡς, ὅς, ἥ, ὅ, οὗτος, αὕτη, τοῦτο, ὁ, ἡ, τό, ἐγώ, σύ, ἡμεῖς, ὑμεῖς, οὐ, οὐκ, οὐχ, μή, ἐν, εἰς, ἐκ, ἀπό, διά, κατά, μετά, παρά, περί, πρός, σύν, ὑπέρ, ὑπό

/* Dialect markers for Ancient Greek linguistic variations */
@DIALECT[attic]       /* Attic - Athens and Attica (classical standard) */
@DIALECT[ionic]       /* Ionic - Herodotus, Homer */
@DIALECT[doric]       /* Doric - Sparta, Sicily */
@DIALECT[aeolic]      /* Aeolic - Lesbos, Sappho */

/* Top-level sentence structure */
<sentence> ::= <main-clause>
            | <subordinate-clause>
            | <compound-sentence>
            | <complex-sentence>

/* Main clause */
<main-clause> ::= <declarative-clause>
               | <interrogative-clause>
               | <imperative-clause>

/* Declarative clause with flexible word order */
<declarative-clause> ::= <subject>? <opt-whitespace> <verb-phrase> <opt-whitespace> <obje
ct>? <opt-whitespace> <adverbial>* <opt-whitespace> <punctuation>?

/* Interrogative clause */
<interrogative-clause> ::= <interrogative-particle>? <opt-whitespace> <declarative-clause> ";"
                        | <interrogative-pronoun> <opt-whitespace> <verb-phrase> <opt-whitespace> <subject>? ";"

<interrogative-particle> ::= "ἆρα" | "ἆρ'" | "ἦ" | "πότερον"

<interrogative-pronoun> ::= "τίς" | "τί" | "ποῦ" | "πότε" | "πῶς" | "πόθεν" | "ποῖος"

/* Imperative clause */
<imperative-clause> ::= <verb-imperative> <opt-whitespace> <object>? <opt-whitespace> <adverbial>? ( "." | "!" )?

/* Subordinate clause */
<subordinate-clause> ::= <subordinating-conjunction> <opt-whitespace> <declarative-clause>

<subordinating-conjunction> ::= "ὅτι" | "ὡς" | "εἰ" | "ἐάν" | "ἵνα" | "ὅπως" | "ἐπεί" | "ἐπειδή" | "ὅτε" | "ἕως" | "πρίν"

/* Compound sentence */
<compound-sentence> ::= <main-clause> <opt-whitespace> <coordinating-conjunction> <opt-whitespace> <main-clause>

<coordinating-conjunction> ::= "καί" | "δέ" | "ἀλλά" | "ἤ" | "οὐδέ" | "μηδέ" | "τε" <opt-whitespace> "καί"

/* Complex sentence */
<complex-sentence> ::= <main-clause> <opt-whitespace> <subordinate-clause>
                    | <subordinate-clause> <opt-whitespace> <main-clause>

/* Subject with case marking */
<subject> ::= <noun-phrase> @CASE[nominative]
           | <pronoun-nominative>
           | <proper-noun> @CASE[nominative]

/* Noun Phrase with gender and case agreement */
<noun-phrase> ::= <article>? <opt-whitespace> <adjective>* <opt-whitespace> <noun> <opt-whitespace> <genitive-modifier>?

/* Article with full declension (masculine, feminine, neuter) */
<article> ::= <article-masculine> | <article-feminine> | <article-neuter>

/* Masculine article declension */
<article-masculine> ::= @GENDER[masculine] @NUMBER[singular] @CASE[nominative] "ὁ"
                     | @GENDER[masculine] @NUMBER[singular] @CASE[genitive] "τοῦ"
                     | @GENDER[masculine] @NUMBER[singular] @CASE[dative] "τῷ"
 
                    | @GENDER[masculine] @NUMBER[singular] @CASE[accusative] "τόν"
                     | @GENDER[masculine] @NUMBER[dual] @CASE[nominative] "τώ"
                     | @GENDER[masculine] @NUMBER[dual] @CASE[genitive] "τοῖν"
                     | @GENDER[masculine] @NUMBER[dual] @CASE[dative] "τοῖν"
                     | @GENDER[masculine] @NUMBER[dual] @CASE[accusative] "τώ"
                     | @GENDER[masculine] @NUMBER[plural] @CASE[nominative] "οἱ"
                     | @GENDER[masculine] @NUMBER[plural] @CASE[genitive] "τῶν"
                     | @GENDER[masculine] @NUMBER[plural] @CASE[dative] "τοῖς"
                     | @GENDER[masculine] @NUMBER[plural] @CASE[accusative] "τούς"

/* Feminine article declension */
<article-feminine> ::= @GENDER[feminine] @NUMBER[singular] @CASE[nominative] "ἡ"
                    | @GENDER[feminine] @NUMBER[singular] @CASE[genitive] "τῆς"
                    | @GENDER[feminine] @NUMBER[singular] @CASE[dative] "τῇ"
                    | @GENDER[feminine] @NUMBER[singular] @CASE[accusative] "τήν"
                    | @GENDER[feminine] @NUMBER[dual] @CASE[nominative] "τώ"
                    | @GENDER[feminine] @NUMBER[dual] @CASE[genitive] "τοῖν"
                    | @GENDER[feminine] @NUMBER[dual] @CASE[dative] "τοῖν"
                    | @GENDER[feminine] @NUMBER[dual] @CASE[accusative] "τώ"
                    | @GENDER[feminine] @NUMBER[plural] @CASE[nominative] "αἱ"
                    | @GENDER[feminine] @NUMBER[plural] @CASE[genitive] "τῶν"
                    | @GENDER[feminine] @NUMBER[plural] @CASE[dative] "ταῖς"
                    | @GENDER[feminine] @NUMBER[plural] @CASE[accusative] "τάς"

/* Neuter article declension */
<article-neuter> ::= @GENDER[neuter] @NUMBER[singular] @CASE[nominative] "τό"
                  | @GENDER[neuter] @NUMBER[singular] @CASE[genitive] "τοῦ"
                  | @GENDER[neuter] @NUMBER[singular] @CASE[dative] "τῷ"
                  | @GENDER[neuter] @NUMBER[s
ingular] @CASE[accusative] "τό"
                  | @GENDER[neuter] @NUMBER[dual] @CASE[nominative] "τώ"
                  | @GENDER[neuter] @NUMBER[dual] @CASE[genitive] "τοῖν"
                  | @GENDER[neuter] @NUMBER[dual] @CASE[dative] "τοῖν"
                  | @GENDER[neuter] @NUMBER[dual] @CASE[accusative] "τώ"
                  | @GENDER[neuter] @NUMBER[plural] @CASE[nominative] "τά"
                  | @GENDER[neuter] @NUMBER[plural] @CASE[genitive] "τῶν"
                  | @GENDER[neuter] @NUMBER[plural] @CASE[dative] "τοῖς"
                  | @GENDER[neuter] @NUMBER[plural] @CASE[accusative] "τά"

/* Nouns with three declensions */
<noun> ::= <noun-first-declension>
        | <noun-second-declension>
        | <noun-third-declension>

/* First declension (mostly feminine, some masculine) */
<noun-first-declension> ::= @DECLENSION[first] ( <noun-first-fem> | <noun-first-masc> )

<noun-first-fem> ::= @GENDER[feminine] @NUMBER[singular] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+η/
                  | @GENDER[feminine] @NUMBER[singular] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ᾱ/
                  | @GENDER[feminine] @NUMBER[singular] @CASE[genitive] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ης/
                  | @GENDER[feminine] @NUMBER[singular] @CASE[dative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ῃ/
                  | @GENDER[feminine] @NUMBER[singular] @CASE[accusative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ην/
                  | @GENDER[feminine] @NUMBER[singular] @CASE[vocative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+η/
                  | @GENDER[feminine] @NUMBER[plural] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αι/
                  | @GENDER[feminine] @NUMBER[plural] @CASE[genitive] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ῶν/
                  | @GENDER[feminine] @NUMBER[plural] @CASE[dative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αις/
                  | @GENDER[feminine] @NUMBER[plural] @CASE[accusative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ᾱς/

<noun-first-masc> ::= @GENDER[masculine] @NUMBER[singular] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ης/
                   | @GENDER[masculine] @NUMBER[singular] @CASE[genitive] /[α-ωά
-ώἀ-ὤᾀ-ᾤ]+ου/
                   | @GENDER[masculine] @NUMBER[singular] @CASE[dative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ῃ/
                   | @GENDER[masculine] @NUMBER[singular] @CASE[accusative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ην/
                   | @GENDER[masculine] @NUMBER[singular] @CASE[vocative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ᾱ/

/* Second declension (mostly masculine and neuter) */
<noun-second-declension> ::= @DECLENSION[second] ( <noun-second-masc> | <noun-second-neut> )

<noun-second-masc> ::= @GENDER[masculine] @NUMBER[singular] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ος/
                    | @GENDER[masculine] @NUMBER[singular] @CASE[genitive] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ου/
                    | @GENDER[masculine] @NUMBER[singular] @CASE[dative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ῳ/
                    | @GENDER[masculine] @NUMBER[singular] @CASE[accusative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/
                    | @GENDER[masculine] @NUMBER[singular] @CASE[vocative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ε/
                    | @GENDER[masculine] @NUMBER[plural] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οι/
                    | @GENDER[masculine] @NUMBER[plural] @CASE[genitive] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ων/
                    | @GENDER[masculine] @NUMBER[plural] @CASE[dative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οις/
                    | @GENDER[masculine] @NUMBER[plural] @CASE[accusative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ους/

<noun-second-neut> ::= @GENDER[neuter] @NUMBER[singular] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/
                    | @GENDER[neuter] @NUMBER[singular] @CASE[genitive] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ου/
                    | @GENDER[neuter] @NUMBER[singular] @CASE[dative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ῳ/
                    | @GENDER[neuter] @NUMBER[singular] @CASE[accusative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/
                    | @GENDER[neuter] @NUMBER[plural] @CASE[nominative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+α/
                    | @GENDER[neuter] @NUMBER[plural] @CASE[genitive] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ων/
                    | @GENDER[neuter] @NUMBER[plural] @CASE[dative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οις/
                    | @GENDER[neuter] @NUMBER[plural] @CASE[accu
sative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+α/

/* Third declension (all genders, various stem types) */
<noun-third-declension> ::= @DECLENSION[third] @GENDER[masculine|feminine|neuter] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+/

<proper-noun> ::= /[Ἀ-Ὤᾈ-ᾬ][α-ωά-ώἀ-ὤᾀ-ᾤ]*/

/* Genitive modifier */
<genitive-modifier> ::= <noun-phrase> @CASE[genitive]

/* Adjectives with three declension patterns */
<adjective> ::= <adjective-positive>
             | <adjective-comparative>
             | <adjective-superlative>

/* Positive degree with gender/case agreement */
<adjective-positive> ::= @DEGREE[positive] ( <adjective-first-second> | <adjective-third> )

<adjective-first-second> ::= @GENDER[masculine] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ος/
                          | @GENDER[feminine] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+η/
                          | @GENDER[neuter] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/

<adjective-third> ::= @GENDER[masculine|feminine] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ης/
                   | @GENDER[neuter] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ες/

/* Comparative degree */
<adjective-comparative> ::= @DEGREE[comparative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+τερος/

/* Superlative degree */
<adjective-superlative> ::= @DEGREE[superlative] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+τατος/

/* Pronouns */
<pronoun-nominative> ::= @CASE[nominative] ( <personal-pronoun-nom> | <demonstrative-pronoun> | <relative-pronoun> )

<personal-pronoun-nom> ::= @PERSON[1] @NUMBER[singular] "ἐγώ"
                        | @PERSON[2] @NUMBER[singular] "σύ"
                        | @PERSON[1] @NUMBER[dual] "νώ"
                        | @PERSON[2] @NUMBER[dual] "σφώ"
                        | @PERSON[1] @NUMBER[plural] "ἡμεῖς"
                        | @PERSON[2] @NUMBER[plural] "ὑμεῖς"

<personal-pronoun-gen> ::= @CASE[genitive] ( "ἐμοῦ" | "μου" | "σοῦ" | "σου" | "ἡμῶν" | "ὑμῶν" )

<personal-pronoun-dat> ::= @CASE[dative] ( "ἐμοί" | "μοι" | "σοί" | "σοι" | "ἡμῖν" | "ὑμῖν" )

<personal-pronoun-acc> ::= @CASE[accusative] ( "ἐμέ" | "με" | "σέ" | "σε" | "ἡμᾶς" | "ὑμᾶς" )

<demonstrative-pronoun> ::= "οὗτος" | "αὕτη" | "τοῦτο" | "ἐκεῖνος" | "ἐκείνη" | "ἐκε
ῖνο" | "ὅδε" | "ἥδε" | "τόδε"

<relative-pronoun> ::= "ὅς" | "ἥ" | "ὅ" | "οὗ" | "ᾧ" | "ὅν" | "ἥν"

/* Verb phrases with comprehensive tense/mood/voice system */
<verb-phrase> ::= <negation>? <opt-whitespace> <verb>

<negation> ::= "οὐ" | "οὐκ" | "οὐχ" | "μή"

/* Verbs with full conjugation system */
<verb> ::= <verb-present>
        | <verb-imperfect>
        | <verb-future>
        | <verb-aorist>
        | <verb-perfect>
        | <verb-pluperfect>
        | <verb-subjunctive>
        | <verb-optative>
        | <verb-imperative>
        | <verb-infinitive>
        | <verb-participle>

/* Present tense - all voices */
<verb-present> ::= @TENSE[present] ( <verb-present-active> | <verb-present-middle> | <verb-present-passive> )

<verb-present-active> ::= @VOICE[active] @MOOD[indicative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ω/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+εις/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ει/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ομεν/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ετε/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ουσι/ )

<verb-present-middle> ::= @VOICE[middle] @MOOD[indicative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ομαι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ῃ/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+εται/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ομεθα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+εσθε/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ονται/ )

<verb-present-passive> ::= @VOICE[passive] @MOOD[indicative] <verb-present-middle>

/* Imperfect tense */
<verb-imperfect> ::= @TENSE[imperfect] @MOOD[indicative] ( /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/ | /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+ομην/ )

/* Future tense */
<verb-future> ::= @TENSE[future] @MOOD[indicative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+σω/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+σομαι/ )

/* Aorist tense */
<verb-aorist> ::= @TENSE[aorist] @MOOD[indicative] ( <aorist-active> | <aorist-middle> | <aorist-passive> )

<aorist-active> ::= @VOICE[active] ( /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+σα/ | /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/ )

<aorist-middle> ::= @VOICE[middle] /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+σάμην/

<aorist-passive> ::= @VOICE[passive] /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+θην/

/* Perfect tense */
<verb-perfect> ::= @TENSE[perfect] @MOOD[indicative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+κα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+μαι/ )

/* Pluperfect tense */
<verb-pluperfect> ::= @TENSE[pluperfect] @MOOD[
indicative] ( /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+κειν/ | /ἐ[α-ωά-ώἀ-ὤᾀ-ᾤ]+μην/ )

/* Subjunctive mood */
<verb-subjunctive> ::= @MOOD[subjunctive] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ω/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ωμαι/ )

/* Optative mood */
<verb-optative> ::= @MOOD[optative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιμι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οίμην/ )

/* Imperative mood */
<verb-imperative> ::= @MOOD[imperative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ε/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ου/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+τε/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+σθε/ )

/* Infinitive */
<verb-infinitive> ::= @MOOD[infinitive] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ειν/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+εσθαι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+σαι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+θῆναι/ )

/* Participle */
<verb-participle> ::= @MOOD[participle] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ων/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ουσα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+όμενος/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+σας/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+θείς/ )

/* Object */
<object> ::= <noun-phrase> @CASE[accusative]
          | <personal-pronoun-acc>

/* Adverbials */
<adverbial> ::= <adverb>
             | <prepositional-phrase>

<adverb> ::= /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ως/ | "νῦν" | "τότε" | "πάλαι" | "ἔτι" | "ἤδη" | "αὖθις" | "ἐνθάδε" | "ἐκεῖ" | "ποῦ" | "καλῶς" | "κακῶς" | "εὖ" | "σφόδρα" | "μάλα" | "πάνυ"

/* Prepositional phrases */
<prepositional-phrase> ::= <preposition> <opt-whitespace> <noun-phrase>

<preposition> ::= "ἐν" @CASE[dative]
               | "εἰς" @CASE[accusative]
               | "ἐκ" @CASE[genitive]
               | "ἀπό" @CASE[genitive]
               | "διά" @CASE[genitive|accusative]
               | "κατά" @CASE[genitive|accusative]
               | "μετά" @CASE[genitive|accusative]
               | "παρά" @CASE[genitive|dative|accusative]
               | "περί" @CASE[genitive|accusative]
               | "πρός" @CASE[genitive|dative|accusative]
               | "σύν" @CASE[dative]
               | "ὑπέρ" @CASE[genitive|accusative]
               | "ὑπό" @CASE[genitive|dative|accusative]

/* Punctuation */
<punctuation> ::= "." | ";" | "," | "·"

/* Whitespace */
<whitespace> ::= /[ \t\n\r]+/

<opt-whitespace> ::= /[ \t\n\r]
*/

/* Context-sensitive agreement rules */

@CONTEXT_RULE[article-noun-agreement]:
    IF <article>.@GENDER == <noun>.@GENDER AND <article>.@NUMBER == <noun>.@NUMBER AND <article>.@CASE == <noun>.@CASE
    THEN VALID
    ELSE ERROR "Article must agree with noun in gender, number, and case"

@CONTEXT_RULE[adjective-noun-agreement]:
    IF <adjective>.@GENDER == <noun>.@GENDER AND <adjective>.@NUMBER == <noun>.@NUMBER AND <adjective>.@CASE == <noun>.@CASE
    THEN VALID
    ELSE ERROR "Adjective must agree with noun in gender, number, and case"

@CONTEXT_RULE[preposition-case]:
    IF <preposition> GOVERNS <noun-phrase>.@CASE
    THEN VALID
    ELSE ERROR "Preposition must govern the correct case"

/* Example sentences demonstrating Ancient Greek grammar:
 *
 * BASIC SENTENCES:
 * - "ὁ ἄνθρωπος γράφει" (The man writes)
 * - "ἡ γυνὴ λέγει" (The woman speaks)
 * - "τὸ παιδίον τρέχει" (The child runs)
 *
 * VERB CONJUGATIONS (λύω - to loose):
 * - Present: λύω, λύεις, λύει, λύομεν, λύετε, λύουσι
 * - Imperfect: ἔλυον, ἔλυες, ἔλυε, ἐλύομεν, ἐλύετε, ἔλυον
 * - Future: λύσω, λύσεις, λύσει, λύσομεν, λύσετε, λύσουσι
 * - Aorist: ἔλυσα, ἔλυσας, ἔλυσε, ἐλύσαμεν, ἐλύσατε, ἔλυσαν
 * - Perfect: λέλυκα, λέλυκας, λέλυκε, λελύκαμεν, λελύκατε, λελύκασι
 *
 * CASES:
 * - Nominative: ὁ ἀνήρ (the man - subject)
 * - Genitive: τοῦ ἀνδρός (of the man)
 * - Dative: τῷ ἀνδρί (to/for the man)
 * - Accusative: τὸν ἄνδρα (the man - object)
 * - Vocative: ὦ ἄνερ (O man!)
 *
 * SUBORDINATE CLAUSES:
 * - "λέγω ὅτι γράφει" (I say that he writes)
 * - "εἰ ἔρχεται, ὁρῶ αὐτόν" (If he comes, I see him)
 * - "γράφω ἵνα μάθῃς" (I write in order that you may learn)
 */

/* ============================================================================ */
/* COMPREHENSIVE VERB SYSTEM - Irregular Verbs with Full Conjugations          */
/* ============================================================================ */

/* Verb: ε��μί (to be) - most irregular verb in Ancient Greek */
<verb-eimi> ::= <verb-eimi
-present> | <verb-eimi-imperfect> | <verb-eimi-future> | <verb-eimi-subjunctive> | <verb-eimi-optative> | <verb-eimi-imperative>

<verb-eimi-present> ::= @TENSE[present] @MOOD[indicative] @IRREGULAR ( "εἰμί" | "εἶ" | "ἐστί" | "ἐσμέν" | "ἐστέ" | "εἰσί" )

<verb-eimi-imperfect> ::= @TENSE[imperfect] @MOOD[indicative] @IRREGULAR ( "ἦν" | "ἦσθα" | "ἦν" | "ἦμεν" | "ἦτε" | "ἦσαν" )

<verb-eimi-future> ::= @TENSE[future] @MOOD[indicative] @IRREGULAR ( "ἔσομαι" | "ἔσῃ" | "ἔσται" | "ἐσόμεθα" | "ἔσεσθε" | "ἔσονται" )

<verb-eimi-subjunctive> ::= @MOOD[subjunctive] @IRREGULAR ( "ὦ" | "ᾖς" | "ᾖ" | "ὦμεν" | "ἦτε" | "ὦσι" )

<verb-eimi-optative> ::= @MOOD[optative] @IRREGULAR ( "εἴην" | "εἴης" | "εἴη" | "εἴημεν" | "εἴητε" | "εἴησαν" )

<verb-eimi-imperative> ::= @MOOD[imperative] @IRREGULAR ( "ἴσθι" | "ἔστω" | "ἔστε" | "ἔστων" )

/* Verb: φημί (to say) - highly irregular */
<verb-phemi> ::= <verb-phemi-present> | <verb-phemi-imperfect>

<verb-phemi-present> ::= @TENSE[present] @MOOD[indicative] @IRREGULAR ( "φημί" | "φῄς" | "φησί" | "φαμέν" | "φατέ" | "φασί" )

<verb-phemi-imperfect> ::= @TENSE[imperfect] @MOOD[indicative] @IRREGULAR ( "ἔφην" | "ἔφησθα" | "ἔφη" | "ἔφαμεν" | "ἔφατε" | "ἔφασαν" )

/* Verb: οἶδα (to know) - perfect with present meaning */
<verb-oida> ::= <verb-oida-perfect> | <verb-oida-pluperfect> | <verb-oida-future>

<verb-oida-perfect> ::= @TENSE[perfect] @MOOD[indicative] @IRREGULAR ( "οἶδα" | "οἶσθα" | "οἶδε" | "ἴσμεν" | "ἴστε" | "ἴσασι" )

<verb-oida-pluperfect> ::= @TENSE[pluperfect] @MOOD[indicative] @IRREGULAR ( "ᾔδειν" | "ᾔδεισθα" | "ᾔδει" | "ᾔδειμεν" | "ᾔδειτε" | "ᾔδεισαν" )

<verb-oida-future> ::= @TENSE[future] @MOOD[indicative] @IRREGULAR ( "εἴσομαι" | "εἴσῃ" | "εἴσεται" | "εἰσόμεθα" | "εἴσεσθε" | "εἴσονται" )

/* Verb: εἰμί (to go) - highly irregular, distinct from "to be" */
<verb-eimi-go> ::= <verb-eimi-go-present> | <verb-eimi-go-imperfect> | <verb-eimi-go-future>

<verb-eimi-go-present> ::= @TENSE[present] @MOOD[indicative] @IRREGULAR ( "εἶμι" | 
"εἶ" | "εἶσι" | "ἴμεν" | "ἴτε" | "ἴασι" )

<verb-eimi-go-imperfect> ::= @TENSE[imperfect] @MOOD[indicative] @IRREGULAR ( "ᾖα" | "ᾔεισθα" | "ᾔει" | "ᾖμεν" | "ᾖτε" | "ᾖσαν" )

/* Verb: ἔρχομαι (to come/go) - middle voice */
<verb-erchomai> ::= <verb-erchomai-present> | <verb-erchomai-imperfect> | <verb-erchomai-future> | <verb-erchomai-aorist>

<verb-erchomai-present> ::= @TENSE[present] @VOICE[middle] @IRREGULAR ( "ἔρχομαι" | "ἔρχῃ" | "ἔρχεται" | "ἐρχόμεθα" | "ἔρχεσθε" | "ἔρχονται" )

<verb-erchomai-imperfect> ::= @TENSE[imperfect] @VOICE[middle] @IRREGULAR ( "ἠρχόμην" | "ἤρχου" | "ἤρχετο" | "ἠρχόμεθα" | "ἤρχεσθε" | "ἤρχοντο" )

<verb-erchomai-future> ::= @TENSE[future] @IRREGULAR ( "ἐλεύσομαι" | "ἐλεύσῃ" | "ἐλεύσεται" | "ἐλευσόμεθα" | "ἐλεύσεσθε" | "ἐλεύσονται" )

<verb-erchomai-aorist> ::= @TENSE[aorist] @IRREGULAR ( "ἦλθον" | "ἦλθες" | "ἦλθε" | "ἤλθομεν" | "ἤλθετε" | "ἦλθον" )

/* Verb: φέρω (to bear/carry) - important irregular */
<verb-phero> ::= <verb-phero-present> | <verb-phero-future> | <verb-phero-aorist>

<verb-phero-present> ::= @TENSE[present] @VOICE[active] @IRREGULAR ( "φέρω" | "φέρεις" | "φέρει" | "φέρομεν" | "φέρετε" | "φέρουσι" )

<verb-phero-future> ::= @TENSE[future] @IRREGULAR ( "οἴσω" | "οἴσεις" | "οἴσει" | "οἴσομεν" | "οἴσετε" | "οἴσουσι" )

<verb-phero-aorist> ::= @TENSE[aorist] @IRREGULAR ( "ἤνεγκον" | "ἤνεγκες" | "ἤνεγκε" | "ἠνέγκομεν" | "ἠνέγκετε" | "ἤνεγκον" )

/* Verb: λέγω (to say) - very common */
<verb-lego> ::= <verb-lego-present> | <verb-lego-future> | <verb-lego-aorist>

<verb-lego-present> ::= @TENSE[present] @VOICE[active] ( "λέγω" | "λέγεις" | "λέγει" | "λέγομεν" | "λέγετε" | "λέγουσι" )

<verb-lego-future> ::= @TENSE[future] @IRREGULAR ( "ἐρῶ" | "ἐρεῖς" | "ἐρεῖ" | "ἐροῦμεν" | "ἐρεῖτε" | "ἐροῦσι" )

<verb-lego-aorist> ::= @TENSE[aorist] @IRREGULAR ( "εἶπον" | "εἶπες" | "εἶπε" | "εἴπομεν" | "εἴπετε" | "εἶπον" )

/* Verb: ὁράω (to see) - contract verb, irregular */
<verb-horao> ::= <verb-horao-present> | <verb-horao-future> | <verb
-horao-aorist>

<verb-horao-present> ::= @TENSE[present] @VOICE[active] ( "ὁρῶ" | "ὁρᾷς" | "ὁρᾷ" | "ὁρῶμεν" | "ὁρᾶτε" | "ὁρῶσι" )

<verb-horao-future> ::= @TENSE[future] @IRREGULAR ( "ὄψομαι" | "ὄψῃ" | "ὄψεται" | "ὀψόμεθα" | "ὄψεσθε" | "ὄψονται" )

<verb-horao-aorist> ::= @TENSE[aorist] @IRREGULAR ( "εἶδον" | "εἶδες" | "εἶδε" | "εἴδομεν" | "εἴδετε" | "εἶδον" )

/* Verb: γίγνομαι (to become) - middle/passive */
<verb-gignomai> ::= <verb-gignomai-present> | <verb-gignomai-future> | <verb-gignomai-aorist>

<verb-gignomai-present> ::= @TENSE[present] @VOICE[middle] ( "γίγνομαι" | "γίγνῃ" | "γίγνεται" | "γιγνόμεθα" | "γίγνεσθε" | "γίγνονται" )

<verb-gignomai-future> ::= @TENSE[future] @IRREGULAR ( "γενήσομαι" | "γενήσῃ" | "γενήσεται" | "γενησόμεθα" | "γενήσεσθε" | "γενήσονται" )

<verb-gignomai-aorist> ::= @TENSE[aorist] @IRREGULAR ( "ἐγενόμην" | "ἐγένου" | "ἐγένετο" | "ἐγενόμεθα" | "ἐγένεσθε" | "ἐγένοντο" )

/* Verb: δίδωμι (to give) - μι-verb */
<verb-didomi> ::= <verb-didomi-present> | <verb-didomi-aorist>

<verb-didomi-present> ::= @TENSE[present] @VOICE[active] @IRREGULAR ( "δίδωμι" | "δίδως" | "δίδωσι" | "δίδομεν" | "δίδοτε" | "διδόασι" )

<verb-didomi-aorist> ::= @TENSE[aorist] @IRREGULAR ( "ἔδωκα" | "ἔδωκας" | "ἔδωκε" | "ἐδώκαμεν" | "ἐδώκατε" | "ἔδωκαν" )

/* Verb: τίθημι (to put/place) - μι-verb */
<verb-tithemi> ::= <verb-tithemi-present> | <verb-tithemi-aorist>

<verb-tithemi-present> ::= @TENSE[present] @VOICE[active] @IRREGULAR ( "τίθημι" | "τίθης" | "τίθησι" | "τίθεμεν" | "τίθετε" | "τιθέασι" )

<verb-tithemi-aorist> ::= @TENSE[aorist] @IRREGULAR ( "ἔθηκα" | "ἔθηκας" | "ἔθηκε" | "ἐθήκαμεν" | "ἐθήκατε" | "ἔθηκαν" )

/* Verb: ἵστημι (to stand/set up) - μι-verb */
<verb-histemi> ::= <verb-histemi-present> | <verb-histemi-aorist>

<verb-histemi-present> ::= @TENSE[present] @VOICE[active] @IRREGULAR ( "ἵστημι" | "ἵστης" | "ἵστησι" | "ἵσταμεν" | "ἵστατε" | "ἱστᾶσι" )

<verb-histemi-aorist> ::= @TENSE[aorist] @IRREGULAR ( "ἔστησα" | "ἔστησας" | "ἔστησε" | "ἐστήσα
μεν" | "ἐστήσατε" | "ἔστησαν" )

/* Verb: ἵημι (to send) - μι-verb */
<verb-hiemi> ::= <verb-hiemi-present> | <verb-hiemi-aorist>

<verb-hiemi-present> ::= @TENSE[present] @VOICE[active] @IRREGULAR ( "ἵημι" | "ἵης" | "ἵησι" | "ἵεμεν" | "ἵετε" | "ἱᾶσι" )

<verb-hiemi-aorist> ::= @TENSE[aorist] @IRREGULAR ( "ἧκα" | "ἧκας" | "ἧκε" | "εἵκαμεν" | "εἵκατε" | "ἧκαν" )

/* Additional common irregular verbs - consolidated */
<irregular-verb-collection> ::= @IRREGULAR ( <verb-eimi> | <verb-phemi> | <verb-oida> | <verb-eimi-go> | <verb-erchomai> | <verb-phero> | <verb-lego> | <verb-horao> | <verb-gignomai> | <verb-didomi> | <verb-tithemi> | <verb-histemi> | <verb-hiemi> )

/* ============================================================================ */
/* DUAL NUMBER - Complete Paradigm                                             */
/* ============================================================================ */

/* Article dual forms */
<article-dual> ::= <article-dual-masculine> | <article-dual-feminine> | <article-dual-neuter>

<article-dual-masculine> ::= @GENDER[masculine] @NUMBER[dual] ( @CASE[nominative] "τώ" | @CASE[genitive] "τοῖν" | @CASE[dative] "τοῖν" | @CASE[accusative] "τώ" )

<article-dual-feminine> ::= @GENDER[feminine] @NUMBER[dual] ( @CASE[nominative] "τώ" | @CASE[genitive] "τοῖν" | @CASE[dative] "τοῖν" | @CASE[accusative] "τώ" )

<article-dual-neuter> ::= @GENDER[neuter] @NUMBER[dual] ( @CASE[nominative] "τώ" | @CASE[genitive] "τοῖν" | @CASE[dative] "τοῖν" | @CASE[accusative] "τώ" )

/* Noun dual forms */
<noun-dual> ::= <noun-dual-masculine> | <noun-dual-feminine> | <noun-dual-neuter>

<noun-dual-masculine> ::= @GENDER[masculine] @NUMBER[dual] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ω/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιν/ )

<noun-dual-feminine> ::= @GENDER[feminine] @NUMBER[dual] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+α/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αιν/ )

<noun-dual-neuter> ::= @GENDER[neuter] @NUMBER[dual] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ω/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιν/ )

/* Verb dual forms */
<verb-dual> ::= <verb-dual-2nd> | <verb-du
al-3rd>

<verb-dual-2nd> ::= @PERSON[2] @NUMBER[dual] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+τον/

<verb-dual-3rd> ::= @PERSON[3] @NUMBER[dual] /[α-ωά-ώἀ-ὤᾀ-ᾤ]+τον/

/* Pronoun dual forms */
<pronoun-dual> ::= <pronoun-dual-first> | <pronoun-dual-second> | <pronoun-dual-third>

<pronoun-dual-first> ::= @PERSON[1] @NUMBER[dual] ( @CASE[nominative] "νώ" | @CASE[genitive] "νῷν" | @CASE[dative] "νῷν" | @CASE[accusative] "νώ" )

<pronoun-dual-second> ::= @PERSON[2] @NUMBER[dual] ( @CASE[nominative] "σφώ" | @CASE[genitive] "σφῷν" | @CASE[dative] "σφῷν" | @CASE[accusative] "σφώ" )

<pronoun-dual-third> ::= @PERSON[3] @NUMBER[dual] ( @CASE[nominative] "σφώ" | @CASE[genitive] "σφῷν" | @CASE[dative] "σφῷν" | @CASE[accusative] "σφώ" )

/* ============================================================================ */
/* DIALECTAL VARIATIONS - Four Major Dialects                                  */
/* ============================================================================ */

/* Attic dialect (standard classical) - already primary form */
<attic-forms> ::= @DIALECT[attic] ( <attic-pronouns> | <attic-particles> | <attic-verbs> )

<attic-pronouns> ::= "ἐγώ" | "σύ" | "ἡμεῖς" | "ὑμεῖς"

<attic-particles> ::= "ἄν" | "κε" | "γε" | "δή" | "μέν" | "δέ"

<attic-verbs> ::= "εἰμί" | "λέγω" | "ποιῶ" | "ἔχω"

/* Ionic dialect (Herodotus, Homer) */
<ionic-forms> ::= @DIALECT[ionic] ( <ionic-pronouns> | <ionic-particles> | <ionic-verbs> | <ionic-phonology> )

<ionic-pronouns> ::= "ἐγών" | "τύ" | "ἡμεῖς" | "ὑμεῖς"

<ionic-particles> ::= "ἄν" | "κε" | "κεν" | "μέν" | "δέ" | "γε" | "περ" | "τοι"

<ionic-verbs> ::= "εἰμί" | "λέγω" | "ποιέω" | "ἔχω"

<ionic-phonology> ::= /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ηισι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ησι/ /* ηισι > ησι */

/* Doric dialect (Sparta, Sicily) */
<doric-forms> ::= @DIALECT[doric] ( <doric-pronouns> | <doric-particles> | <doric-verbs> | <doric-phonology> )

<doric-pronouns> ::= "ἐγώ" | "τύ" | "ἁμές" | "ὑμές" /* ἁμές instead of ἡμεῖς */

<doric-particles> ::= "κα" | "μάν" | "μέν" | "δέ" | "γα"
 /* κα instead of ἄν */

<doric-verbs> ::= "ἐντί" | "λέγω" | "ποιῶ" | "ἔχω" /* ἐντί instead of εἰσί */

<doric-phonology> ::= /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ᾱ/ /* long ᾱ instead of η */

/* Aeolic dialect (Lesbos, Sappho) */
<aeolic-forms> ::= @DIALECT[aeolic] ( <aeolic-pronouns> | <aeolic-particles> | <aeolic-verbs> | <aeolic-phonology> )

<aeolic-pronouns> ::= "ἔγων" | "τύ" | "ἄμμες" | "ὔμμες"

<aeolic-particles> ::= "κε" | "κεν" | "μάν" | "δέ" | "γα"

<aeolic-verbs> ::= "ἔμμι" | "ἔμμεν" /* ἔμμι instead of εἰμί */

<aeolic-phonology> ::= /[α-ωά-ώἀ-ὤᾀ-ᾤ]+σδ/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ττ/ /* σδ > ττ */

/* ============================================================================ */
/* OPTATIVE MOOD - Complete Conjugation System                                 */
/* ============================================================================ */

<optative-clause> ::= <optative-wish>
                   | <optative-potential>
                   | <optative-subordinate>

/* Optative of wish */
<optative-wish> ::= <optative-particle>? <opt-whitespace> <verb-optative> <opt-whitespace> <object>? "!"

<optative-particle> ::= "εἴθε" | "εἰ" <opt-whitespace> "γάρ"

/* Optative of potential (with ἄν) */
<optative-potential> ::= <subject>? <opt-whitespace> <verb-optative> <opt-whitespace> "ἄν" <opt-whitespace> <object>?

/* Optative in subordinate clauses */
<optative-subordinate> ::= <subordinating-conjunction> <opt-whitespace> <verb-optative> <opt-whitespace> <subordinate-content>

/* Present optative active */
<verb-optative-present-active> ::= @TENSE[present] @VOICE[active] @MOOD[optative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιμι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οις/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιμεν/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιτε/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιεν/ )

/* Aorist optative active */
<verb-optative-aorist-active> ::= @TENSE[aorist] @VOICE[active] @MOOD[optative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αιμι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αις/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αιμεν/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αιτε/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+αιεν/ )

/* Present op
tative middle/passive */
<verb-optative-present-middle> ::= @TENSE[present] @VOICE[middle] @MOOD[optative] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οίμην/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιο/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιτο/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οίμεθα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οισθε/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οιντο/ )

/* ============================================================================ */
/* PARTICIPLE SYSTEM - All Tenses, Voices, Genders                             */
/* ============================================================================ */

<participle-phrase> ::= <participle> <opt-whitespace> <object>? <opt-whitespace> <adverbial>*

/* Present active participle */
<participle-present-active> ::= @TENSE[present] @VOICE[active] @MOOD[participle] ( <participle-present-active-masc> | <participle-present-active-fem> | <participle-present-active-neut> )

<participle-present-active-masc> ::= @GENDER[masculine] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ων/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οντος/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οντι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οντα/ )

<participle-present-active-fem> ::= @GENDER[feminine] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ουσα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ούσης/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ούσῃ/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ουσαν/ )

<participle-present-active-neut> ::= @GENDER[neuter] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οντος/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+οντι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ον/ )

/* Aorist active participle */
<participle-aorist-active> ::= @TENSE[aorist] @VOICE[active] @MOOD[participle] ( <participle-aorist-active-masc> | <participle-aorist-active-fem> | <participle-aorist-active-neut> )

<participle-aorist-active-masc> ::= @GENDER[masculine] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ᾱς/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άντος/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άντι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άντα/ )

<participle-aorist-active-fem> ::= @GENDER[feminine] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ᾱσα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άσης/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άσῃ/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ᾱσαν/ )

<participle-aorist-active-neut> ::= @GENDER[neuter] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άν/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άντος/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άντι/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+άν/ )

/* Present middle/passive participle */
<participle-pre
sent-middle> ::= @TENSE[present] @VOICE[middle] @MOOD[participle] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+όμενος/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+ομένη/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+όμενον/ )

/* Aorist passive participle */
<participle-aorist-passive> ::= @TENSE[aorist] @VOICE[passive] @MOOD[participle] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+θείς/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+θεῖσα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+θέν/ )

/* Perfect active participle */
<participle-perfect-active> ::= @TENSE[perfect] @VOICE[active] @MOOD[participle] ( /[α-ωά-ώἀ-ὤᾀ-ᾤ]+κώς/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+κυῖα/ | /[α-ωά-ώἀ-ὤᾀ-ᾤ]+κός/ )


