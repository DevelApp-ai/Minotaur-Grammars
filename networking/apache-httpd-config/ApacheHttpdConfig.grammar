Grammar: ApacheHttpdConfig
FormatType: EBNF
TokenSplitter: Space

config     ::= line* ;
line       ::= section | directive | comment ;
comment    ::= '#' [^\n]* ;
section    ::= section_open line* section_close ;
section_open  ::= '<' section_name section_arg? '>' ;
section_close ::= '</' section_name '>' ;
section_name ::= 'VirtualHost' | 'Directory' | 'Location' | 'IfModule' | 'Files' | 'Proxy' | identifier ;
section_arg  ::= arg ;
directive  ::= name args? ;
name       ::= identifier ;
args       ::= arg (arg)* ;
arg        ::= text | identifier | number ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text       ::= '"' [^"]* '"' ;
number     ::= [0-9]+ ;
