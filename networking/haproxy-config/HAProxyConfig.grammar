Grammar: HAProxyConfig
FormatType: EBNF
TokenSplitter: Space

<config> ::= <section>* ;
<section> ::= <global_sec> | <defaults_sec> | <frontend_sec> | <backend_sec> | <listen_sec> ;
<global_sec> ::= 'global' <kw>+ ;
<defaults_sec> ::= 'defaults' <kw>+ ;
<frontend_sec> ::= 'frontend' <name> <kw>+ ;
<backend_sec> ::= 'backend' <name> <kw>+ ;
<listen_sec> ::= 'listen' <name> <kw>+ ;
<name> ::= <identifier> ;
<kw> ::= <keyword> <args>? ;
<keyword> ::= <identifier> ;
<args> ::= <arg> (<arg>)* ;
<arg> ::= <identifier> | <number> | <text> | <ip> ;
<ip> ::= <auto_ip_0> '.' <auto_ip_1> '.' <auto_ip_2> '.' <auto_ip_3> (':' <number>)? ;
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_.:-]*/ ;
<text> ::= /'"'[^"]*'"'/ ;
<number> ::= /[0-9]+/ ;

# --- Coverage completion: remaining language constructs ---
<resolvers_sec> ::= 'resolvers' <name> <kw>+ ;
<nameserver_kw> ::= 'nameserver' <name> <ip> ;
<http_response_rule> ::= 'http-response' ('set-header' | 'add-header' | 'del-header' | 'set-status') <arg> <arg>? ;
<redirect_rule> ::= 'redirect' ('location' | 'prefix' | 'scheme') <text> ('code' <number>)? ('if' condition)? ;
<tcp_request_rule> ::= 'tcp-request' ('connection' | 'content') ('accept' | 'reject' | 'set-var') ('if' condition)? ;
<server_kw> ::= 'server' <name> <ip> ('cookie' <name>)? ('check' 'inter' time_value)? ('observe' <identifier>)? ('ssl' 'verify' <identifier>)? ('resolvers' <name>)? ;
<log_format_kw> ::= 'log-format' <text> ;
<bind_kw> ::= 'bind' <ip> (':' <number>)? ('ssl' 'crt' <arg>)? ('accept-proxy')? ;
<mode_kw> ::= 'mode' ('http' | 'tcp') ;
<maxconn_kw> ::= 'maxconn' <number> ;

<auto_ip_0> ::= /[0-9]+/ ;
<auto_ip_1> ::= /[0-9]+/ ;
<auto_ip_2> ::= /[0-9]+/ ;
<auto_ip_3> ::= /[0-9]+/ ;
