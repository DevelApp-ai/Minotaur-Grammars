Grammar: HAProxyConfig
FormatType: EBNF
TokenSplitter: Space

config    ::= section* ;
section   ::= global_sec | defaults_sec | frontend_sec | backend_sec | listen_sec ;
global_sec   ::= 'global' kw+ ;
defaults_sec ::= 'defaults' kw+ ;
frontend_sec ::= 'frontend' name kw+ ;
backend_sec  ::= 'backend' name kw+ ;
listen_sec   ::= 'listen' name kw+ ;
name      ::= identifier ;
kw        ::= keyword args? ;
keyword   ::= identifier ;
args      ::= arg (arg)* ;
arg       ::= identifier | number | text | ip ;
ip        ::= [0-9]+ '.' [0-9]+ '.' [0-9]+ '.' [0-9]+ (':' number)? ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_.:-]* ;
text      ::= '"' [^"]* '"' ;
number    ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
acl ::= 'acl' identifier (identifier | text | ip | number)+ ; ;
use_backend ::= 'use_backend' identifier 'if' condition ; ;
condition ::= identifier | '!' identifier | condition '&&' condition | condition '||' condition ; ;
http_request ::= 'http-request' ('allow' | 'deny' | 'redirect' 'location' text?) ; ;
timeout_kw ::= 'timeout' identifier time_value ; ;
time_value ::= number ('ms' | 's' | 'm' | 'h' | 'd') ; ;
balance ::= 'balance' ('roundrobin' | 'leastconn' | 'source' | 'uri') ; ;
stick_table ::= 'stick-table' 'type' identifier 'size' number ; ;
stick_match ::= 'stick' 'match' identifier ; ;
default_server ::= 'default-server' kw+ ; ;
httpchk ::= 'option' 'httpchk' text? ; ;
