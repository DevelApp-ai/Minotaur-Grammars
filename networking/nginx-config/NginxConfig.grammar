Grammar: NginxConfig
FormatType: EBNF
TokenSplitter: Space

config    ::= directive* ;
directive ::= simple | block ;
simple    ::= name args? ';' ;
block     ::= name args? '{' directive* '}' ;
name      ::= identifier ;
args      ::= arg (arg)* ;
arg       ::= text | identifier | number | regex ;
regex     ::= '~' text ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_.]* ;
text      ::= '"' [^"]* '"' ;
number    ::= [0-9]+ ( 'k' | 'm' | 'g' )? ;
