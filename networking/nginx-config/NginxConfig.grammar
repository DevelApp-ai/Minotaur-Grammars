Grammar: NginxConfig
FormatType: EBNF
TokenSplitter: Space

config    ::= directive* ;
directive ::= simple | block ;
simple    ::= name args? ';' ;
block     ::= name args? '{' directive* '}' ;
name      ::= identifier ;
args      ::= arg (arg)* ;
arg       ::= text | identifier | number | regex ;
regex     ::= '~' text ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_.]* ;
text      ::= '"' [^"]* '"' ;
number    ::= [0-9]+ ( 'k' | 'm' | 'g' )? ;

# --- Extended coverage: additional language constructs ---
upstream ::= 'upstream' identifier '{' directive* '}' ; ;
location_mod ::= ('=' | '~' | '~*' | '^~') arg ; ;
if_directive ::= 'if' '(' condition ')' '{' directive* '}' ; ;
condition ::= var ('=' | '!=' | '~' | '~*') arg | '-f' arg ; ;
var ::= '$' identifier ; ;
include_file ::= 'include' arg ';' ; ;
error_page ::= 'error_page' number+ arg ';' ; ;
return_dir ::= 'return' number? arg ';' ; ;
rewrite_dir ::= 'rewrite' regex arg ('permanent' | 'last' | 'break' | 'redirect')? ';' ; ;
map_block ::= 'map' var var '{' pair (pair)* '}' ; ;
limit_except ::= 'limit_except' args '{' directive* '}' ; ;
