Grammar: AiSpec
FormatType: EBNF
TokenSplitter: Space

# AiSpec - grammar for hierarchical .ai component specification files
# used by Specification-First Development (SpecTree). A .ai file declares
# a component, its metadata, functional requirements, API surface,
# data model references and ADR compliance declarations.

<ai-document> ::= <component-header> <metadata-block>* <section>* => { buildComponentSpec($1, $2, $3); }

<component-header> ::= <hash1> "Component:" <component-name> => { setComponentName($3); }

<metadata-block> ::= <description-line>
                  | <dependencies-line>
                  | <namespace-line>
                  | <version-line>

<description-line> ::= <hash2> "Description:" <free-text> => { setDescription($3); }
<dependencies-line> ::= <hash2> "Dependencies:" <component-list> => { setDependencies($3); }
<namespace-line> ::= <hash2> "Namespace:" <qualified-name> => { setNamespace($3); }
<version-line> ::= <hash2> "Version:" <version-number> => { setVersion($3); }

<section> ::= <requirements-section>
           | <endpoints-section>
           | <data-model-section>
           | <compliance-section>

<requirements-section> ::= <hash3> "Requirements" <requirement-entry>+ => { collectRequirements($3); }

<requirement-entry> ::= "-" <requirement-id> ":" <free-text> => { addRequirement($2, $4); }
                      | "-" "Must" <free-text> => { addRequirement("implicit-must", $3); }
                      | "-" "Should" <free-text> => { addRequirement("implicit-should", $3); }

<endpoints-section> ::= <hash3> "API" "Endpoints" <endpoint-entry>+
<endpoint-entry> ::= "-" <http-method> <route-path> ":" <free-text> => { addEndpoint($2, $3, $5); }

<data-model-section> ::= <hash3> "Data" "Model" <model-entry>+
<model-entry> ::= <entity-line> | <field-line>
<entity-line> ::= "-" <identifier> => { declareEntity($2); }
<field-line> ::= <indent> "-" <identifier> ":" <type-name> => { declareField($3, $5); }

<compliance-section> ::= <hash3> "Compliance" <compliance-entry>+
<compliance-entry> ::= "-" "complies-with" <adr-id> => { addAdrReference($3); }
                     | "-" "satisfies" <requirement-id> => { addRequirementLink($3); }

<component-list> ::= <component-name> | <component-name> "," <component-list>
<component-name> ::= <identifier>
<qualified-name> ::= <identifier> ("." <identifier>)*
<version-number> ::= /[0-9]+(\.[0-9]+)*/
<requirement-id> ::= ("REQ" | "M" | "S" | "C" | "W") "-" /[0-9]+/
<adr-id> ::= "ADR-" /[0-9]+/
<http-method> ::= "GET" | "POST" | "PUT" | "DELETE" | "PATCH" | "HEAD" | "OPTIONS"
<route-path> ::= "/" <path-segment> ("/" <path-segment>)*
<path-segment> ::= <identifier> | "{" <identifier> "}"
<type-name> ::= <identifier> "?" | <identifier> "[]" | <identifier>
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<free-text> ::= /[^\n]+/
<indent> ::= /[ \t]+/
<hash1> ::= "#"
<hash2> ::= "##"
<hash3> ::= "###"
