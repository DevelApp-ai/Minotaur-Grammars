Grammar: Base64
FormatType: EBNF
TokenSplitter: Space

<document> ::= <base64> | <base64url> | <mime_line> | <data_url> | <encoded_word> | <openpgp_armor> ;
<base64> ::= <chunk>* <tail>? ;
<chunk> ::= <b64_char> <b64_char> <b64_char> <b64_char> ;
<tail> ::= <b64_char> <b64_char> '==' | <b64_char> <b64_char> <b64_char> '=' ;
<b64_char> ::= <auto_b64_char_1> ;

# --- Extended coverage: additional language constructs ---
<base64url> ::= <url_chunk>* <url_tail>? ;
<url_chunk> ::= <url_char> <url_char> <url_char> <url_char> ;
<url_tail> ::= <url_char> <url_char> '==' | <url_char> <url_char> <url_char> '=' ;
<url_char> ::= <auto_url_char_2> ;
<mime_line> ::= <chunk>* <tail>? <line_break> ;
<line_break> ::= '\r' '\n' | '\n' ;
<data_url> ::= 'data:' <mime_type> ';base64,' ( <chunk> | <url_chunk> )* ( <tail> | <url_tail> )? ;
<mime_type> ::= <auto_mime_type_3> ;

# --- Coverage completion: remaining language constructs ---
<encoded_word> ::= '=?' <charset> '?' <encoding> '?' <url_chunk>+ '?=' ;
<charset> ::= 'UTF-8' | 'ISO-8859-1' | 'US-ASCII' ;
<encoding> ::= 'B' ;
<openpgp_armor> ::= <armor_header> <base64> <armor_footer> ;
<armor_header> ::= '-----BEGIN' <armor_label> '-----' ;
<armor_footer> ::= '-----END' <armor_label> '-----' ;
<armor_label> ::= 'PGP' 'MESSAGE' | 'PGP' 'SIGNATURE' | 'PGP' 'PRIVATE' 'KEY' 'BLOCK' | 'PUBLIC' 'KEY' 'BLOCK' ;

<auto_b64_char_1> ::= /[A-Za-z0-9+/]/ ;
<auto_url_char_2> ::= /[A-Za-z0-9_-]/ ;
<auto_mime_type_3> ::= /[A-Za-z0-9.+-]+\/[A-Za-z0-9.+-]+/ ;
