Grammar: PostalCoding
FormatType: EBNF

﻿Grammar: CEBNF

/* Grammar for validating US Postal coding */
<postal-address>  ::= <name-part> <street-address> <zip-part>
<name-part>       ::= <opt-whitespace> <personal-part> <whitespace> <last-name> <opt-whitespace> <opt-suffix-part> <opt-whitespace> <EOL> | <opt-whitespace> <personal-part> <opt-whitespace> <name-part>
<personal-part>   ::= <first-name> | <initials> "." 
<street-address>  ::= <opt-whitespace> <house-num> <whitespace> <street-name> <whitespace> <opt-whitespace> <opt-apt-num> <EOL>
<zip-part>        ::= <opt-whitespace><town-name> <opt-whitespace> "," <opt-whitespace> <state-code> <whitespace> <ZIP-code> <EOL>
<opt-suffix-part> ::= "Sr." | "Jr." | ""
<opt-apt-num> ::= "" ;
<opt-apt-num> ::= <number> ;
<house-num>       ::= <number>
<street-name>     ::= <name>
<last-name>       ::= <name>
<first-name>      ::= <name>
<town-name>       ::= <name>
<state-code>      ::= <name>
<ZIP-code>        ::= <name>
<initials>        ::= <initial> | <initial> <initials>
<initial>         ::= <character>
<name>            ::= <text>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Postal code / address format (postalcoding) */
<ws> ::= /[ \t\r\n]+/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?[0-9]+(\x2E[0-9]+)?([eE][+-]?[0-9]+)?/
<word> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\x2F|\.|\(|\)|-|_|,|'|#/
