Grammar: ApacheAccessCombined
FormatType: EBNF

/*
 * Apache/Nginx "combined" access log format for benchmark corpora (#192):
 *   127.0.0.1 - frank [10/Oct/2000:13:55:36 -0700] "GET /a.gif HTTP/1.0" 200 2326 "http://ref/" "Mozilla/5.0"
 */

<line> ::= <ip> <ident> <user> '[' <time> ']' <request> <status> <size> <referer> <agent> ;
<ip> ::= /[0-9]+(\.[0-9]+){3}/ ;
<ip6> ::= /[0-9a-fA-F]*:[0-9a-fA-F:]+/ ;
<ident> ::= /[a-zA-Z0-9._-]+/ ;
<user> ::= /[a-zA-Z0-9._-]+/ ;
<time> ::= /\[[^\]\n]+\]/ ;
<request> ::= /"[^"\n]*"/ ;
<status> ::= /[0-9]{3}/ ;
<size> ::= /[0-9]+/ ;
<referer> ::= /"[^"\n]*"/ ;
<agent> ::= /"[^"\n]*"/ ;
<dash> ::= /-/ ;
<ws> ::= /[ \t\r\n]+/ => { skip } ;
