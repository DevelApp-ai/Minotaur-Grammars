Grammar: Crontab
FormatType: EBNF
TokenSplitter: Space

<crontab> ::= <line>* ;
<line> ::= <entry> | <variable> | <comment> | <empty> ;
<comment> ::= '#' <auto_comment_1> ;
<variable> ::= <name> '=' <value> ;
<name> ::= <identifier> ;
<value> ::= <auto_comment_1> ;
<entry> ::= <minute> <hour> <day_of_month> <month> <day_of_week> <command> ;
<minute> ::= <field> ;
<hour> ::= <field> ;
<day_of_month> ::= <field> ;
<month> ::= <field>  | <month_name> ;
<day_of_week> ::= <field>  | <day_name> ;
<field> ::= '*' | <number> | <range> | <list> | <step> ;
<range> ::= <number> '-' <number> ;
<list> ::= ( <number> | <range> | '*')( ','( <number> | <range> | '*'))* ;
<step> ::= ( <number> | <range> | '*') '/' <number> ;
<command> ::= <auto_command_2> ;
<identifier> ::= <auto_identifier_3> <auto_identifier_4> ;
<number> ::= <auto_number_5> ;

# --- Coverage completion: remaining language constructs ---

<day_name> ::= ( "SUN" | "MON" | "TUE" | "WED" | "THU" | "FRI" | "SAT") ;
<month_name> ::= ( "JAN" | "FEB" | "MAR" | "APR" | "MAY" | "JUN" | "JUL" | "AUG" | "SEP" | "OCT" | "NOV" | "DEC") ;

<auto_comment_1> ::= /^\n*/ ;
<auto_command_2> ::= /^\n+/ ;
<auto_identifier_3> ::= /a-zA-Z_/ ;
<auto_identifier_4> ::= /a-zA-Z0-9_*/ ;
<auto_number_5> ::= /0-9+/ ;
