Grammar: WindowsDirOutput
FormatType: EBNF
TokenSplitter: Space

output   ::= header entry* footer ;
header   ::= 'Volume' 'in' 'drive' identifier 'is' text 'Directory' 'of' path ;
entry    ::= date time ('<DIR>' | size) name ;
date     ::= number '/' number '/' number ;
time     ::= number ':' ('AM' | 'PM') ;
size     ::= number ;
name     ::= [^\n]+ ;
footer   ::= file_count byte_count dir_count free_bytes ;
file_count ::= 'File' '(s)' number 'bytes' ;
byte_count ::= number ;
dir_count ::= 'Dir' '(s)' number 'bytes' ;
free_bytes ::= number 'bytes' 'free' ;
path     ::= [a-zA-Z]: ('\\' identifier)* ;
identifier ::= [a-zA-Z0-9_.-]+ ;
number   ::= [0-9]+ ;
