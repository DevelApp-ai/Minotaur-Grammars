Grammar: UnixLsOutput
FormatType: EBNF
TokenSplitter: Space

<output> ::= <total_line>? <entry>+ ;
<entry> ::= <long_entry> | <long_entry_ext> | <inode_entry> | <name_entry> ;
<long_entry> ::= <perms> <link_count> <owner> <group> <size> <month> <day> <time_or_year> <filename> ;
<perms> ::= <file_type> <perms_triplet> ;
<file_type> ::= '-' | 'd' | 'l' | 'c' | 'b' | 's' | 'p' ;
<perms_triplet> ::= <perm> ( <perm> <perm> ) ;
<perm> ::= 'r' | 'w' | 'x' | 's' | 'S' | 't' | 'T' | '-' ;
<link_count> ::= <number> ;
<owner> ::= <identifier> ;
<group> ::= <identifier> ;
<size> ::= <number> | <human_size> ;
<month> ::= 'Jan' | 'Feb' | 'Mar' | 'Apr' | 'May' | 'Jun' | 'Jul' | 'Aug' | 'Sep' | 'Oct' | 'Nov' | 'Dec' ;
<day> ::= <number> ;
<time_or_year> ::= <time> | <year> | <iso_timestamp> ;
<time> ::= <number> ':' <number> ;
<year> ::= <number> ;
<name_entry> ::= <filename> ;
<filename> ::= <auto_filename_0> ;
<identifier> ::= <auto_identifier_1> ;
<number> ::= <auto_number_2> ;

# --- Extended coverage: additional language constructs ---
<total_line> ::= 'total' <number> ;
<attr_flag> ::= ( '@' | '+' | '.' | '*' )? ;
<device_num> ::= <number> ',' <number> ;
<inode_entry> ::= <number> <name_entry> ;
<long_entry_ext> ::= <perms> <attr_flag>? <link_count> <owner> <group> ( <size> | <device_num> ) <month> <day> <time_or_year> <filename> ;

# --- Coverage completion: remaining language constructs ---
<iso_timestamp> ::= <number> '-' <number> '-' <number> <time> ;
<human_size> ::= <number> ( '.' <number> )? ( 'B' | 'K' | 'M' | 'G' | 'T' ) ;

<auto_filename_0> ::= /[^\n]+/ ;
<auto_identifier_1> ::= /[a-zA-Z0-9_.-]+/ ;
<auto_number_2> ::= /[0-9]+/ ;
