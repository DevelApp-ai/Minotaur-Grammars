Grammar: Jq
FormatType: EBNF

<program> ::= <pipe>
<pipe> ::= <term> ("|" <term>)*
<term> ::= <path> | <literal> | <number> | <var> | <call> | <object> | <array> | "(" <pipe> ")"
<path> ::= "." <identifier>? ("[" <pipe> "]" | "." <identifier>)*
<call> ::= <identifier> "(" <pipe>? ("," <pipe>)* ")"
<literal> ::= <string> | "true" | "false" | "null" | <format> <string>
<object> ::= "{" (<identifier> ":" <pipe> | <string> ":" <pipe>) ("," <identifier> ":" <pipe>)* "}"
<array> ::= "[" <pipe>? ("," <pipe>)* "]"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   jq 1.x: ws, # comments, strings with escapes, format strings @json/@csv, numbers, identifiers, $vars, pipes and operators. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<format> ::= /@[a-z]+/
<number> ::= /[+-]?[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<var> ::= /\$[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\x2F\x2F|\x2F|\||\.|\?|\(|\)|\[|\]|\{|\}|\$|\+|\*|==|!=|<=|>=|=>|,|:|;|-|%|<|>|=/
