Grammar: Rego
FormatType: EBNF

<policy> ::= <package> <import>* <rule>*
<package> ::= "package" <path>
<path> ::= <identifier> ("." <identifier>)*
<import> ::= "import" <path> ("as" <identifier>)?
<rule> ::= <head> <body>
<head> ::= <identifier> (":=" | ":" | "=") <term> | <identifier> "if" | <identifier> "contains" <term>
<body> ::= "{" <expr> (";" <expr>)* "}" | <expr>
<expr> ::= <term> (<op> <term>)*
<term> ::= <identifier> | <string> | <number> | <array> | <object> | <set> | <call>
<array> ::= "[" <term> ("," <term>)* "]"
<object> ::= "{" <term> ":" <term> ("," <term> ":" <term>)* "}"
<set> ::= "{" <term> ("," <term>)* "}"
<call> ::= <identifier> "(" <term> ("," <term>)* ")"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   OPA Rego 1.x: ws, # comments, raw strings `..`, strings, numbers, identifiers, operators incl := and ... . */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<raw-string> ::= /`([^`\\]|\\.)*`/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?)/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\.\.\.|\x2F|:=|==|!=|<=|>=|\+|\*|\||\(|\)|\[|\]|\{|\}|\.|=|<|>|-|%|&|,|;|:/
