Grammar: SPARQL
FormatType: EBNF
TokenSplitter: Space

<query> ::= <prologue> <select_query> ;
<prologue> ::= <prefix_decl>* ;
<prefix_decl> ::= 'PREFIX' <pname_ns> <iriref> ;
<pname_ns> ::= <identifier> ':' ;
<select_query> ::= 'SELECT'( 'DISTINCT')?( '*' | <var_list>) 'WHERE'? <group_graph_pattern>( <solution_modifier>)* ;
<var_list> ::= <var>( <var>)* ;
<var> ::= '?' <identifier> | '$' <identifier> ;
<group_graph_pattern> ::= '{' <triples_block>?( <graph_pattern_node> '.'? <triples_block>?)* '}'  | <service_pattern>  | <graph_pattern> ;
<graph_pattern_node> ::= <optional_block> | <filter_block> | <union_block> ;
<optional_block> ::= 'OPTIONAL' <group_graph_pattern> ;
<filter_block> ::= 'FILTER' '(' <expr> ')'  | <filter_exists> ;
<union_block> ::= <group_graph_pattern> 'UNION' <group_graph_pattern> ;
<triples_block> ::= <triples_same_subject>( '.' <triples_same_subject>?)* ;
<triples_same_subject> ::= <var_or_term> <property_list> ;
<property_list> ::= <verb> <object_list>( ';'( <verb> <object_list>)?)* ;
<object_list> ::= <object>( ',' <object>)* ;
<verb> ::= <iri> | 'a'  | <erty_path> ;
<object> ::= <var_or_term> ;
<var_or_term> ::= <var> | <iri> | <literal> | <blank_node> ;
<blank_node> ::= '_:' <identifier> ;
<iri> ::= <iriref> | <prefixed_name> ;
<iriref> ::= '<' <auto_iriref_1> '>' ;
<prefixed_name> ::= ( <identifier>)? ':' <identifier>? ;
<literal> ::= <text>( '^^' <iri> | '@' <identifier>)? ;
<expr> ::= <var_or_term> | <expr> <binop> <expr> | '(' <expr> ')' | <func_call> ;
<func_call> ::= ( <iri> | 'BOUND' | 'STR' | 'REGEX' | 'STRLEN') '(' <args>? ')' ;
<args> ::= <expr>( ',' <expr>)* ;
<binop> ::= '=' | '!=' | '<' | '>' | '&&' | '||' ;
<solution_modifier> ::= ( 'ORDER' 'BY' <order_cond>+ | 'LIMIT' <number> | 'OFFSET' <number> | 'GROUP' 'BY' <var>+) ;
<order_cond> ::= ( 'ASC' | 'DESC') '(' <expr> ')' | <var> ;
<identifier> ::= <auto_identifier_2> <auto_identifier_3> ;
<text> ::= '"' <auto_text_4> '"' ;
<number> ::= <auto_number_5> ;

# --- Coverage completion: remaining language constructs ---

<service_pattern> ::= "SERVICE" (
 "SILENT" )? "var_or_iri" <group_graph_pattern> ;
<filter_exists> ::= "FILTER"( "EXISTS" | "NOT" "EXISTS") <group_graph_pattern> ;
<graph_pattern> ::= "GRAPH"( <var> | <iri>) <group_graph_pattern> ;
prop
<erty_path> ::= "path_alternative"  | <path_element> ;
<path_element> ::= "path_primary" <path_modifier> ;
<path_modifier> ::= "*" | "+" | "?" | "{" "integer"( "," "integer"?)? "}" ;

<auto_iriref_1> ::= /[^>]*/ ;
<auto_identifier_2> ::= /[a-zA-Z_]/ ;
<auto_identifier_3> ::= /[a-zA-Z0-9_.-]*/ ;
<auto_text_4> ::= /[^"]*/ ;
<auto_number_5> ::= /[0-9]+/ ;
