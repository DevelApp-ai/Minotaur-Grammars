Grammar: PrismaSchema
FormatType: EBNF
TokenSplitter: Space

schema    ::= block* ;
block     ::= datasource | generator | model | enum_block ;
datasource ::= 'datasource' identifier '{' provider url '}' ;
provider  ::= 'provider' '=' text ;
url       ::= 'url' '=' (text | 'env' '(' text ')') ;
generator ::= 'generator' identifier '{' gen_provider output? '}' ;
gen_provider ::= 'provider' '=' text ;
output    ::= 'output' '=' text ;
model     ::= 'model' identifier '{' field_def* (model_attr)* '}' ;
field_def ::= field_name type modifiers? attrs? ;
field_name ::= identifier ;
type      ::= identifier ;
modifiers ::= '?' | '[' ']' ;
attrs     ::= attribute (attribute)* ;
attribute ::= '@' identifier ('(' args? ')')? ;
model_attr ::= '@@' identifier ('(' args? ')')? ;
args      ::= arg (',' arg)* ;
arg       ::= identifier ':' scalar | scalar ;
enum_block ::= 'enum' identifier '{' enum_value* '}' ;
enum_value ::= identifier ;
scalar    ::= text | number | boolean | '[' scalars ']' ;
scalars   ::= scalar (',' scalar)* ;
boolean   ::= 'true' | 'false' ;
identifier ::= [a-zA-Z][a-zA-Z0-9_]* ;
text      ::= '"' [^"]* '"' ;
number    ::= [0-9]+ ;
