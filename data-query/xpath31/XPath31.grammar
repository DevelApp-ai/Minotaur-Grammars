Grammar: XPath31
FormatType: EBNF

<expr> ::= <or-expr>
<or-expr> ::= <and-expr> ("or" <and-expr>)*
<and-expr> ::= <comparison> ("and" <comparison>)*
<comparison> ::= <path-expr> (<relop> <path-expr>)?
<path-expr> ::= <primary> ("/" | "//") <step> | <step>
<step> ::= <axis>? <node-test> <predicate>*
<axis> ::= <name> "::"
<node-test> ::= <name> | "*" | <name> ":" "*"
<predicate> ::= "[" <expr> "]"
<primary> ::= "(" <expr> ")" | <literal> | <number> | <var> | <function-call>
<literal> ::= <string>
<function-call> ::= <name> "(" <expr>? ("," <expr>)* ")"

<relop> ::= "=" | "!=" | "<" | "<=" | ">" | ">=" | "eq" | "ne" | "lt" | "le" | "gt" | "ge"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   XPath 3.1: ws, single/double-quoted strings, numbers, names (incl - and .), path operators / // .. @ * and comparisons. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?/
<name> ::= /[A-Za-z_][A-Za-z0-9_.-]*/
<var> ::= /\$[A-Za-z_][A-Za-z0-9_.-]*/
<op> ::= /\x2F\x2F|\.\.|\x2F|div|mod|\.|\*|::|:=|!=|<=|>=|\+|\(|\)|\[|\]|\||\\|@|=|<|>|-|,|"|'/
