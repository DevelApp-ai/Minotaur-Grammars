Grammar: Gremlin
FormatType: EBNF

<query> ::= <traversal> ;
<traversal> ::= <source_step> <step>* ;
<source_step> ::= 'g' '.'( 'V' | 'E') '(' <args>? ')' | 'g' '.' <identifier> '(' <args>? ')' ;
<step> ::= '.' <step_name> '(' <args>? ')' ;
<step> ::= <with_step> | <sack_step> | <profile_step> ;
<step_name> ::= 'has' | 'hasLabel' | 'hasId' | 'out' | 'in' | 'both' | 'outE' | 'inE' | 'values' | 'label' | 'id' | 'count' | 'limit' | 'range' | 'order' | 'by' | 'where' | 'filter' | 'map' | 'path' | 'dedup' | 'group' | 'project' | 'select' | 'as' | 'fold' | 'unfold' | 'aggregate' | 'match' | 'choose' | 'coalesce' | 'union' | 'repeat' | 'until' | 'times' | 'emit' ;
<args> ::= <arg>( ',' <arg>)* ;
<arg> ::= <literal> | <identifier> | <text> | <traversal> | <predicate> ;
<predicate> ::= ( 'eq' | 'neq' | 'lt' | 'lte' | 'gt' | 'gte' | 'within' | 'without') '(' <args>? ')' ;
<literal> ::= <number> | <text> | <boolean> ;
<boolean> ::= 'true' | 'false' ;
<identifier> ::= <auto_identifier_1> <auto_identifier_2> ;
<text> ::= '"' <auto_text_3> '"' ;
<text> ::= <auto_text_4> ;
<number> ::= <auto_number_5> ;

# --- Coverage completion: remaining language constructs ---

<with_step> ::= "with(" "string" "," "object" ")" ;
<sack_step> ::= "sack(" <auto_sack_step_6> ")" ;
<sack_step> ::= <sack_value> ;
<sack_value> ::= ".sack()" ;
<profile_step> ::= "profile()" ( "(" "string" ")" )? ;

<auto_identifier_1> ::= /[a-zA-Z_]/ ;
<auto_identifier_2> ::= /[a-zA-Z0-9_]*/ ;
<auto_text_3> ::= /[^"]*/ ;
<auto_text_4> ::= /[^\']*/ ;
<auto_number_5> ::= /[0-9]+/ ;
<auto_sack_step_6> ::= /[ operator ]/ ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Gremlin traversal */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?)/
<identifier> ::= /[a-zA-Z_$][a-zA-Z0-9_$-]*/
<op> ::= /\.\.\.|\|\||\.\.|\x2F|->|=>|==|!=|<=|>=|&&|::|\.|\+|\*|\?|\(|\)|\[|\]|\{|\}|\||\^|\$|:|;|,|=|-|%|<|>|!|&|~|@/
