Grammar: AnsiblePlaybook
FormatType: EBNF
TokenSplitter: Space

# AnsiblePlaybook grammar - core subset
<file> ::= <document-start>? <play>* => { buildPlaybook($2); }
<document-start> ::= "---"
<play> ::= <play-keys> => { addPlay($1); }
<play-keys> ::= <play-key> <play-key>*
<play-key> ::= <hosts-key> | <name-key> | <vars-key> | <roles-key> | <tasks-key> | <become-key> | <handlers-key> | <gather-facts-key>
<hosts-key> ::= "hosts:" <host-pattern> => { setHosts($2); }
<host-pattern> ::= <host-item> | "[" <host-item> "]"
<host-item> ::= /[a-zA-Z0-9_.:*!,-]+/
<name-key> ::= "name:" <free-text>
<become-key> ::= "become:" <boolean>
<gather-facts-key> ::= "gather_facts:" <boolean>
<vars-key> ::= "vars:" <var-entry>* => { setVars($2); }
<var-entry> ::= <indent> <identifier> ":" <value> => { addVar($2, $4); }
<roles-key> ::= "roles:" <role-entry>*
<role-entry> ::= <indent> "-" (<identifier> | <role-map>) => { addRole($3); }
<role-map> ::= "{" "role:" <identifier> (<role-attr>)* "}"
<role-attr> ::= "," <identifier> ":" <value>
<tasks-key> ::= "tasks:" <task>* => { setTasks($2); }
<handlers-key> ::= "handlers:" <task>*
<task> ::= <indent> "-" <task-attr>* => { addTask($3); }
<task-attr> ::= <name-attr> | <module-attr> | <generic-attr>
<name-attr> ::= "name:" <free-text> => { setTaskName($2); }
<module-attr> ::= <module-name> ":" <module-arg> => { setModule($1, $3); }
<module-name> ::= /[a-zA-Z_][a-zA-Z0-9_.]*/
<module-arg> ::= <value> | <module-sub-arg> | <free-text>
<module-sub-arg> ::= <indent2> <identifier> ":" <value>
<generic-attr> ::= <identifier> ":" <value> => { setTaskAttr($1, $3); }
<generic-attr> ::= "when:" <jinja-expr> => { setWhen($2); }
             | "loop:" <value> => { setLoop($2); }
             | "register:" <identifier> => { setRegister($2); }
             | "notify:" <value> => { setNotify($2); }
             | "tags:" <value>
             | "become:" <boolean>
             | "become_user:" <identifier>
<value> ::= <scalar> | <list-value> | <map-value> | 
<jinja-expr>
<scalar> ::= <boolean> | <number> | <string> | "null"
<boolean> ::= "true" | "false" | "yes" | "no"
<number> ::= /[+-]?[0-9]+(\.[0-9]+)?/
<string> ::= /'[^'\n]*'/ | /"[^"\n]*"/
<list-value> ::= "[" <value>? ("," <value>)* "]"
<map-value> ::= "{" <map-entry>* "}"
<map-entry> ::= <identifier> ":" <value>
<jinja-expr> ::= "{{" /[\S\s]*?/ "}}" => { buildJinja($2); }
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_.-]*/
<free-text> ::= /[^\n]+/
<indent> ::= /[ \t]+/
<indent2> ::= /[ \t][ \t]+/

# --- Coverage completion: remaining language constructs ---

collections_block ::= "collections" ":" [ text ("," text)* ] ;
module_defaults ::= "module_defaults" ":" map ;
pre_tasks ::= "pre_tasks" ":" [ task* ] ;
post_tasks ::= "post_tasks" ":" [ task* ] ;
strategy_kw ::= "strategy" ":" ("linear" | "free" | "host_pinned" | "debug") ;
any_errors_fatal ::= "any_errors_fatal" ":" boolean ;
max_fail_pct ::= "max_fail_percentage" ":" number ;
fqc_module ::= text "." text "." text ;
delegate_to ::= "delegate_to" ":" text ;
delegate_facts ::= "delegate_facts" ":" boolean ;
run_once ::= "run_once" ":" boolean ;
failed_when ::= "failed_when" ":" expr ;
changed_when ::= "changed_when" ":" expr ;
