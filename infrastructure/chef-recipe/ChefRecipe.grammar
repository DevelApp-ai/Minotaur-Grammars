Grammar: ChefRecipe
FormatType: EBNF
TokenSplitter: Space

# ChefRecipe grammar - core subset
<file> ::= <statement>* => { buildRecipe($1); }
<statement> ::= <resource-block> | <ruby-assignment> | <if-stmt> | <include-stmt> | <attribute-stmt>
<resource-block> ::= <resource-type> " " <resource-name> "do" <resource-body> "end" => { declareResource($1, $3, $5); }
<resource-type> ::= "package" | "service" | "template" | "file" | "directory" | "cookbook_file" | "remote_file" | "execute" | "script" | "cron" | "user" | "group" | "apt_repository" | "gem_package" | "systemd_unit" | "execute" | "log" | <identifier>
<resource-name> ::= <string> | <ruby-identifier>
<resource-body> ::= <resource-attr>*
<resource-attr> ::= <attr-key> " " <ruby-expr> => { setAttr($1, $3); }
                | <action-attr> | <notifier> | <guard> | <only-if>
<action-attr> ::= "action" " " <action-name> => { setAction($3); }
<action-name> ::= ":install" | ":remove" | ":create" | ":delete" | ":start" | ":stop" | ":restart" | ":reload" | ":enable" | ":disable" | ":nothing" | ":run" | ":nothing"
<notifier> ::= ("notifies" | "subscribes") " " <notify-action> "," <resource-ref> ("," <delay-mode>)? => { addNotification($1, $3, $5, $7); }
<notify-action> ::= ":restart" | ":reload" | ":run" | ":create" | ":nothing" | <ruby-symbol>
<delay-mode> ::= ":delayed" | ":immediately" | ":before"
<resource-ref> ::= "'" <resource-type> "[" <resource-name> "]'" | <ruby-expr>
<guard> ::= ("not_if" | "only_if") " " <ruby-expr> => { addGuard($1, $3); }
<resource-name-attr> ::= "path" " " <ruby-expr> | "source" " " <ruby-expr> | "owner" " " <ruby-expr> | "mode" " " <ruby-expr> | "variables" " " <ruby-hash>
<ruby-hash> ::= "{" <hash-entry>* "}"
<hash-entry> ::= <ruby-symbol> " => " <ruby-expr> ","? => { addHashEntry($1, $3); }
             | <hash-key> ":" <ruby-expr> ","?
<hash-key> ::= <string> | <ruby-identifier>
<ruby-symbol> ::= ":" <ruby-identifier> => { buildSymbol($2); }
<ruby-assignment> ::= <ruby-identifier> " = " <ruby-expr> => { assignVar($1, $3); }
<if-stmt> ::= "if" <ruby-expr> <statement>* "end" => { buildIf($2, $3); }
           | "case" <ruby-expr> <when-clause>+ ("else" <statement>*)? "end" => { buildCase($2, $3); }
<when-clause> ::= "when" <ruby-expr> <statement>*
<include-stmt> ::= "include_recipe" " " <string> => { includeRecipe($3); }
<attribute-stmt> ::= "node.default" <attr-path> " = " <ruby-expr> => { setNodeAttr($2, $4); }
                 | "node.override" <attr-path> " = " <ruby-expr>
                 | "node.normal" <attr-path> " = " <ruby-expr>
<attr-path> ::= ("[" <string> "]")+
<ruby-expr> ::= <ruby-literal> | <ruby-symbol> | <ruby-identifier> | <ruby-string> | <method-call> | <ruby-expr> " " <binop> " " <ruby-expr> | <ruby-array> | <ruby-hash>
<method-call> ::= <ruby-identifier> "(" <arg-list>? ")" => { buildCall($1, $3); }
               | <ruby-identifier> " " <arg-list>
<arg-list> ::= <ruby-expr>? ("," <ruby-expr>)*
<ruby-array> ::= "[" <ruby-expr>* "]"
<ruby-literal> ::= <number> | <boolean> | "nil"
<boolean> ::= "true" | "false"
<number> ::= /[+-]?[0-9]+(\.[0-9]+)?/
<ruby-string> ::= '"' /[^"\n]*/ '"' | "'" /[^'\n]*/ "'"
<binop> ::= "==" | "!=" | "<" | ">" | "<=" | ">=" | "+" | "-" | "*" | "/" | "&&" | "||"
<ruby-identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<attr-key> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<string> ::= /'[^'\n]*'/ | /"[^"\n]*"/
