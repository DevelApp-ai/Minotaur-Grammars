Grammar: Dockerfile
FormatType: EBNF
TokenSplitter: Space

# Dockerfile grammar - core subset
<file> ::= <instruction>* => { buildDockerfile($1); }
<instruction> ::= <from-instr> | <run-instr> | <cmd-instr> | <entrypoint-instr> | <env-instr> | <arg-instr> | <label-instr> | <copy-instr> | <add-instr> | <expose-instr> | <volume-instr> | <user-instr> | <workdir-instr> | <onbuild-instr> | <stopsignal-instr> | <healthcheck-instr> | <shell-instr> | <maintainer-instr> | <comment>
<comment> ::= "#" /[\S\s]*/ => { skip(); }
<from-instr> ::= "FROM" <image-ref> ("AS" <stage-name>)? => { addStage($2, $4); }
             | "FROM" <image-ref> "AS" <stage-name>
<image-ref> ::= <image-name> (":" <tag> | "@" <digest>)? => { buildImageRef($1, $3, $5); }
<image-name> ::= /[a-zA-Z0-9._\/:-]+/
<tag> ::= /[a-zA-Z0-9_.-]+/
<digest> ::= /sha256:[a-f0-9]{64}/
<stage-name> ::= /[a-zA-Z][a-zA-Z0-9_-]*/
<run-instr> ::= "RUN" <shell-form> => { addRun($2); }
            | "RUN" <exec-form> => { addRunExec($2); }
            | "RUN" <param> <shell-form> => { addRunWithMount($2, $3); }
<cmd-instr> ::= "CMD" <shell-form> => { addCmd($2); }
            | "CMD" <exec-form> => { addCmdExec($2); }
<entrypoint-instr> ::= "ENTRYPOINT" <shell-form> => { addEntrypoint($2); }
                   | "ENTRYPOINT" <exec-form> => { addEntrypointExec($2); }
<shell-form> ::= /[\S\s]+/ => { parseShellForm($1); }
<exec-form> ::= "[" <json-string>? ("," <json-string>)* "]" => { parseExecForm($2); }
<json-string> ::= /"(\\.|[^"\\])*"/
<env-instr> ::= "ENV" <env-space> | "ENV" <env-equals> => { addEnv($2); }
<env-space> ::= <env-key> <env-space-value> => { addEnvPair($1, $2); }
<env-equals> ::= <env-pair>+
<env-pair> ::= <env-key> "=" <json-string>
<env-key> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<env-space-value> ::= /[\S\s]+/
<arg-instr> ::= "ARG" <arg-name> ("=" <default-value>)? => { addArg($2, $4); }
<arg-name> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<default-value> ::= <json-string> | /[\S]+/
<label-instr> ::= "LABEL" <label-pair>+ =>
 { addLabels($2); }
<label-pair> ::= <label-key> "=" <json-string> => { addLabel($1, $3); }
<label-key> ::= /[a-zA-Z0-9._-]+/
<copy-instr> ::= "COPY" <param>* <src> (" " <src>)* <dst> => { addCopy($3, $4, $6); }
             | "COPY" "--from=" <stage-ref> <src>+ <dst> => { addCopyFromStage($3, $4, $6); }
<param> ::= /--[a-z-]+(=[^ ]+)?/
<src> ::= /[\S]+/
<dst> ::= /[\S]+/
<stage-ref> ::= <stage-name> | <number>
<add-instr> ::= "ADD" <param>* <src>+ <dst>
<expose-instr> ::= "EXPOSE" <port-proto>+ => { addExpose($2); }
<port-proto> ::= <port> ("/" <protocol>)? => { addPort($1, $3); }
<port> ::= /[0-9]+/
<protocol> ::= "tcp" | "udp"
<volume-instr> ::= "VOLUME" <json-array> | "VOLUME" <path>+ => { addVolume($2); }
<json-array> ::= "[" <json-string>* "]"
<path> ::= /[\S]+/
<user-instr> ::= "USER" <user-spec> => { setUser($2); }
<user-spec> ::= /[a-zA-Z0-9_-]+(:[0-9]+)?/
<workdir-instr> ::= "WORKDIR" <path> => { setWorkdir($2); }
<onbuild-instr> ::= "ONBUILD" <instruction> => { addOnbuild($2); }
<stopsignal-instr> ::= "STOPSIGNAL" <signal> => { setStopSignal($2); }
<signal> ::= /SIG[A-Z]+/ | /[0-9]+/
<healthcheck-instr> ::= "HEALTHCHECK" ("NONE" | <healthcheck-args>) => { setHealthcheck($2); }
<healthcheck-args> ::= <hc-flag>* "CMD" ("--interval=" <duration> | "--timeout=" <duration> | "--start-period=" <duration> | "--retries=" <number> | "CMD")* <shell-form>
<hc-flag> ::= /--(interval|timeout|start-period|start-interval)=[0-9]+[smh]/ | /--retries=[0-9]+/
<duration> ::= /[0-9]+[smh]/
<shell-instr> ::= "SHELL" <exec-form> => { setShell($2); }
<maintainer-instr> ::= "MAINTAINER" <free-text> => { setMaintainer($2); }
<free-text> ::= /[\S\s]+/
<number> ::= /[0-9]+/

# --- Extended coverage: additional language constructs ---
<stage_build> ::= "FROM" <image> "AS" <stage> ;
<copy_from> ::= "COPY" "--from=" <stage> <src>+ <dst> ;
<healthcheck> ::= "HEALTHCHECK" ("NONE" | ("--interval=" <duration>)? ("--timeout=" <duration>)? ("--retries=" <number>)? <cmd>) ;
<arg_decl> ::= "ARG" <identifier> ("=" <text>)? ;
<onbuild> ::= "ONBUILD" <instruction> ;
<stopsignal> ::= "STOPSIGNAL" <signal> ;
<shell_form> ::= "SHELL" [ <text> ("," <text>)* ] ;
<run_network> ::= "RUN" "--network=" <mode> <cmd> ;
<run_mount> ::= "RUN" "--mount=type=" <text> ("," <text>)* <cmd> ;
<add_url> ::= "ADD" <url> <dst> ;
