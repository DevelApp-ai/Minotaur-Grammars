Grammar: HCL2
FormatType: EBNF

<config> ::= <block>*
<block> ::= <identifier> <label>* "{" <body> "}"
<label> ::= <string> | <identifier>
<body> ::= <attribute> | <block>
<attribute> ::= <identifier> "=" <expr>
<expr> ::= <string> | <number> | <identifier> | <list> | <object> | <var> | <func-call>
<list> ::= "[" <expr> ("," <expr>)* "]"
<object> ::= "{" (<identifier> "=" <expr> ("," | ))* "}"
<func-call> ::= <identifier> "(" <expr>? ("," <expr>)* ")"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   HCL 2: ws, # // and /* */ comments, strings with ${} interpolation, heredocs <<EOF, numbers, identifiers, = { } [ ] ( ) , . : ? operators. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<heredoc> ::= /<<-?[A-Za-z_][A-Za-z0-9_]*/
<string> ::= /"([^"\\\n]|\\.)*"/
<var> ::= /\$(\{[^}\n]*\}|[a-zA-Z_][a-zA-Z0-9_]*)/
<number> ::= /[+-]?[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?/
<identifier> ::= /[A-Za-z_][A-Za-z0-9_-]*/
<op> ::= /\.\.\.|\{|\}|\[|\]|\(|\)|\.|\?|=>|\*|\\|=|,|:|"|'/
