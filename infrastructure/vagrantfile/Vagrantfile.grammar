Grammar: Vagrantfile
FormatType: EBNF
TokenSplitter: Space

# Vagrantfile grammar - core subset
<file> ::= <statement>* => { buildVagrantfile($1); }
<statement> ::= <config-stmt> | <define-block> | <vm-block> | <ruby-assignment> | <if-stmt>
<config-stmt> ::= "Vagrant.configure(" <version> ")" " |" <ruby-params> "|" <statement>* "end" => { buildConfig($3, $4, $6); }
<version> ::= /"2"/ | /[0-9]+/
<ruby-params> ::= "config" | <ruby-identifier>
<vm-block> ::= <params> ".vm." <vm-attr> => { setVmAttr($1, $3); }
           | <params> ".vm." <vm-method> => { setVmAttr($1, $3); }
<vm-attr> ::= "box" " = " <string> => { setBox($3); }
           | "hostname" " = " <string>
           | "box_version" " = " <string>
           | "box_check_update" " = " <boolean>
           | "synced_folder" " " <string> "," <string> <synced-opts>? => { addSyncedFolder($3, $5, $6); }
           | "network" " " <network-type> <network-args>? => { addNetwork($3, $4); }
           | "provision" " " <provision-type> <provision-opts>? => { addProvisioner($3, $4); }
           | "disk" ":disk" "," <provision-opts> => { addDisk($3); }
           | "usable_port_range" " = " <ruby-range>
<network-type> ::= ":forwarded_port" | ":private_network" | ":public_network" | ":hyperv"
<network-args> ::= "," <kwarg>+
<kwarg> ::= <kw> ":" <ruby-value> => { addKwarg($1, $3); }
<kw> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<provision-type> ::= ":shell" | ":ansible" | ":chef_solo" | ":chef_zero" | ":puppet" | ":file" | ":docker" | ":podman" | ":salt" | ":cfengine"
<provision-opts> ::= "," <kwarg>+ | "do" | "|" <ruby-identifier> "|" <provision-body> "end"
<provision-body> ::= <provision-stmt>*
<provision-stmt> ::= <ruby-identifier> " = " <ruby-value> => { setProvisionerOpt($1, $3); }
                  | <ruby-identifier> " " <ruby-value>
<params> ::= "config" | <ruby-identifier> ("." <ruby-identifier>)*
<define-block> ::= <params> ".vm.define" " " <string> <define-opts>? "do" " |" <ruby-identifier> "|" <statement>* "end" => { defineMachine($3, $7); }
<define-opts> ::= "," <kwarg>+
<provider-block> ::= <params> ".vm.provider" " " <string> "do" " |" <ruby-identifier> "|" <statement>* "end" => { configureProvider($3, $7); }
<if-stmt> ::= "if" <ruby-expr> <statement>* "end"
<ruby-assignment> ::= <ruby-identifier> " = " <ruby-value>
<ruby-expr> ::= <ruby-value> " " <binop> " " <ruby-value> | <ruby-value>
<ruby-value> ::= <string> | <number> | <boolean> | <ruby-symbol> | <ruby-identifier> | <ruby-array>
<ruby-range> ::= <number> ".." <number>
<ruby-symbol> ::= ":" <ruby-identifier>
<ruby-array> ::= "[" <ruby-value>* "]"
<binop> ::= "==" | "!=" | "<" | ">" | "&&" | "||"
<boolean> ::= "true" | "false"
<number> ::= /[0-9]+/
<string> ::= /"[^"\n]*"/ | /'[^'\n]*'/
<ruby-identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
