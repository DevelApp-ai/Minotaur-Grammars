Grammar: Ninja
FormatType: EBNF

<file> ::= <stmt>*
<stmt> ::= <rule> | <build> | <default> | <var-decl> | <include>
<rule> ::= "rule" <identifier> <indent-block>
<build> ::= "build" <outputs> ":" <identifier> <inputs>? <order-deps>?
<outputs> ::= <path> (" " <path>)*
<inputs> ::= <path> (" " <path>)*
<order-deps> ::= "||" <path> (" " <path>)*
<default> ::= "default" <path> (" " <path>)*
<var-decl> ::= <identifier> "=" <value>
<include> ::= "include" <path>
<indent-block> ::= <var-decl>*
<value> ::= <string> | <var-ref> | <path>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   Ninja build file: ws (indentation is structural but lexing skips it), # comments, strings, $var/${var} references, rule/build/pool/default. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<var-ref> ::= /\$(\{[^}\n]*\}|[a-zA-Z_][a-zA-Z0-9_]*)/
<number> ::= /[+-]?[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?/
<path> ::= /[A-Za-z0-9_./-]+/
<identifier> ::= /[A-Za-z_][A-Za-z0-9_]*/
<op> ::= /\|\||\||\$|=|:/
