# --- Coverage completion: remaining language constructs ---
function_def ::= "function" qualified "(" params? ")" "{" stmt* "}" ;
class_inherit ::= "class" qualified "inherits" qualified "{" stmt* "}" ;
resource_override ::= type "[" text "]" "{" pair* "}" ;
unless_stmt ::= "unless" expr "{" stmt* "}" ;
each_stmt ::= expr "." "each" "|" params "|" "{" stmt* "}" ;
chained_arrow ::= resource ("~>" | "->") resource ;
site_def ::= "site" "{" stmt* "}" ;
apply_def ::= "apply" expr "{" stmt* "}" ;
