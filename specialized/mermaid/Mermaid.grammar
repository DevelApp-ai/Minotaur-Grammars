# --- Coverage completion: remaining language constructs ---

timeline_diagram ::= "timeline" timeline_section+ ;
timeline_section ::= [ title_line ] timeline_event+ ;
quadrant_chart ::= "quadrantChart" chart_axis+ quadrant_point* ;
chart_axis ::= ( "x-axis" | "y-axis" ) label "-->" label ;
mindmap_diagram ::= "mindmap" mindmap_node+ ;
mindmap_node ::= indent node_shape ;
requirement_diagram ::= "requirementDiagram" requirement_element+ ;
requirement_element ::= ( requirement_block | element_block | relationship ) ;
