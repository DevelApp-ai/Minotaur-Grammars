Grammar: Xsd10
FormatType: EBNF
TokenSplitter: Space

<schema> ::= '<schema' <schema_attrs>? '>' <definition>* '</schema>' ;
<definition> ::= <element_def> | <complexType> | <simpleType> | <group_def> | <attributeGroup> | <annotation> | <include> | <import> | <redefine> | <notation> ;
<element_def> ::= '<element' <element_attrs> '/>' | '<element' <element_attrs> '>' <element_content>* '</element>' ;
<element_content> ::= <complexType> | <simpleType> | <key> | <keyref> | <unique> | <annotation> ;
<complexType> ::= '<complexType' <type_attrs>? '>' <type_content>* '</complexType>' ;
<type_content> ::= <simple_content> | <complex_content> | <group_ref> | <all> | <choice> | <sequence> | <attribute> | <attribute_group_ref> | <any_attribute> | <annotation> ;
<simple_content> ::= '<simpleContent>' ( <restriction> | <extension> ) '</simpleContent>' ;
<complex_content> ::= '<complexContent>' ( <restriction> | <extension> ) '</complexContent>' ;
<restriction> ::= '<restriction' <restriction_attrs>? '>' <restriction_content>* '</restriction>' ;
<restriction_content> ::= <facet> | <particle> | <attribute> | <attribute_group_ref> | <any_attribute> | <annotation> ;
<extension> ::= '<extension' <extension_attrs>? '>' <extension_content>* '</extension>' ;
<extension_content> ::= <particle> | <attribute> | <attribute_group_ref> | <any_attribute> | <annotation> ;
<particle> ::= <element_def> | <group_ref> | <all> | <choice> | <sequence> | <any> ;
<sequence> ::= '<sequence' <occurrence_attrs>?>' <particle>* '</sequence>' ;
<choice> ::= '<choice' <occurrence_attrs>?>' <particle>* '</choice>' ;
<all> ::= '<all' <occurrence_attrs>?>' <element_def>* '</all>' ;
<any> ::= '<any' <any_attrs> '/>' ;
<any_attribute> ::= '<anyAttribute' <any_attrs> '/>' ;
<group_def> ::= '<group' <name_attr> '>' ( <all> | <choice> | <sequence> ) '</group>' ;
<group_ref> ::= '<group' <ref_attr> <occurrence_attrs>?>'/>' ;
<attribute> ::= '<attribute' <attribute_attrs> '/>' | '<attribute' <attribute_attrs> '>' <simple_type_inline> '</attribute>' ;
<attribute_group_ref> ::= '<attributeGroup' <ref_attr> '/>' ;
<attributeGroup> ::= '<attributeGroup' <name_attr> '>' ( <attribute> | <attribute_group_ref> | <any_attribute> )* '</attributeGroup>' ;
<simpleType> ::= '<simpleType' <name_attr> '>' ( <restriction> | <list> | <union_type> ) '</simpleType>' ;
<simple_type_inline> ::= <simpleType> | <restriction> | <list> | <union_type> | <annotation> ;
<list> ::= '<list' <list_attrs>? '>' <simple_type_inline>* '</list>' ;
<union_type> ::= '<union' <union_attrs>? '>' <simple_type_inline>* '</union>' ;
<facet> ::= '<minInclusive' <value_attr> '/>' | '<minExclusive' <value_attr> '/>' | '<maxInclusive' <value_attr> '/>' | '<maxExclusive' <value_attr> '/>' | '<length' <value_attr> '/>' | '<minLength' <value_attr> '/>' | '<maxLength' <value_attr> '/>' | '<pattern' <value_attr> '/>' | '<enumeration' <value_attr> '/>' | '<whiteSpace' <value_attr> '/>' | '<totalDigits' <value_attr> '/>' | '<fractionDigits' <value_attr> '/>' ;
<key> ::= '<key' <name_attr> '>' <selector> <field>+ '</key>' ;
<keyref> ::= '<keyref' <name_attr> <ref_attr> '>' <selector> <field>+ '</keyref>' ;
<unique> ::= '<unique' <name_attr> '>' <selector> <field>+ '</unique>' ;
<selector> ::= '<selector' <xpath_attr> '/>' ;
<field> ::= '<field' <xpath_attr> '/>' ;
<annotation> ::= '<annotation>' ( <documentation> | <appinfo> )* '</annotation>' ;
<documentation> ::= '<documentation>' <auto_text_1> '</documentation>' ;
<appinfo> ::= '<appinfo>' <auto_text_1> '</appinfo>' ;
<include> ::= '<include' <schema_location_attr> '/>' ;
<import> ::= '<import' <import_attrs>? '/>' ;
<redefine> ::= '<redefine' <schema_location_attr> '>' <definition>* '</redefine>' ;
<notation> ::= '<notation' <notation_attrs> '/>' ;

<schema_attrs> ::= <target_ns_attr>? <version_attr>? <element_form_attr>? <attribute_form_attr>? <lang_attr>? ;
<element_attrs> ::= <name_attr> <type_attr>? <ref_attr>? <substitution_group_attr>? <default_attr>? <fixed_attr>? <nillable_attr>? <occurrence_attrs>? ;
<type_attrs> ::= <name_attr>? <mixed_attr>? <abstract_attr>? <base_attr>? ;
<restriction_attrs> ::= <base_attr> ;
<extension_attrs> ::= <base_attr> ;
<any_attrs> ::= <namespace_attr>? <process_contents_attr>? ;
<attribute_attrs> ::= <name_attr> <type_attr>? <ref_attr>? <use_attr>? <default_attr>? <fixed_attr>? ;
<list_attrs> ::= <item_type_attr>? ;
<union_attrs> ::= <member_types_attr>? ;
<occurrence_attrs> ::= <min_occurs_attr>? <max_occurs_attr>? ;
<import_attrs> ::= <namespace_attr>? <schema_location_attr>? ;
<notation_attrs> ::= <name_attr> <public_attr>? <system_attr>? ;
<name_attr> ::= 'name=' <auto_qname_2> ;
<type_attr> ::= 'type=' <auto_qname_2> ;
<ref_attr> ::= 'ref=' <auto_qname_2> ;
<base_attr> ::= 'base=' <auto_qname_2> ;
<item_type_attr> ::= 'itemType=' <auto_qname_2> ;
<member_types_attr> ::= 'memberTypes=' <auto_qname_list_3> ;
<substitution_group_attr> ::= 'substitutionGroup=' <auto_qname_2> ;
<target_ns_attr> ::= 'targetNamespace=' <auto_uri_4> ;
<version_attr> ::= 'version=' <auto_text_1> ;
<element_form_attr> ::= 'elementFormDefault=' <form_value> ;
<attribute_form_attr> ::= 'attributeFormDefault=' <form_value> ;
<form_value> ::= 'qualified' | 'unqualified' ;
<lang_attr> ::= 'xml:lang=' <auto_text_1> ;
<mixed_attr> ::= 'mixed=' <boolean_value> ;
<abstract_attr> ::= 'abstract=' <boolean_value> ;
<nillable_attr> ::= 'nillable=' <boolean_value> ;
<default_attr> ::= 'default=' <auto_text_1> ;
<fixed_attr> ::= 'fixed=' <auto_text_1> ;
<use_attr> ::= 'use=' <use_value> ;
<use_value> ::= 'optional' | 'prohibited' | 'required' ;
<min_occurs_attr> ::= 'minOccurs=' <auto_number_5> ;
<max_occurs_attr> ::= 'maxOccurs=' <auto_number_5> ;
<namespace_attr> ::= 'namespace=' <auto_uri_4> ;
<process_contents_attr> ::= 'processContents=' <process_value> ;
<process_value> ::= 'lax' | 'skip' | 'strict' ;
<schema_location_attr> ::= 'schemaLocation=' <auto_uri_4> ;
<public_attr> ::= 'public=' <auto_uri_4> ;
<system_attr> ::= 'system=' <auto_uri_4> ;
<value_attr> ::= 'value=' <auto_text_1> ;
<xpath_attr> ::= 'xpath=' <auto_text_1> ;
<boolean_value> ::= 'true' | 'false' | '1' | '0' ;

<auto_text_1> ::= /[^\n>]*/ ;
<auto_qname_2> ::= /"?[A-Za-z_][A-Za-z0-9_.-]*(:[A-Za-z_][A-Za-z0-9_.-]*)?"?/ ;
<auto_qname_list_3> ::= /"?[A-Za-z_][A-Za-z0-9_.-]*(:[A-Za-z_][A-Za-z0-9_.-]*)?( +[A-Za-z_][A-Za-z0-9_.-]*(:[A-Za-z_][A-Za-z0-9_.-]*)*)*"?/ ;
<auto_uri_4> ::= /"?[^">\n]+"?/ ;
<auto_number_5> ::= /[0-9]+/ ;
