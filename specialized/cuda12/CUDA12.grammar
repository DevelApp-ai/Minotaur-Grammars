Grammar: CUDA12
FormatType: EBNF

<translation-unit> ::= <decl>*
<decl> ::= <func> | <kernel> | <var-decl> | <class-def> | <template> | <using>
<using> ::= "using" <name> ";"
<template> ::= "template" "<" <params> ">" <decl>
<params> ::= <param> ("," <param>)*
<param> ::= "typename" <name> | <type> <name>
<class-def> ::= "class" <name> ("{" <member>* "}")? ";"
<member> ::= ("public" | "private")? <type>? <name> ("(" <args>? ")")? (";" | <block>)
<func> ::= <type>? <name> "(" <args>? ")" <qual>* <block>
<kernel> ::= "__global__" <type> <name> "(" <args>? ")" <block>
<qual> ::= "const" | "noexcept" | "override"
<var-decl> ::= <type> <name> ("=" <expr>)? ";"
<type> ::= ("__device__" | "__host__" | "__shared__")? <name> ("<" <type> ("," <type>)* ">")? ("*")* ("[" <expr>? "]")* | "void"
<block> ::= "{" <stmt>* "}"
<stmt> ::= <var-decl> | <if> | <for> | <while> | <return> | <assign> | <launch> | <expr> ";" | <block>
<launch> ::= <name> "<<<" <grid> "," <block-sz> ">>>" "(" <args>? ")" ";"
<grid> ::= <expr> | "(" <expr> "," <expr> ")"
<block-sz> ::= <expr> | "(" <expr> "," <expr> ")"
<if> ::= "if" "(" <expr> ")" <stmt> ("else" <stmt>)?
<for> ::= "for" "(" <stmt> <expr>? ";" <expr>? ")" <stmt>
<while> ::= "while" "(" <expr> ")" <stmt>
<return> ::= "return" <expr>? ";"
<assign> ::= <lvalue> ("=" | "+=" | "-=" | "*=" | "/=") <expr> ";"
<lvalue> ::= <name> ("." <name> | "[" <expr> "]" | "->" <name> | "(" <args> ")")*
<name> ::= <identifier>
<args> ::= <expr> ("," <expr>)*
<expr> ::= <ternary>
<ternary> ::= <or> ("?" <expr> ":" <expr>)?
<or> ::= <and> ("||" <and>)*
<and> ::= <bit> ("&&" <bit>)*
<bit> ::= <eq> (("&" | "|" | "^") <eq>)*
<eq> ::= <rel> (("==" | "!=") <rel>)*
<rel> ::= <shift> (("<" | "<=" | ">" | ">=") <shift>)*
<shift> ::= <add> (("<<" | ">>" | "<<<" | ">>>") <add>)*
<add> ::= <mul> (("+" | "-") <mul>)*
<mul> ::= <unary> (("*" | "/" | "%" | "**") <unary>)*
<unary> ::= ("-" | "+" | "!" | "~")? <postfix>
<postfix> ::= <primary> ("(" <args>? ")" | "." <name> | "[" <expr> "]" | "++" | "--")*
<primary> ::= <name> | <number> | <string> | <raw-string> | "(" <expr> ")" | "true" | "false"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   CUDA 12 (C++-based): ws, // and /* */ comments, strings incl raw R"()", kernel launch <<<>>>, numbers, C++ operators. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<comment> ::= /\x2F\*([^*]|\*+[^*\x2F])*\*+\x2F/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /0[xX][0-9a-fA-F]+[uUlL]*|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[fFlLuU]*/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<raw-string> ::= /R"([^"\\]|\\.)*"/
<op> ::= /\x2F=|\|\||\+\+|\*\*|\x2F|<<<|>>>|\+=|\*=|<<=|>>=|::|->|=>|==|!=|<=|>=|&&|--|-=|%=|<<|>>|\+|\*|\||\^|\?|\(|\)|\[|\]|\{|\}|\.|\$|\\|-|%|&|~|!|<|>|=|:|,|;|#|"|'/
