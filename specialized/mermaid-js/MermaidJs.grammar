Grammar: MermaidJs
FormatType: EBNF
TokenSplitter: Space

diagram   ::= flowchart | sequence_diagram | class_diagram | state_diagram ;
flowchart ::= 'flowchart' 'TD' | 'flowchart' 'LR' flowchart_body ;
flowchart_body ::= flow_stmt (';'? flow_stmt)* ;
flow_stmt ::= node_decl | edge ;
node_decl ::= node_id ('[' text ']' | '(' text ')' | '{' text '}' | '([' text '])')? ;
node_id   ::= identifier ;
edge     ::= node_id edge_op node_id ;
edge_op  ::= '-->' | '---' | '-.->' | '==>' | '--' text '-->' ;
sequence_diagram ::= 'sequenceDiagram' seq_stmt+ ;
seq_stmt ::= participant | message | activation ;
participant ::= 'participant' identifier 'as' text ;
message  ::= identifier arrow identifier ':' text ;
arrow    ::= '->>' | '-->> | '-)' | '--)' ;
activation ::= ('activate'|'deactivate') identifier ;
class_diagram ::= 'classDiagram' class_stmt+ ;
class_stmt ::= class_def | relation ;
class_def ::= 'class' identifier '{' member* '}' ;
member   ::= (visibility)? identifier '(' ')' identifier? ;
visibility ::= '+' | '-' | '#' ;
relation ::= identifier ('<|--'|'-->|'|'*--'|'o--'|'<|--') identifier ;
state_diagram ::= 'stateDiagram-v2' state_stmt+ ;
state_stmt ::= transition | state_def ;
transition ::= identifier '-->' identifier ':' text? ;
state_def ::= 'state' identifier ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text     ::= [^\]}:;]+ ;
number   ::= [0-9]+ ;
