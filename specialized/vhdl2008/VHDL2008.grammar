Grammar: VHDL2008
FormatType: EBNF

<design-file> ::= <design-unit>*
<design-unit> ::= <entity> | <architecture> | <package> | <config>
<entity> ::= "entity" <name> "is" <port-clause>? "end" <name>? ";"
<port-clause> ::= "port" "(" <port-list> ")" ";"
<port-list> ::= <name-list> ":" ("in" | "out" | "inout") <type> (";" <name-list> ":" ("in" | "out") <type>)*
<name-list> ::= <name> ("," <name>)*
<name> ::= <identifier>
<type> ::= <name> ("(" <expr> ("to" | "downto") <expr> ")")?
<architecture> ::= "architecture" <name> "of" <name> "is" <decl>* "begin" <stmt>* "end" <name>? ";"
<package> ::= "package" <name> "is" <decl>* "end" <name>? ";"
<config> ::= "configuration" <name> "of" <name> "is" <decl>* "end" <name>? ";"
<decl> ::= <signal-decl> | <var-decl> | <const-decl> | "use" <name-list> ";"
<signal-decl> ::= "signal" <name-list> ":" <type> (":=" <expr>)? ";"
<var-decl> ::= "variable" <name-list> ":" <type> (":=" <expr>)? ";"
<const-decl> ::= "constant" <name-list> ":" <type> ":=" <expr> ";"
<stmt> ::= <assign> | <if> | <case> | <loop> | <wait> | <call> ";" | <name> ";"
<assign> ::= <lvalue> ("<=" | ":=") <expr> ";"
<lvalue> ::= <name> ("(" <expr> ")" | "." <name>)*
<if> ::= "if" <expr> "then" <stmt>* ("elsif" <expr> "then" <stmt>)* ("else" <stmt>*)? "end" "if" ";"
<case> ::= "case" <expr> "is" ("when" <choice> ("|" <choice>)* "=>" <stmt>)+ "end" "case" ";"
<choice> ::= <expr> | <expr> "to" <expr> | "others"
<loop> ::= ("for" <name> "in" <expr> ("to" | "downto") <expr>)? "loop" <stmt>* "end" "loop" ";" | "while" <expr> "loop" <stmt>* "end" "loop" ";"
<wait> ::= "wait" ("until" <expr>)? ";"
<call> ::= <name> ("(" <args> ")")?
<args> ::= <expr> ("," <expr>)*
<expr> ::= <or>
<or> ::= <and> ("or" <and>)*
<and> ::= <not> ("and" <not>)*
<not> ::= "not" <not> | <rel>
<rel> ::= <add> (("=" | "/=" | "<" | "<=" | ">" | ">=") <add>)?
<add> ::= <mul> (("+" | "-" | "&") <mul>)*
<mul> ::= <unary> (("*" | "/" | "mod" | "rem" | "**") <unary>)*
<unary> ::= ("-" | "+" | "abs")? <primary>
<primary> ::= <name> ("(" <args> ")")? | <number> | <string> | <bitlit> | "(" <expr> ")" | "true" | "false" | <name> Q <name>

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   VHDL-2008: ws, -- comments, double-quoted strings with doubling, bit/char literals, based literals, identifiers, operators. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /--[^\n]*/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[0-9][0-9_]*#[0-9a-fA-F_]+#|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<string> ::= /"([^"]|"")*"/
<bitlit> ::= /'[01xzXZ]'/
<op> ::= /\x2F=|\*\*|\x2F|:=|<=|>=|=>|<>|<<|>>|\+|\*|\||\^|\(|\)|\[|\]|\.|\\|<|>|=|-|&|:|;|,|@|'|"/
