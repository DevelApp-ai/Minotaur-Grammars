Grammar: LaTeX
FormatType: EBNF
TokenSplitter: Space

document ::= preamble body ;
preamble ::= preamble_cmd* ;
preamble_cmd ::= document_class | use_package | new_command ;
document_class ::= '\\documentclass' ('[' options ']')? '{' identifier '}' ;
use_package ::= '\\usepackage' ('[' options ']')? '{' identifier '}' ;
new_command ::= '\\newcommand' '{' '\\' identifier '}' '[' number ']' '{' content '}' ;
options   ::= option (',' option)* ;
option    ::= identifier | identifier '=' identifier ;
body      ::= '\\begin' '{' 'document' '}' content '\\end' '{' 'document' '}' ;
content   ::= element* ;
element   ::= command | environment | text | math | comment | group ;
command   ::= '\\' identifier ('[' options ']')? ('{' content '}')* ;
environment ::= '\\begin' '{' identifier '}' ('[' options ']')? content '\\end' '{' identifier '}' ;
math    ::= '$' [^$]* '$' | '$$' [^$]* '$$' ;
comment ::= '%' [^\n]* ;
group   ::= '{' content '}' ;
text    ::= [^\n\{}$%\\]+ ;
identifier ::= [a-zA-Z@]+ ;
number  ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
heading_cmd ::= ('\\section' | '\\subsection' | '\\chapter' | '\\part') '*'? '{' content '}' ; ;
tabular_env ::= '\\begin' '{' 'tabular' '}' '{' col_spec '}' row* '\\end' '{' 'tabular' '}' ; ;
col_spec ::= ('l' | 'c' | 'r' | 'p' '{' text '}' | '|' | '@' text)+ ; ;
table_row ::= element ('&' element)* '\\\\' ; ;
figure_env ::= '\\begin' '{' 'figure' '}' '[' identifier ']' '\\includegraphics' ('[' options ']')? '{' text '}' '\\caption' '{' content '}' '\\end' '{' 'figure' '}' ; ;
label_cmd ::= '\\label' '{' text '}' ; ;
ref_cmd ::= ('\\ref' | '\\eqref' | '\\pageref' | '\\autoref') '{' text '}' ; ;
cite_cmd ::= '\\cite' ('[' options ']')? '{' text '}' ; ;
verbatim_env ::= '\\begin' '{' 'verbatim' '}' [^\\]* '\\end' '{' 'verbatim' '}' ; ;
bibliography_cmd ::= '\\bibliography' '{' text '}' | '\\bibliographystyle' '{' identifier '}' ; ;
newtheorem_cmd ::= '\\newtheorem' '{' identifier '}' '{' text '}' ; ;
