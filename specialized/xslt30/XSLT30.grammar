Grammar: XSLT30
FormatType: EBNF

<stylesheet> ::= <top>*
<top> ::= <template> | <var> | <param> | <func> | <text>
<template> ::= "<xsl:template" <attr>* ">" <content>* "</xsl:template>"
<var> ::= "<xsl:variable" <attr>* ("/>" | ">" <content>* "</xsl:variable>")
<param> ::= "<xsl:param" <attr>* ("/>" | ">" <content>* "</xsl:param>")
<func> ::= "<xsl:function" <attr>* ">" <param>* <content>* "</xsl:function>"
<attr> ::= <name> "=" <qstring>
<qstring> ::= <string>
<content> ::= <text> | <element> | <if> | <choose> | <for-each> | <value-of> | <var-ref>
<element> ::= "<" <name> <attr>* ("/>" | ">" <content>* "</" <name> ">")
<if> ::= "<xsl:if" <attr> ">" <content>* "</xsl:if>"
<choose> ::= "<xsl:choose>" ("<xsl:when" <attr> ">" <content>* "</xsl:when>")+ ("<xsl:otherwise>" <content>* "</xsl:otherwise>")? "</xsl:choose>"
<for-each> ::= "<xsl:for-each" <attr> ">" <content>* "</xsl:for-each>"
<value-of> ::= "<xsl:value-of" <attr>* "/>"
<var-ref> ::= "{" <expr> "}"
<expr> ::= <name> ("[" <expr> "]" | "/" <name> | "|" <name> | "(" <args> ")")*
<args> ::= <expr> ("," <expr>)*
<text> ::= <identifier> | <number>
<number> ::= /[0-9]+(' + BS + 'x2E[0-9]+)?/

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   XSLT 3.0 (XML-based): ws, <!-- --> comments, single/double-quoted strings and attribute values, XPath tokens, tags. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /\x3C\x21\x2D\x2D([^-]|\x2D[^-])*\x2D\x2D\x3E/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?[a-zA-Z]?)/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_.:-]*/
<op> ::= /\x2F|\{|\}|\[|\]|\(|\)|\.|\$|\?|\||\+|\*|\\|=|<|>|,|;|:|@|!|-|#|'|"/
