Grammar: AsciiDoc
FormatType: EBNF
TokenSplitter: Space

document ::= header? block* ;
header   ::= '=' text (attr_line)* ;
attr_line ::= ':' identifier ':' text? ;
block    ::= section | paragraph | listing | list | admonition | table ;
section  ::= '='+ text ;
paragraph ::= inline+ ;
listing  ::= '---' [^---]* '---' ;
list     ::= bullet_item+ | ordered_item+ ;
bullet_item ::= ('*'|'-') inline ;
ordered_item ::= number '.' inline ;
admonition ::= ('NOTE:' | 'TIP:' | 'WARNING:' | 'IMPORTANT:' | 'CAUTION:') inline ;
table   ::= '|===' table_row* '|===' ;
table_row ::= [^\n]+ ;
inline  ::= text | bold | italic | mono | link | xref ;
bold    ::= '*' text '*' ;
italic  ::= '_' text '_' ;
mono    ::= '`' text '`' ;
link    ::= 'link:' text '[' text? ']' ;
xref    ::= '<<' text ','? text? '>>' ;
text    ::= [^\n=*_-`<>|]+ ;
identifier ::= [a-zA-Z0-9_-]+ ;
number  ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
include_dir ::= 'include::' text '[' attrs_inline? ']' ; ;
attrs_inline ::= identifier '=' text (',' identifier '=' text)* ; ;
attr_ref ::= '{' identifier '}' ; ;
example_block ::= '====' [^=]* '====' ; ;
sidebar_block ::= '****' [^*]* '****' ; ;
anchor_def ::= '[[' identifier ','? text? ']]' ; ;
xref_angle ::= '<<' identifier ','? text? '>>' ; ;
callout ::= '<' number '>' ; ;
quoted_pass ::= 'pass' ':' '[' [^\]]* ']' ; ;
