Grammar: AsciiDoc
FormatType: EBNF
TokenSplitter: Space

document ::= header? block* ;
header   ::= '=' text (attr_line)* ;
attr_line ::= ':' identifier ':' text? ;
block    ::= section | paragraph | listing | list | admonition | table ;
section  ::= '='+ text ;
paragraph ::= inline+ ;
listing  ::= '---' [^---]* '---' ;
list     ::= bullet_item+ | ordered_item+ ;
bullet_item ::= ('*'|'-') inline ;
ordered_item ::= number '.' inline ;
admonition ::= ('NOTE:' | 'TIP:' | 'WARNING:' | 'IMPORTANT:' | 'CAUTION:') inline ;
table   ::= '|===' table_row* '|===' ;
table_row ::= [^\n]+ ;
inline  ::= text | bold | italic | mono | link | xref ;
bold    ::= '*' text '*' ;
italic  ::= '_' text '_' ;
mono    ::= '`' text '`' ;
link    ::= 'link:' text '[' text? ']' ;
xref    ::= '<<' text ','? text? '>>' ;
text    ::= [^\n=*_-`<>|]+ ;
identifier ::= [a-zA-Z0-9_-]+ ;
number  ::= [0-9]+ ;
