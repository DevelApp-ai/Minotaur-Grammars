Grammar: Markdown
FormatType: EBNF
TokenSplitter: Space

document ::= block* ;
block    ::= heading | paragraph | code_block | list | blockquote | thematic_break | table ;
heading  ::= hashes text ;
hashes   ::= '#' | '##' | '###' | '####' | '#####' | '######' ;
paragraph ::= inline (inline)* ;
code_block ::= fenced_code | indented_code ;
fenced_code ::= '```' identifier? [^```]* '```' ;
indented_code ::= ('    ' [^\n]*)+ ;
list     ::= list_item+ ;
list_item ::= bullet | ordered_item ;
bullet   ::= ('-' | '*' | '+') inline ;
ordered_item ::= number '.' inline ;
blockquote ::= '> ' [^\n]* ;
thematic_break ::= '---' | '***' ;
table   ::= table_row table_delim table_row* ;
table_row ::= '|' (cell '|')+ ;
cell    ::= inline ;
table_delim ::= '|' (':'? '-'+ ':'? '|')+ ;
inline  ::= text | emphasis | strong | code_span | link | image | [^\n#>*|+-]+ ;
emphasis ::= '*' text '*' ;
strong  ::= '**' text '**' ;
code_span ::= '`' text '`' ;
link    ::= '[' text ']' '(' text ')' ;
image   ::= '!' '[' text ']' '(' text ')' ;
text    ::= [^\n]+ ;
identifier ::= [a-zA-Z0-9+-]* ;
number  ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
setext_heading ::= inline ('=' | '-')+ ; ;
footnote_def ::= '[^' identifier ']:' [^\n]* ; ;
footnote_ref ::= '[^' identifier ']' ; ;
task_item ::= bullet '[' (' ' | 'x' | 'X') ']' inline ; ;
ref_link ::= '[' text ']' '[' identifier ']' ; ;
ref_def ::= '[' identifier ']:' text ('"' text '"')? ; ;
autolink ::= '<' [^>]+ '>' ; ;
escape_seq ::= '\\' [\\`*_{}\[\]()#+.!-] ; ;
html_block ::= '<' identifier [^\n>]* '>' [^<]* ; ;
nested_list ::= ('  ' | '\t') list ; ;
