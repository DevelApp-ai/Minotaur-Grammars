Grammar: Solidity
FormatType: EBNF
TokenSplitter: Space

source_unit ::= pragma? import_stmt* contract_def* ;
pragma   ::= 'pragma' 'solidity' version_spec ';' ;
version_spec ::= [^;]+ ;
import_stmt ::= 'import' text ';' ;
contract_def ::= ('contract'|'abstract' 'contract'|'library'|'interface') identifier ('is' inheritance_list)? '{' member* '}' ;
inheritance_list ::= identifier (',' identifier)* ;
member  ::= state_var | function | modifier_def | event_def | struct_def | enum_def ;
state_var ::= visibility? type identifier ('=' expr)? ';' ;
visibility ::= 'public' | 'private' | 'internal' | 'external' ;
function ::= 'function' identifier '(' params? ')' visibility? mutability? ('returns' '(' params? ')')? (';' | '{' stmt* '}') ;
params  ::= param (',' param)* ;
param   ::= type 'memory'? 'calldata'? 'storage'? identifier? ;
mutability ::= 'pure' | 'view' | 'payable' | 'constant' ;
modifier_def ::= 'modifier' identifier ('(' params? ')')? '{' stmt* '}' ;
event_def ::= 'event' identifier '(' event_params? ')' ';' ;
event_params ::= type 'indexed'? identifier? (',' type 'indexed'? identifier?)* ;
struct_def ::= 'struct' identifier '{' struct_field* '}' ;
struct_field ::= type identifier ';' ;
enum_def ::= 'enum' identifier '{' identifier (',' identifier)* '}' ;
stmt    ::= var_decl | expr_stmt | return_stmt | if_stmt | for_stmt | while_stmt | emit_stmt | revert_stmt ;
var_decl ::= type 'memory'? identifier ('=' expr)? ';' ;
expr_stmt ::= expr ';' ;
return_stmt ::= 'return' expr? ';' ;
if_stmt ::= 'if' '(' expr ')' block ('else' block)? ;
for_stmt ::= 'for' '(' init ';' cond ';' update ')' block ;
init    ::= var_decl | expr_stmt | ';' ;
cond    ::= expr | ';' ;
update  ::= expr | ;
while_stmt ::= 'while' '(' expr ')' block ;
emit_stmt ::= 'emit' identifier '(' args? ')' ';' ;
revert_stmt ::= 'revert' (identifier '(' args? ')')? ';' ;
block   ::= '{' stmt* '}' ;
expr    ::= literal | identifier | call | member | expr binop expr | '(' expr ')' ;
call    ::= expr '(' ar
gs? ')' ;
member  ::= expr '.' identifier ;
args    ::= arg (',' arg)* ;
arg     ::= (identifier '=')? expr ;
type    ::= elementary | 'mapping' '(' type '=>' type ')' | identifier | type '[' ']' ;
elementary ::= 'uint' | 'uint256' | 'int' | 'address' | 'bool' | 'string' | 'bytes' | 'bytes32' ;
literal ::= number | text | boolean ;
boolean ::= 'true' | 'false' ;
binop   ::= '+' | '-' | '*' | '/' | '%' | '==' | '<' | '>' | '<=' | '>=' | '&&' | '||' ;
identifier ::= [a-zA-Z_][a-zA-Z0-9_]* ;
text    ::= '"' [^"]* '"' ;
number  ::= [0-9]+ ;

# --- Extended coverage: additional language constructs ---
receive_fn ::= 'receive' '(' ')' 'external' 'payable' '{' stmt* '}' ; ;
fallback_fn ::= 'fallback' '(' ')' 'external' 'payable'? '{' stmt* '}' ; ;
immutable_var ::= type 'immutable' identifier ';' ; ;
constant_var ::= type 'constant' identifier '=' expr ';' ; ;
using_for ::= 'using' identifier 'for' type 'global'? ';' ; ;
unchecked_block ::= 'unchecked' '{' stmt* '}' ; ;
custom_error ::= 'error' identifier '(' params? ')' ';' ; ;
revert_custom ::= 'revert' identifier '(' args? ')' ';' ; ;
try_stmt ::= 'try' expr ('returns' '(' params? ')')? block ('catch' identifier? '(' params? ')' block)* ; ;
constructor_fn ::= 'constructor' '(' params? ')' modifier_invocation* '{' stmt* '}' ; ;
modifier_invocation ::= identifier ('(' args? ')')? ; ;
interface_def ::= 'interface' identifier ('is' inheritance_list)? '{' function* '}' ; ;
