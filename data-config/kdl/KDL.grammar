Grammar: KDL
FormatType: EBNF

# KDL grammar - core language subset
<file> ::= <node>* => { buildKdl($1); }
<node> ::= <node-terminator> => { addNode($1); }
<node-terminator> ::= <identifier> <entry>* <child-block>? => { buildNode($1, $2, $3); }
<entry> ::= <argument> | <property>
<argument> ::= <value> => { addArgument($1); }
<property> ::= <identifier> "=" <value> => { addProperty($1, $3); }
<child-block> ::= "{" <node>* "}" => { setChildren($2); }
<value> ::= "null" ;
<value> ::= <string> | <number> | <boolean> | <typed-value> ;
<typed-value> ::= "(" <type-id> ")" <value> => { buildTypedValue($2, $4); }
<type-id> ::= /[a-zA-Z0-9-]+/
<string> ::= '"' <char>* '"' | "raw" '"' /[^"]*/ '"' | /#[^\n]+#/
<boolean> ::= "true" | "false"
<char> ::= /[^"\\]/ | "\\" /./ | "\\u{" /[0-9a-fA-F]+/ "}"

# --- Coverage completion: remaining language constructs ---
<slashdash_arg> ::= "/-" <value> ;
<slashdash_children> ::= "/-" "{" <node>* "}" ;
<spread_node> ::= "+" <node> ;
<kw_literal> ::= "true" | "false" | "null" | "inf" | "-inf" | "nan" ;
<esc_char> ::= "\\" ('n' | 't' | 'r' | '"' | '\\' | 's') ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   KDL document */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?)/
<identifier> ::= /[a-zA-Z_$][a-zA-Z0-9_$-]*/
<op> ::= /\.\.\.|\|\||\.\.|\x2F|->|=>|==|!=|<=|>=|&&|::|\.|\+|\*|\?|\(|\)|\[|\]|\{|\}|\||\^|\$|:|;|,|=|-|%|<|>|!|&|~|@/
