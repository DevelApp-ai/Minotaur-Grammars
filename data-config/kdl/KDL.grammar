Grammar: KDL
FormatType: EBNF
TokenSplitter: Space

# KDL grammar - core language subset
<file> ::= <node>* => { buildKdl($1); }
<node> ::= <node-terminator> => { addNode($1); }
<node-terminator> ::= <identifier> <entry>* <child-block>? => { buildNode($1, $2, $3); }
<entry> ::= <argument> | <property>
<argument> ::= <value> => { addArgument($1); }
<property> ::= <identifier> "=" <value> => { addProperty($1, $3); }
<child-block> ::= "{" <node>* "}" => { setChildren($2); }
<value> ::= <string> | <number> | <boolean> | "null" | <typed-value>
<typed-value> ::= "(" <type-id> ")" <value> => { buildTypedValue($2, $4); }
<type-id> ::= /[a-zA-Z0-9-]+/
<string> ::= '"' <char>* '"' | "raw" '"' /[^"]*/ '"' | /#[^\n]+#/
<number> ::= /[+-]?[0-9_]+(\.[0-9_]+)?([eE][+-]?[0-9]+)?/ | /[+-]?0x[0-9a-fA-F_]+/
<boolean> ::= "true" | "false"
<identifier> ::= /\"?[^\"{}\[\]()/=;\n]+\"?/ | /[a-zA-Z_][a-zA-Z0-9_.-]*/
<char> ::= /[^"\\]/ | "\\" /./ | "\\u{" /[0-9a-fA-F]+/ "}"

# --- Extended coverage: additional language constructs ---
<slashdash> ::= "/-" <node> ;
<multiline_string> ::= "\"\"\"" [^"]* "\"\"\"" ;
<raw_string> ::= "r""" [^"]* """ ;
<unicode_escape> ::= "\\u{" [0-9a-fA-F]+ "}" ;
<node_children> ::= <node> "{" <node>* "}" ;
<line_comment> ::= "//" [^\n]* ;
<multiline_comment> ::= "/*" [^*]* "*/" ;
