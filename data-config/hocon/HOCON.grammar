Grammar: HOCON
FormatType: EBNF

# HOCON grammar - core language subset
<file> ::= <root> => { buildHocon($1); }
<root> ::= <object> | <value>*
<object> ::= "{" <field>* "}" => { buildObject($2); }
<field> ::= <key> <separator> <value> => { addField($1, $3); }
        | <key> "{" <field>* "}" => { addNestedObject($1, $3); }
<key> ::= <simple-key> | <path-expression>
<path-expression> ::= <simple-key> ("." <simple-key>)* => { buildPath($1, $3); }
<simple-key> ::= <quoted-string> | <unquoted-string>
<separator> ::= ":" | "="
<value> ::= <object> | <array> | <substitution> | <primitive>
<array> ::= "[" <value>* "]" => { buildArray($2); }
<substitution> ::= "${" <path-expression> "}" => { buildSubstitution($2); }
                | "${?" <path-expression> "}" => { buildOptionalSubstitution($2); }
<include> ::= "include" ("file(" <quoted-string> ")" | <quoted-string>) => { addInclude($2); }
<primitive> ::= <number> | <boolean> | <null> | <quoted-string> | <triple-string> | <unquoted-string>
<boolean> ::= "true" | "false" | "on" | "off"
<null> ::= "null"
<quoted-string> ::= '"' <char>* '"'
<triple-string> ::= '"""' /[^"""]*/ '"""'
<unquoted-string> ::= /[^$"{}\[\]=:,+#`^?!@*&\\]+/
<char> ::= /[^"\\]|\\./

# --- Coverage completion: remaining language constructs ---
<array_concat> ::= <array> <array> ;
<plus_eq> ::= <path> "+=" <value> ;
<quoted_key> ::= <text> ":" <value> ;
<object_merge> ::= <object> ("&" | "|") <object> ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   HOCON config */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<comment> ::= /\x2F\x2F[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?)/
<identifier> ::= /[a-zA-Z_$][a-zA-Z0-9_$-]*/
<op> ::= /\.\.\.|\|\||\.\.|\x2F|->|=>|==|!=|<=|>=|&&|::|\.|\+|\*|\?|\(|\)|\[|\]|\{|\}|\||\^|\$|:|;|,|=|-|%|<|>|!|&|~|@/
