Grammar: INI
FormatType: EBNF

# INI grammar - core language subset
<file> ::= <line>* => { buildIni($1); }
<line> ::= <section-header> | <property> | <comment> | <empty>
<section-header> ::= "[" <section-name> "]" => { beginSection($2); }
<section-name> ::= /[a-zA-Z0-9_.\- ]+/
<property> ::= <key> <kv-sep> <value>? => { addProperty($1, $3); }
<kv-sep> ::= "=" | ":"
<key> ::= /[a-zA-Z_][a-zA-Z0-9_.\-]*/
<value> ::= /[^[\n]*/ => { trimValue($1); }
<comment> ::= (";" | "#") /[\S\s]*/ => { skip(); }
<empty> ::= /[ \t]*/

# --- Coverage completion: remaining language constructs ---
<sub_section> ::= <key> " " <text> ;
<trailing_comment> ::= ('#' | ';') [^\n]* ;
<list_value> ::= <value> ("," <value>)+ ;
<empty_line> ::= [ \t]* "\n" ;

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   INI file */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<comment> ::= /;[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\n]|\\.)*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\x2E[0-9_]+)?([eE][+-]?[0-9]+)?)/
<identifier> ::= /[a-zA-Z_$][a-zA-Z0-9_$-]*/
<op> ::= /\.\.\.|\|\||\.\.|\x2F|->|=>|==|!=|<=|>=|&&|::|\.|\+|\*|\?|\(|\)|\[|\]|\{|\}|\||\^|\$|:|;|,|=|-|%|<|>|!|&|~|@/
