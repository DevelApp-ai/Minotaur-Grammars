Grammar: INI
FormatType: EBNF
TokenSplitter: Space

# INI grammar - core language subset
<file> ::= <line>* => { buildIni($1); }
<line> ::= <section-header> | <property> | <comment> | <empty>
<section-header> ::= "[" <section-name> "]" => { beginSection($2); }
<section-name> ::= /[a-zA-Z0-9_.\- ]+/
<property> ::= <key> <kv-sep> <value>? => { addProperty($1, $3); }
<kv-sep> ::= "=" | ":"
<key> ::= /[a-zA-Z_][a-zA-Z0-9_.\-]*/
<value> ::= /[^[\n]*/ => { trimValue($1); }
<comment> ::= (";" | "#") /[\S\s]*/ => { skip(); }
<empty> ::= /[ \t]*/

# --- Coverage completion: remaining language constructs ---
<sub_section> ::= <key> " " <text> ;
<trailing_comment> ::= ('#' | ';') [^\n]* ;
<list_value> ::= <value> ("," <value>)+ ;
<empty_line> ::= [ \t]* "\n" ;
