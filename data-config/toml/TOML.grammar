Grammar: TOML
FormatType: EBNF

<toml-doc> ::= <expression>*
<expression> ::= <keyval> | <table> | <array-table> | <comment>
<keyval> ::= <key> "=" <value>
<key> ::= <bare-key> ("." <bare-key>)*
<table> ::= "[" <key> "]"
<array-table> ::= "[[" <key> "]]"
<value> ::= <string> | <number> | <bool> | <datetime> | <array> | <inline-table>
<bool> ::= "true" | "false"
<array> ::= "[" <value> ("," <value>)* ","? "]"
<inline-table> ::= "{" <keyval> ("," <keyval>)* "}"

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   TOML 1.0: ws, # comments, basic/literal/multiline strings, numbers (hex/oct/bin/underscore), datetimes, bare keys, punctuation. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /#[^\n]*/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'''([^']|'[^']|''[^'])*'''/
<string> ::= /'([^']|'')*'/
<number> ::= /[+-]?(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(\x2E[0-9_]*)?([eE][+-]?[0-9]+)?)/
<number> ::= /[+-]?(inf|nan)/
<datetime> ::= /[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}:[0-9]{2}(\x2E[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?)?|[0-9]{2}:[0-9]{2}:[0-9]{2}(\x2E[0-9]+)?/
<bare-key> ::= /[A-Za-z0-9_-]+/
<op> ::= /\[|\]|\{|\}|\.|=|,/
