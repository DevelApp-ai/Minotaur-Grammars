Grammar: Jsonnet
FormatType: EBNF
TokenSplitter: Space

# Jsonnet grammar - core language subset
<file> ::= <expr> => { buildJsonnet($1); }
<expr> ::= <null> | <true> | <false> | <self>
        | <number> | <string> | <obj> | <array>
        | <object-comprehension> | <array-comprehension>
        | <field-access> | <index-access> | <slice>
        | <function-call> | <local-expr> | <if-expr> | <binary-expr> | <unary-expr> | <import-expr> | <var>
<obj> ::= "{" <member>* "}" => { buildObject($2); }
<member> ::= <field-member> | <local-member> | <assert-member>
<field-member> ::= <field-name> ("+" <expr>)? ":" <expr> => { addField($1, $4); }
             | <field-name> "(" <params> ")" ":" <expr> => { addMethod($1, $3, $5); }
<field-name> ::= <identifier> | <string> | "[" <expr> "]" | <local-bind-name>
<local-member> ::= "local" <bind> ","? => { addLocal($2); }
<array> ::= "[" <expr>* "]" => { buildArray($2); }
<object-comprehension> ::= "{" "[" <expr> "]" <comp-spec> "}" => { buildObjComp($3, $4); }
<array-comprehension> ::= "[" <expr> <comp-spec> "]" => { buildArrComp($2, $3); }
<comp-spec> ::= <for-spec> <comp-spec>?
             | <if-spec> <comp-spec>?
<for-spec> ::= "for" <identifier> "in" <expr> => { addFor($2, $4); }
<if-spec> ::= "if" <expr> => { addIf($2); }
<field-access> ::= <expr> "." <identifier> => { buildFieldAccess($1, $3); }
<index-access> ::= <expr> "[" <expr> "]" => { buildIndex($1, $3); }
<slice> ::= <expr> "[" <expr>? ":" <expr>? "]" => { buildSlice($1, $3, $5); }
<function-call> ::= <expr> "(" <args> ")" => { buildCall($1, $3); }
<args> ::= (<expr> | <named-arg>)? ("," (<expr> | <named-arg>))*
<named-arg> ::= <identifier> "=" <expr>
<local-expr> ::= "local" <bind> ";" <expr> => { buildLocal($2, $4); }
<bind> ::= <local-bind-name> ("(" <params> ")")? "=" <expr> => { buildBind($1, $3, $6); }
<local-bind-name> ::= <identifier> | <dollar-var>
<if-expr> ::= "if" <expr> "then" <expr> ("else" <expr>)? => { buildIf($2, $4, $6); }
<binary-expr> ::= <expr> <binop> <expr> => { buildBinary($2, $1, $3); }
<unary-expr> ::= <unop> <expr> => { buildUnary($1, $2); }
<import-expr> ::= ("import" | "importstr") <string> => { buildImport($1, $2); }
              | "importbin" <string>
<binop> ::= "+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | "<=" | ">" | ">=" | "&&" | "||" | "&" | "|" | "^" | "<<" | ">>" | "in"
<unop> ::= "-" | "+" | "!" | "~"
<params> ::= <param>? ("," <param>)*
<param> ::= <identifier> ("=" <expr>)?
<self> ::= "self" | "$" => { buildSelf(); }
<null> ::= "null"
<true> ::= "true"
<false> ::= "false"
<var> ::= <identifier> => { buildVar($1); }
<dollar-var> ::= "$"
<number> ::= /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
<string> ::= '"' <str-char>* '"' | "'" <str-char>* "'" | /\|\|\|[\s\S]*?\|\|\|/
<str-char> ::= /[^"'\\]/ | "\\" /./ | "\\(" <identifier> ")" | "%(" <identifier> ")"
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
