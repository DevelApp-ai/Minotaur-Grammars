Grammar: Avro
FormatType: EBNF
TokenSplitter: Space

# Avro grammar - core language subset
<file> ::= <schema> => { buildAvroSchema($1); }
<schema> ::= <record-schema> | <named-type-decl> | <primitive> | <complex-type>
<record-schema> ::= "{" "\"type\"" ":" "\"record\"" "," "\"name\"" ":" <json-string> ("," "\"namespace\"" ":" <json-string>)? "," "\"fields\"" ":" "[" <field-decl>* "]" <extra-prop>* "}" => { declareRecord($6, $9, $12); }
<field-decl> ::= "{" "\"name\"" ":" <json-string> "," "\"type\"" ":" <field-type> ("," "\"default\"" ":" <json-value>)? <extra-prop>* "}" => { declareField($3, $6, $9); }
<field-type> ::= <primitive-token> | <complex-type> | <type-array>
<type-array> ::= "[" (<primitive-token> | <complex-type> | <json-string>)+ "]"
<complex-type> ::= <enum-schema> | <array-schema> | <map-schema> | <fixed-schema>
<enum-schema> ::= "{" "\"type\"" ":" "\"enum\"" "," "\"name\"" ":" <json-string> "," "\"symbols\"" ":" <json-array> <extra-prop>* "}" => { declareEnum($6, $9); }
<array-schema> ::= "{" "\"type\"" ":" "\"array\"" "," "\"items\"" ":" <field-type> "}" => { declareArray($6); }
<map-schema> ::= "{" "\"type\"" ":" "\"map\"" "," "\"values\"" ":" <field-type> "}" => { declareMap($6); }
<fixed-schema> ::= "{" "\"type\"" ":" "\"fixed\"" "," "\"name\"" ":" <json-string> "," "\"size\"" ":" <json-number> "}" => { declareFixed($6, $9); }
<named-type-decl> ::= <primitive>
<primitive> ::= <primitive-token> | <json-string>
<primitive-token> ::= "\"null\"" | "\"boolean\"" | "\"int\"" | "\"long\"" | "\"float\"" | "\"double\"" | "\"bytes\"" | "\"string\""
<extra-prop> ::= <json-string> ":" <json-value>
<json-string> ::= /"[^"\\]*"/
<json-number> ::= /[0-9]+/
<json-array> ::= "[" <json-string>* "]"
<json-value> ::= /[^[\]{}]+/ | <json-array> | /\{[^{}]*\}/

# --- Extended coverage: additional language constructs ---
<fixed_decl> ::= "fixed" <identifier> "(" <number> ")" ;
<logical_type> ::= "logicalType" ":" ("date" | "timestamp-millis" | "timestamp-micros" | "time-millis" | "decimal" | "uuid" | "duration") ;
<aliases_field> ::= "aliases" ":" [ <text> ("," <text>)* ] ;
<default_field> ::= "default" ":" <json_value> ;
<doc_field> ::= "doc" ":" <text> ;
<union_type> ::= [ <type> ("," <type>)+ ] ;
<array_type> ::= "array" "{" "items" ":" <type> "}" ;
<map_type> ::= "map" "{" "values" ":" <type> "}" ;
