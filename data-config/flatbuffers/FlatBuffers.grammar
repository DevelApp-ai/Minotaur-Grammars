Grammar: FlatBuffers
FormatType: EBNF
TokenSplitter: Space

# FlatBuffers grammar - core language subset
<file> ::= <declaration>* => { buildSchema($1); }
<declaration> ::= <namespace-decl> | <include-decl> | <attribute-decl> | <type-decl> | <rpc-decl>
<namespace-decl> ::= "namespace" <qualified-id> ";" => { setNamespace($2); }
<include-decl> ::= "include" <string> ";" => { addInclude($2); }
<attribute-decl> ::= "attribute" <string-or-id> ";" => { addAttributeDecl($2); }
<type-decl> ::= <table-decl> | <struct-decl> | <enum-decl> | <union-decl>
<table-decl> ::= "table" <identifier> "{" <field-decl>* "}" => { declareTable($2, $4); }
<struct-decl> ::= "struct" <identifier> "{" <field-decl>* "}" => { declareStruct($2, $4); }
<field-decl> ::= <identifier> ":" <type-ref> ("=" <scalar-literal>)? <metadata>? ";" => { declareField($1, $3, $5, $6); }
<enum-decl> ::= "enum" <identifier> ":" <base-type> "{" <enum-entry>* "}" => { declareEnum($2, $4, $6); }
<enum-entry> ::= <identifier> ("=" <integer> | "=" <compound-literal>)? ","? => { addEnumValue($1, $3); }
<compound-literal> ::= "(" <identifier> ("," <identifier>)* ")"
<union-decl> ::= "union" <identifier> "{" <union-entry>* "}" => { declareUnion($2, $4); }
<union-entry> ::= <identifier> (":" <type-ref>)? ","? => { addUnionMember($1, $3); }
<rpc-decl> ::= "rpc_service" <identifier> "{" <rpc-method>* "}" => { declareService($2, $4); }
<rpc-method> ::= <identifier> "(" <type-ref> ")" ":" <type-ref> <metadata>? ";" => { addRpcMethod($1, $3, $6); }
<metadata> ::= "(" <metadata-entry> ")"
<metadata-entry> ::= <identifier> (":" <value>)? => { addMetadata($1, $3); }
<type-ref> ::= <base-type> | <qualified-id>
<base-type> ::= "bool" | "byte" | "ubyte" | "short" | "ushort" | "int" | "uint" | "long" | "ulong" | "float" | "double" | "string" | "[ubyte]"
<scalar-literal> ::= <number> | "true" | "false"
<qualified-id> ::= <identifier> ("." <identifier>)*
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<number> ::= /[+-]?[0-9]+(\.[0-9]+)?/
<integer> ::= /[+-]?[0-9]+/
<string> ::= '"' /[^"]*/ '"'
<string-or-id> ::= <string> | <identifier>
