Grammar: YAML
FormatType: EBNF
TokenSplitter: Space

# YAML grammar - core language subset (YAML 1.1/1.2 block + flow styles)
<yaml_stream> ::= <document> (<document-sep> <document>)* => { buildStream($$); }
<document> ::= <node>? => { beginDocument(); }
<document-sep> ::= <doc-marker> <comment>? ;
<doc-marker> ::= "---" | "..." ;
<node> ::= <block-node> | <flow-node> ;
<block-node> ::= <block-mapping> | <block-sequence> | <scalar> ;
<block-mapping> ::= <mapping-entry>+ => { beginMapping(); }
<mapping-entry> ::= <key> ":" <entry-value> => { addEntry($1, $3); }
<entry-value> ::= <block-node> | <flow-node> | <empty> ;
<key> ::= <scalar> | <flow-node> | <anchor-def> ;
<block-sequence> ::= <sequence-entry>+ => { beginSequence(); }
<sequence-entry> ::= "-" <node> => { addItem($2); }
<scalar> ::= <plain> | <single-quoted> | <double-quoted> | <block-scalar> => { scalarValue($1); }
<plain> ::= /[a-zA-Z0-9_][^:\n#]*/ => { trimValue($1); }
<single-quoted> ::= "'" /[^']*/ "''"? "'" ;
<double-quoted> ::= '"' /[^"\n]*/ '"' ;
<block-scalar> ::= ("|" | ">") <header>? <scalar-body> ;
<header> ::= /[0-9]+/ ("-" | "+")? ;
<scalar-body> ::= /[ \t\S\s]*/ ;
<flow-node> ::= <flow-sequence> | <flow-mapping> ;
<flow-sequence> ::= "[" (<node> ("," <node>)*)? "]" ;
<flow-mapping> ::= "{" (<flow-entry> ("," <flow-entry>)*)? "}" ;
<flow-entry> ::= <flow-key> ":" <node>? ;
<flow-key> ::= <scalar> | <flow-node> ;
<anchor-def> ::= "&" /[a-zA-Z0-9_-]+/ => { defineAnchor($2); }
<alias> ::= "*" /[a-zA-Z0-9_-]+/ => { resolveAlias($2); }
<tag> ::= "!!" /[a-zA-Z0-9]+/ => { applyTag($2); }
<comment> ::= "#" /[\S\s]*/ => { skip(); }
<empty> ::= /[ \t]*/ ;

# --- Coverage completion: remaining language constructs ---
<merge-key> ::= "<<" ":" <alias> ;
<explicit-key> ::= "?" <node> ":" <node> ;
<complex-mapping-entry> ::= <explicit-key> <mapping-entry> ;
<directive> ::= "%" /[a-zA-Z]+/ <text>? ;
<yaml-directive> ::= "%YAML" /[0-9.]+/ ;
<tag-directive> ::= "%TAG" <text> ;
<reserved-directive> ::= "%" /[a-zA-Z0-9]+/ <text> ;
<document-start-explicit> ::= <directives>? "---" <node> ;
<document-end-explicit> ::= <node> "..." ;
<set-syntax> ::= "?" <set-key> ":" <empty> ;
<set-key> ::= <scalar> | <flow-node> ;
<null-value> ::= "null" | "~" | <empty> ;
<boolean> ::= "true" | "false" | "True" | "False" ;
<number> ::= /[+-]?[0-9]+/ | /[+-]?[0-9]*\.[0-9]+/ ;
<timestamp> ::= /[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ][0-9:.]+)?/ ;
<escape> ::= "\\" /["\\\/bfnrt0NLP_]/ | "\\x" /[0-9a-fA-F]{2}/ ;
<indentation> ::= /[ ]*/ => { trackIndent($1); }
