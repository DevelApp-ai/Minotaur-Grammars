Grammar: Protobuf
FormatType: EBNF
TokenSplitter: Space

# Protobuf grammar - core language subset
<file> ::= <syntax-decl> <top-level-decl>* => { buildProto($1, $2); }
<syntax-decl> ::= "syntax" "=" "'proto3'" ";" | "syntax" "=" '"proto3"' ";"
<top-level-decl> ::= <package-decl> | <import-decl> | <option-decl> | <message-decl> | <enum-decl> | <service-decl>
<package-decl> ::= "package" <qualified-id> ";" => { setPackage($2); }
<import-decl> ::= ("import" | "import" "public" | "import" "weak") <string> ";" => { addImport($2, $3); }
<option-decl> ::= "option" <option-name> "=" <constant> ";" => { addOption($2, $4); }
<message-decl> ::= "message" <identifier> "{" <message-element>* "}" => { declareMessage($2, $4); }
<message-element> ::= <field> | <oneof> | <map-field> | <enum-decl> | <message-decl> | <option-decl> | <reserved>
<field> ::= <label>? <type> <identifier> "=" <field-number> <field-options>? ";" => { declareField($1, $2, $3, $5, $6); }
<label> ::= "repeated" | "optional"
<map-field> ::= "map" "<" <type> "," <type> ">" <identifier> "=" <field-number> ";" => { declareMapField($3, $5, $7, $9); }
<oneof> ::= "oneof" <identifier> "{" <field>* "}" => { declareOneof($2, $4); }
<enum-decl> ::= "enum" <identifier> "{" <enum-element>* "}" => { declareEnum($2, $4); }
<enum-element> ::= <enum-value> | <option-decl> | <reserved>
<enum-value> ::= <identifier> "=" "-"? <field-number> <field-options>? ";" => { addEnumValue($1, $4); }
<reserved> ::= "reserved" (<number-range-list> | <field-name-list>) ";"
<number-range-list> ::= <field-number> ("to" (<field-number> | "max"))? ("," <number-range-list>)?
<field-name-list> ::= <string> ("," <field-name-list>)*
<service-decl> ::= "service" <identifier> "{" <rpc-decl>* "}" => { declareService($2, $4); }
<rpc-decl> ::= "rpc" <identifier> "(" ("stream" <type> | <type>) ")" "returns" "(" ("stream" <type> | <type>) ")" (<options-block> | ";") => { declareRpc($2, $3, $8); }
<options-block> ::= "{" <option-decl>* "}"
<field-options> ::= "[" <option-assignment> "]"
<option-assignment> ::= <option-name> "=" <constant> => { addFieldOption($1, $3); }
<option-name> ::= <qualified-id> ("." "(" <qualified-id> ")")?
<constant> ::= <string> | <number> | <bool-literal> | <qualified-id>
<type> ::= <builtin-type> | <qualified-id>
<builtin-type> ::= "double" | "float" | "int32" | "int64" | "uint32" | "uint64" | "sint32" | "sint64" | "fixed32" | "fixed64" | "sfixed32" | "sfixed64" | "bool" | "string" | "bytes"
<field-number> ::= /[0-9]+/
<bool-literal> ::= "true" | "false"
<qualified-id> ::= <identifier> ("." <identifier>)*
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<number> ::= /[+-]?[0-9]+(\.[0-9]+)?/
<string> ::= /"[^"\n]*"/ | /'[^'\n]*'/
