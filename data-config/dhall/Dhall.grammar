Grammar: Dhall
FormatType: EBNF
TokenSplitter: Space

# Dhall grammar - core language subset
<file> ::= <expr> => { buildDhall($1); }
<expr> ::= <lambda> | <let-in> | <if> | <merge> | <annotated> | <primitive> | <record> | <union> | <list> | <import> | <identifier>
<lambda> ::= "\\" "(" <label> ":" <expr> ")" "->" <expr> => { buildLambda($3, $5, $7); }
<let-in> ::= "let" <label> (":" <expr>)? "=" <expr> "in" <expr> => { buildLet($2, $4, $6, $8); }
<if> ::= "if" <expr> "then" <expr> "else" <expr> => { buildIf($2, $4, $6); }
<merge> ::= "merge" <expr> <expr> (":" <expr>)? => { buildMerge($2, $3, $5); }
<annotated> ::= <expr> ":" <expr> => { buildAnnotation($1, $3); }
<primitive> ::= "True" | "False" | <natural> | <integer> | <double> | <text-literal>
<text-literal> ::= '"' <text-char>* '"'
<record> ::= "{" <record-entry>* "}" => { buildRecord($2); }
<record-entry> ::= <label> (":" <expr>)? ":" <expr> => { buildField($1, $3, $5); }
<union> ::= "<" <union-entry>* ">" => { buildUnion($2); }
<union-entry> ::= <label> (":" <expr>)? => { buildUnionAlt($1, $3); }
<list> ::= "[" <expr>* "]" => { buildList($2); }
<import> ::= "env:" <label> | <file-path> | "https://" <path-chars>
<label> ::= /[a-zA-Z_][a-zA-Z0-9_-]*/
<natural> ::= /[0-9]+/
<integer> ::= /[+-]?[0-9]+/
<double> ::= /[+-]?[0-9]+\.[0-9]+/
<identifier> ::= <label> ("." <label>)*
<text-char> ::= /[^"\\]/ | "\\" /./
<path-chars> ::= /[^ \t\n]+/
<file-path> ::= /[.\/][a-zA-Z0-9_.\/-]*/
