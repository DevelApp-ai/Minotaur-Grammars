Grammar: PCRE2
FormatType: EBNF

<pattern> ::= <branch> ("|" <branch>)*
<branch> ::= <piece>*
<piece> ::= <atom> <quantifier>?
<atom> ::= <literal> | <class> | <group> | <anchor> | <escape> | <op>
<literal> ::= <identifier> | <number>
<class> ::= "[" "^"? <class-item>+ "]"
<class-item> ::= <identifier> | <number> | "-" <identifier> | <escape>
<group> ::= "(" ("?:" | "?=" | "?!")? <pattern> ")"
<anchor> ::= "^" | "$" | <escape>
<escape> ::= <op> (<identifier> | <number> | <op>)?
<quantifier> ::= ("*" | "+" | "?") "?"? | "{" <number> ("," <number>?)? "}" "?"?

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   PCRE2 regex pattern: ws significant, # comments only in (?x) mode (lexed as op), classes [...], groups, escapes, anchors as ops. */
<ws> ::= /[ \t\r\n]+/ => { skip }
<string> ::= /"""([^"]|"[^"]|""[^"])*"""/
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<char> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[0-9]+/
<identifier> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\x2F|\^|\$|\.|\*|\+|\?|\(|\)|\[|\]|\{|\}|\||\\|-|,|:|=|!|<|>|#|@|"|'/
