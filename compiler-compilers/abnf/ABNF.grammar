Grammar: ABNF
FormatType: EBNF

/*
 * Augmented Backus-Naur Form (ABNF) Grammar
 * Based on RFC 5234 - Augmented BNF for Syntax Specifications: ABNF
 * https://tools.ietf.org/html/rfc5234
 */

<abnf-document> ::= <rule>+

<rule> ::= <rulename> <defined-as> <elements> <c-nl>

<rulename> ::= <ALPHA> (<ALPHA> | <DIGIT> | "-")*

<defined-as> ::= "=" | "=/"

<elements> ::= <alternation>

<alternation> ::= <concatenation> ("|" <concatenation>)*

<concatenation> ::= <repetition>+

<repetition> ::= <repeat>? <element>

<repeat> ::= <DIGIT>+ | (<DIGIT>* "*" <DIGIT>*)

<element> ::= <rulename> | <group> | <option> | <char-val> | <num-val> | <prose-val>

<group> ::= "(" <alternation> ")"

<option> ::= "[" <alternation> "]"

<char-val> ::= "\"" <char>* "\""

<num-val> ::= "%" (<bin-val> | <dec-val> | <hex-val>)

<bin-val> ::= "b" (<BIT>+ | <BIT>+ ("." <BIT>+)+ | <BIT>+ "-" <BIT>+)

<dec-val> ::= "d" (<DIGIT>+ | <DIGIT>+ ("." <DIGIT>+)+ | <DIGIT>+ "-" <DIGIT>+)

<hex-val> ::= "x" (<HEXDIG>+ | <HEXDIG>+ ("." <HEXDIG>+)+ | <HEXDIG>+ "-" <HEXDIG>+)

<prose-val> ::= "<" <prose-text> ">"

<prose-text> ::= /[^>]*/

<c-nl> ::= <comment> | <CRLF>

<comment> ::= ";" <WSP>* <VCHAR>* <CRLF>

<c-wsp> ::= <WSP> | (<c-nl> <WSP>)

<ALPHA> ::= /[A-Za-z]/

<DIGIT> ::= /[0-9]/

<HEXDIG> ::= /[A-Fa-f]/ ;
<HEXDIG> ::= <DIGIT> ;

<BIT> ::= "0" | "1"

<VCHAR> ::= /[\x21-\x7E]/

<WSP> ::= /[ \t]/

<CRLF> ::= /\r?\n/

<char> ::= /[\x01-\x7F]/

/* Lexer core for engine-verified lexing (ENFAStepLexer-StepParser #129/#133):
   single-terminal token rules only (regex alternatives inside productions do
   not materialize into lexer rules in the engine). String/char/block-comment
   patterns are the proven CSharp10 ones; '/' is written \x2F inside regexes.
   ABNF (RFC 5234) */
<ws> ::= /[ \t\r\n]+/ => { skip }
<comment> ::= /;[^\n]*/ => { skip }
<string> ::= /"([^"\\\n]|\\.)*"/
<string> ::= /'([^'\\\n]|\\.)*'/
<number> ::= /[+-]?[0-9]+(\x2E[0-9]+)?([eE][+-]?[0-9]+)?/
<word> ::= /[a-zA-Z_][a-zA-Z0-9_]*/
<op> ::= /\.\.\.|\|\||\.\.|\x2F|\\\\|::=|:=|->|=>|==|!=|<=|>=|&&|\||\(|\)|\[|\]|\{|\}|\.|\+|\*|\?|\^|\$|%%|%|=|<|>|;|:|,|-|!|@|&|~|"|'/
