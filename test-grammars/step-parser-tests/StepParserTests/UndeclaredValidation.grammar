Grammar: UndeclaredValidation
TokenSplitter: Space

<IDENTIFIER> ::= /[a-zA-Z][a-zA-Z0-9]*/
<ASSIGN> ::= '='
<NUMBER> ::= /[0-9]+/
<SEMICOLON> ::= ';'
<WS> ::= /[ \t\r\n]+/

<statement> ::= <declaration> | <usage>
<declaration> ::= <IDENTIFIER> <ASSIGN> <NUMBER> <SEMICOLON> => { declareVariable($1); }
<usage> ::= <IDENTIFIER> <SEMICOLON> => { validateVariableExists($1); }
